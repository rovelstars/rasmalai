import { Build, Key, Node, Role, Tree } from "@std/ui"

class Appearance {
    let scheme: String = "system"
    let reduceMotion: Bool = false
    let query: String = ""
    let confirm: Bool = false
    let resets: Int = 0
}

fn screen(b: Build, s: Appearance): Node {
    return b.column() {
        b.textField(s.query, "Search settings", (v: String) => { s.query = v })
        b.heading("Appearance")
        b.text("Choose how runixOS looks and moves.")

        b.section("Theme") {
            b.row() {
                b.button("System", () => { s.scheme = "system" })
                b.button("Light", () => { s.scheme = "light" })
                b.button("Dark", () => { s.scheme = "dark" })
            }
        }

        b.section("Text size") {
            b.slider("Text size")
        }

        b.checkbox("Reduce motion", s.reduceMotion, () => {
            s.reduceMotion = !s.reduceMotion
        })

        b.dialog("Reset appearance?") {
            b.text("This restores the default theme and text size.")
            b.row() {
                b.button("Cancel", () => {
                    s.confirm = false
                    b.handle().clearFocusScope()
                })
                b.button("Confirm", () => {
                    s.scheme = "system"
                    s.resets += 1
                    s.confirm = false
                    b.handle().clearFocusScope()
                })
            }
        }
        b.button("Reset", () => {
            s.confirm = true
            let d = b.handle().find(Role.dialog, "Reset appearance?")
            b.handle().focusScope(Node(tree: b.handle(), id: d))
        })
    }
}

fn Main(): Int {
    let t = new Tree()
    let b = new Build(t)
    let s = new Appearance()

    let root = screen(b, s)
    t.layout(root, 640)
    print("size:", t.w[root.id], t.h[root.id])
    print(t.snapshot())

    let first = t.focusNext()
    print("focus:", first)
    if first != -1 {
        print("enter fired:", t.keyDown(Node(tree: t, id: first), Key.enter))
    }

    let search = t.find(Role.textbox, "Search settings")
    t.setText(Node(tree: t, id: search), "theme")
    print("query:", s.query)

    let l = t.find(Role.button, "Light")
    let lx = t.x[l] + 2
    let ly = t.y[l] + 2
    print("pointer light:", t.pointerDown(lx, ly))
    print("scheme after pointer:", s.scheme)

    let reset = t.find(Role.button, "Reset")
    t.tap(Node(tree: t, id: reset))
    print("confirm open:", s.confirm, "focus:", t.focusNext())
    let cancel = t.find(Role.button, "Cancel")
    t.tap(Node(tree: t, id: cancel))
    print("confirm after cancel:", s.confirm)
    return 0
}
