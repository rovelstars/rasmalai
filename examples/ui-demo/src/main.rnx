import { Build, Key, Node, Role, Tree } from "@std/ui"

class Appearance {
    let scheme: String = "system"
    let reduceMotion: Bool = false
    let query: String = ""
    let resets: Int = 0
}

fn screen(b: Build, s: Appearance): Node {
    let col = b.column()
    col.addChild(b.textField(s.query, "Search settings", (v: String) => { s.query = v }))
    col.addChild(b.heading("Appearance"))
    col.addChild(b.text("Choose how runixOS looks and moves."))

    let theme = b.section("Theme")
    let row = b.row()
    row.addChild(b.button("System", () => { s.scheme = "system" }))
    row.addChild(b.button("Light", () => { s.scheme = "light" }))
    row.addChild(b.button("Dark", () => { s.scheme = "dark" }))
    theme.addChild(row)
    col.addChild(theme)

    let size = b.section("Text size")
    size.addChild(b.slider("Text size"))
    col.addChild(size)

    col.addChild(b.checkbox("Reduce motion", s.reduceMotion, () => { s.reduceMotion = !s.reduceMotion }))
    col.addChild(b.button("Reset", () => {
        s.scheme = "system"
        s.resets += 1
    }))
    return col
}

fn Main(): Int {
    let t = new Tree()
    let b = new Build(t)
    let s = new Appearance()

    let root = screen(b, s)
    t.layout(root, 640)
    print("size:", t.w[root.id], t.h[root.id])
    print(t.snapshot())

    let first = t.focusNext()
    print("focus:", first)
    if first != -1 {
        print("enter fired:", t.keyDown(Node(tree: t, id: first), Key.enter))
    }

    let search = t.find(Role.textbox, "Search settings")
    t.setText(Node(tree: t, id: search), "theme")
    print("query:", s.query)
    let reset = t.find(Role.button, "Reset")
    let l = t.find(Role.button, "Light")
    let d = t.find(Role.button, "Dark")
    let lx = t.x[l] + 2
    let ly = t.y[l] + 2
    print("pointer light:", t.pointerDown(lx, ly))
    print("scheme after pointer:", s.scheme)
    t.tap(Node(tree: t, id: l))
    print("scheme after Light:", s.scheme)
    t.tap(Node(tree: t, id: d))
    print("scheme after Dark:", s.scheme)
    t.tap(Node(tree: t, id: reset))
    print("resets:", s.resets, "scheme:", s.scheme)
    print("hit at 20,60:", t.hitTest(20, 60))
    return 0
}
