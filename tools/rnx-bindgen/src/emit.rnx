import { File, OpenMode, Path } from "@std/fs";
import { Process } from "@std/process";
import { FnDecl, Param, StructDecl, ConstDecl } from "./extract";

export fn sortStructs(items: Array<StructDecl>): Array<StructDecl> {
    let out: Array<StructDecl> = [];
    let i = 0;
    while i < items.length() {
        out.push(items[i]);
        i = i + 1;
    }
    let j = 1;
    while j < out.length() {
        let key = out[j];
        let k = j;
        while k > 0 && key.name < out[k - 1].name {
            out[k] = out[k - 1];
            k = k - 1;
        }
        out[k] = key;
        j = j + 1;
    }
    return out;
}

export fn sortConsts(items: Array<ConstDecl>): Array<ConstDecl> {
    let out: Array<ConstDecl> = [];
    let i = 0;
    while i < items.length() {
        out.push(items[i]);
        i = i + 1;
    }
    let j = 1;
    while j < out.length() {
        let key = out[j];
        let k = j;
        while k > 0 && key.name < out[k - 1].name {
            out[k] = out[k - 1];
            k = k - 1;
        }
        out[k] = key;
        j = j + 1;
    }
    return out;
}

export fn renderTypes(headerBase: String, structs: Array<StructDecl>, consts: Array<ConstDecl>): String {
    let s = "// @generated by rnx-bindgen from " + headerBase + " - DO NOT EDIT\n";
    s = s + "\n";
    let i = 0;
    while i < structs.length() {
        s = s + "export struct " + structs[i].name + " \{\n";
        let j = 0;
        while j < structs[i].fields.length() {
            s = s + "    let " + structs[i].fields[j].name + ": " + structs[i].fields[j].ctype + ";\n";
            j = j + 1;
        }
        s = s + "}\n";
        if i + 1 < structs.length() || consts.length() > 0 { s = s + "\n"; }
        i = i + 1;
    }
    let k = 0;
    while k < consts.length() {
        s = s + "export const " + consts[k].name + " = " + "${consts[k].value}" + "\n";
        k = k + 1;
    }
    return s;
}

export fn renderTypeNames(structs: Array<StructDecl>, consts: Array<ConstDecl>): Array<String> {
    let names: Array<String> = [];
    let i = 0;
    while i < structs.length() {
        names.push(structs[i].name);
        i = i + 1;
    }
    let k = 0;
    while k < consts.length() {
        names.push(consts[k].name);
        k = k + 1;
    }
    return names;
}

export fn sortNames(names: Array<String>): Array<String> {
    let out: Array<String> = [];
    let i = 0;
    while i < names.length() {
        out.push(names[i]);
        i = i + 1;
    }
    let j = 1;
    while j < out.length() {
        let key = out[j];
        let k = j;
        while k > 0 && key < out[k - 1] {
            out[k] = out[k - 1];
            k = k - 1;
        }
        out[k] = key;
        j = j + 1;
    }
    return out;
}

export fn sortFns(fns: Array<FnDecl>): Array<FnDecl> {
    let out: Array<FnDecl> = [];
    let i = 0;
    while i < fns.length() {
        out.push(fns[i]);
        i = i + 1;
    }
    let j = 1;
    while j < out.length() {
        let key = out[j];
        let k = j;
        while k > 0 && key.name < out[k - 1].name {
            out[k] = out[k - 1];
            k = k - 1;
        }
        out[k] = key;
        j = j + 1;
    }
    return out;
}

fn renderParams(params: Array<Param>): String {
    if params.length() == 0 { return ""; }
    let s = "";
    let i = 0;
    while i < params.length() {
        if i > 0 { s = s + ",\n"; }
        s = s + "        " + params[i].name + ": " + params[i].ctype;
        i = i + 1;
    }
    return "\n" + s + "\n";
}

export fn renderLib(headerBase: String, nativeLib: String, fns: Array<FnDecl>, typeNames: Array<String>): String {
    let s = "// @generated by rnx-bindgen from " + headerBase + " - DO NOT EDIT\n";
    s = s + "\n";
    if typeNames.length() > 0 {
        s = s + "export \{\n";
        let t = 0;
        while t < typeNames.length() {
            if t > 0 { s = s + ",\n"; }
            s = s + "    " + typeNames[t];
            t = t + 1;
        }
        s = s + "\n} from \"./types\"\n";
        s = s + "\n";
    }
    s = s + "export \{\n";
    let i = 0;
    while i < fns.length() {
        if i > 0 { s = s + ",\n"; }
        s = s + "    fn " + fns[i].name + "(";
        if fns[i].params.length() > 0 {
            s = s + renderParams(fns[i].params) + "    ";
        }
        s = s + "): " + fns[i].ret;
        i = i + 1;
    }
    s = s + "\n} from native \"" + nativeLib + "\"\n";
    return s;
}

export fn renderConfig(pkgName: String, pkgVersion: String, nativeLib: String): String {
    let s = "// @generated by rnx-bindgen - DO NOT EDIT\n";
    s = s + "export default \{\n";
    s = s + "    project: \{\n";
    s = s + "        name: \"" + pkgName + "\",\n";
    s = s + "        version: \"" + pkgVersion + "\",\n";
    s = s + "    },\n";
    s = s + "    entries: \{\n";
    s = s + "        main: \"src/lib.rnx\"\n";
    s = s + "    },\n";
    s = s + "    dependencies: \{\n";
    s = s + "        " + nativeLib + ": \{\n";
    s = s + "            native: \"" + nativeLib + "\",\n";
    s = s + "            system: true\n";
    s = s + "        }\n";
    s = s + "    },\n";
    s = s + "    permissions: [\n";
    s = s + "        \"unsafe:ffi\"\n";
    s = s + "    ]\n";
    s = s + "}\n";
    return s;
}

export fn ensureDir(dir: String): Bool {
    if Path.exists(dir) { return true; }
    let out = Process.run("mkdir", ["-p", dir]);
    return out.exitCode == 0;
}

export fn writeFile(path: String, text: String): Bool {
    let f = File.open(path, OpenMode.Write);
    if !f.isOpen { return false; }
    let ok = f.writeText(text).isOk();
    f.close();
    return ok;
}

export fn emitPackage(outDir: String, pkgName: String, pkgVersion: String, nativeLib: String, headerBase: String, fns: Array<FnDecl>, structs: Array<StructDecl>, consts: Array<ConstDecl>): Bool {
    let srcDir = Path.join(outDir, "src");
    if !ensureDir(srcDir) {
        print("rnx-bindgen: cannot create " + srcDir);
        return false;
    }
    let ordered = sortFns(fns);
    let ostructs = sortStructs(structs);
    let oconsts = sortConsts(consts);
    print("---BEGIN Project.config---");
    print(renderConfig(pkgName, pkgVersion, nativeLib));
    print("---END Project.config---");
    if ostructs.length() > 0 || oconsts.length() > 0 {
        if !writeFile(Path.join(srcDir, "types.rnx"), renderTypes(headerBase, ostructs, oconsts)) {
            print("rnx-bindgen: cannot write src/types.rnx");
            return false;
        }
    }
    let typeNames = sortNames(renderTypeNames(ostructs, oconsts));
    if !writeFile(Path.join(srcDir, "lib.rnx"), renderLib(headerBase, nativeLib, ordered, typeNames)) {
        print("rnx-bindgen: cannot write src/lib.rnx");
        return false;
    }
    print("rnx-bindgen: wrote " + "${ordered.length()}" + " functions, " + "${ostructs.length()}" + " structs, " + "${oconsts.length()}" + " consts to " + outDir);
    return true;
}
