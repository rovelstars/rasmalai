{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "tsx --test \"tests/*.test.ts\"",
		"build:wasm": "wasm-pack build ../compiler/wasm_playground --target web --out-dir ../../website/src/lib/wasm",
		"build:docs": "node scripts/build-docs.mjs",
		"check:content": "node scripts/check-content.mjs",
		"db:seed": "tsx scripts/seed-turso.ts",
		"prebuild": "node scripts/build-docs.mjs || true; node scripts/build-cli-demos.mjs || true; node scripts/build-search-index.mjs; node scripts/build-og.mjs || true; node scripts/version-data.mjs",
		"postbuild": "node scripts/inline-critical.mjs"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"autoprefixer": "^10.6.1",
		"critters": "^0.0.23",
		"playwright-core": "^1.63.0",
		"postcss": "^8.5.28",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@libsql/client": "^0.18.0",
		"hash-wasm": "^4.12.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.13"
	}
}
