# Build artifacts
target/
**/target/
.rnx-cache/
**/.rnx-cache/
*.coredump
core*
# Stray `rnx build` output at the repository root
/main
# Local example apps live outside the repository
/examples/
# ...but not the linker's own `core/` + `target/` module trees (source, not artifacts)
!compiler/linker/src/core/
!compiler/linker/src/target/
# ...nor the corelang test suite (source, not a coredump)
!compiler/cli/tests/corelang.rs
*.profraw
compiler/runtime/bundle/Cargo.lock
compiler/runtime/uefi/Cargo.lock
benches/data/benchmarks.json
website/src/lib/benchmarks/pareto.json
website/static/data/

# Editor build outputs. Zed clones the grammar into grammars/ during a dev
# install; the grammar itself lives in renhiyama/rasmalai-ext.
editors/zed/extension.wasm
editors/zed/grammars/

# Tree-sitter generated outputs (regenerated in CI from grammar.js, see
# .github/workflows/tree-sitter.yml). The generated parser ships in the
# renhiyama/rasmalai-ext distribution repo, never in this one.
editors/tree-sitter-rasmalai/src/parser.c
editors/tree-sitter-rasmalai/src/grammar.json
editors/tree-sitter-rasmalai/src/node-types.json

# Web & WASM
node_modules/
**/node_modules/
# The site builds with npm; a stray Bun lockfile is not a source of truth.
website/bun.lock
.svelte-kit/
build/
**/*.wasm

# Cloudflare CLI local state (auth profiles, account cache)
.cloudflare/
dist/
website/src/lib/wasm/wasm_playground.js
website/src/lib/wasm/wasm_playground.d.ts
website/src/lib/wasm/wasm_playground_bg.wasm
website/src/lib/wasm/wasm_playground_bg.wasm.d.ts

# IDEs & System
.idea/
.vscode/
*.swp
.DS_Store

# Doc-example side effects (api_examples snippets write demo files)
/compiler/wasm_playground/doc-demo-*
benches/harness/__pycache__/
