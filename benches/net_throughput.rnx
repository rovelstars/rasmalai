//! Async socket ping-pong: one server thread echoes fixed 64-byte binary
//! payloads, the client measures round trips through the mio reactor.
//! Prints RESULT lines with ping count, milliseconds, and a checksum;
//! scale via RNX_BENCH_SCALE=tiny|small (ping count).
import { Env } from "@std/env";
import { Clock } from "@std/time";
import { TcpStream, TcpListener } from "@std/net";

fn payloadByte(i: Int): Int {
    return (i * 37 + 11) % 256;
}

fn readExact(sh: TcpStream, want: Int): Array<Int> {
    let out: Array<Int> = [];
    while out.length() < want {
        let chunk: Array<Int> = sh.read(want - out.length()).wait().unwrapOr([]);
        if chunk.length() == 0 {
            break;
        }
        let k = 0;
        while k < chunk.length() {
            out.push(chunk[k]);
            k = k + 1;
        }
    }
    return out;
}

fn writeAll(sh: TcpStream, data: Array<Int>): Int {
    let r = sh.write(data).wait();
    if r.isErr() {
        return 0 - 1;
    }
    return r.unwrap();
}

fn serveEcho(sh: TcpStream, pings: Int): Int {
    let done = 0;
    while done < pings {
        let msg = readExact(sh, 64);
        if msg.length() != 64 {
            return 0 - 1;
        }
        let sent = writeAll(sh, msg);
        if sent < 0 {
            return 0 - 2;
        }
        done = done + 1;
    }
    return done;
}

fn serveOne(lh: Int, pings: Int): Int {
    let listener = new TcpListener(lh);
    let accepted = listener.accept().wait();
    if accepted.isErr() {
        return 0 - 1;
    }
    let sh: TcpStream = accepted.unwrap();
    let n = serveEcho(sh, pings);
    sh.close();
    return n;
}

fn pingOnce(sh: TcpStream, seed: Int): Int {
    let i = 0;
    while i < 64 {
        let data: Array<Int> = [payloadByte(seed + i)];
        let r = writeAll(sh, data);
        if r < 0 {
            return 0 - 1;
        }
        i = i + 1;
    }
    let sum = 0;
    let got = readExact(sh, 64);
    if got.length() != 64 {
        return 0 - 2;
    }
    let k = 0;
    while k < 64 {
        sum = sum + got[k];
        k = k + 1;
    }
    return sum;
}

fn clientLoop(port: Int, pings: Int): Int {
    let conn = TcpStream.connect("127.0.0.1", port).wait();
    if conn.isErr() {
        print("RESULT connect_fail", 1);
        return 0 - 1;
    }
    let h: TcpStream = conn.unwrap();
    let t0 = Clock.mono().nanos;
    let total = 0;
    let p = 0;
    while p < pings {
        let s = pingOnce(h, p);
        if s < 0 {
            print("RESULT ping_fail", p);
            return 0 - 3;
        }
        total = total + s;
        p = p + 1;
    }
    let t1 = Clock.mono().nanos;
    h.close();
    print("RESULT pings", pings);
    print("RESULT pingms", (t1 - t0) / 1000000);
    print("RESULT pingsum", total);
    return 0;
}

fn Main(): Int {
    let scale = Env.get("RNX_BENCH_SCALE");
    let pings = 300;
    if scale == "tiny" {
        pings = 20;
    }
    if scale == "small" {
        pings = 200;
    }
    let listener = TcpListener.bind("127.0.0.1", 0);
    let port = listener.port();
    let srv = Thread.spawn((): Int => serveOne(listener.handle, pings));
    let rc = clientLoop(port, pings);
    if rc != 0 {
        return rc;
    }
    let done = srv.join().unwrap();
    print("RESULT served", done);
    listener.close();
    return 0;
}
