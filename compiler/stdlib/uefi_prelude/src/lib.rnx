//! Prelude for `x86_64-unknown-uefi` programs.
//!
//! The foundation catalog and `Date` come from `@std/foundation` and
//! `@std/time`. The console surface comes from `@std/uefi`, so `println!`
//! reaches the UEFI ConOut protocol instead of a host stdout descriptor.
//! `@std/io`, `@std/log`, `@std/fs`, and `@std/process` are not imported:
//! none of them can work without an operating system.
export {
    Int,
    Float,
    FastFloat,
    Bool,
    String,
    Char,
    Array,
    Map,
    Set,
    Error,
    Any,
    Void,
    GenRef,
    Result,
    Iterator,
    Iterable,
    ArrayIter
} from "@std/foundation";
export { Date } from "@std/time";
export { println, uefi_println, printLine, printText } from "@std/uefi";
