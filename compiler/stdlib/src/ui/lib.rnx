    assert(t.w[box.id] == 170, "left and right set the width: " + t.w[box.id].toString())
    assert(t.h[box.id] == 80, "top and bottom set the height: " + t.h[box.id].toString())
}

test fn gridPlacesCellsInRows() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let grid = b.grid(2)
    grid.gap(4)
    grid.padding(0)
    let first = b.text("a")
    first.fixedHeight(20)
    let second = b.text("b")
    second.fixedHeight(20)
    let third = b.text("c")
    third.fixedHeight(20)
    let fourth = b.text("d")
    fourth.fixedHeight(20)
    grid.addChild(first)
    grid.addChild(second)
    grid.addChild(third)
    grid.addChild(fourth)
    t.endFrame()
    t.layout(grid, 220)
    assert(t.x[first.id] == 0, "first cell at the left")
    assert(t.x[second.id] == 112, "second cell in the right column: " + t.x[second.id].toString())
    assert(t.y[third.id] == 24, "third cell starts the next row: " + t.y[third.id].toString())
    assert(t.w[first.id] == 108, "cells share the width")
    assert(t.h[grid.id] == 44, "two rows and one gap: " + t.h[grid.id].toString())
}

test fn scrollChainsToTheOuterList() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let outer = b.scroll()
    outer.fixedHeight(100)
    outer.padding(0)
    let heading = b.text("top")
    heading.fixedHeight(80)
    heading.fixedWidth(200)
    let inner = b.scroll()
    inner.fixedHeight(40)
    inner.padding(0)
    let row1 = b.text("r1")
    row1.fixedHeight(40)
    row1.fixedWidth(200)
    let row2 = b.text("r2")
    row2.fixedHeight(40)
    row2.fixedWidth(200)
    inner.addChild(row1)
    inner.addChild(row2)
    let footer = b.text("bottom")
    footer.fixedHeight(80)
    footer.fixedWidth(200)
    outer.addChild(heading)
    outer.addChild(inner)
    outer.addChild(footer)
    t.endFrame()
    t.layout(outer, 200)
    assert(t.scrollMaxOf(outer) == 100.0, "outer has 100 of overflow")
    assert(t.scrollMaxOf(inner) == 40.0, "inner has 40 of overflow")
    assert(t.scrollAt(t.x[heading.id] + 2, t.y[heading.id] + 2, 40.0), "outer scrolls")
    t.layout(outer, 200)
    assert(t.scrollOf(outer) == 40.0, "outer moved")
    assert(t.scrollAt(t.x[inner.id] + 2, t.y[inner.id] + 2, 40.0), "inner scrolls")
    t.layout(outer, 200)
    assert(t.scrollOf(inner) == 40.0, "inner moved")
    assert(t.scrollAt(t.x[inner.id] + 2, t.y[inner.id] + 2, 0.0 - 40.0), "inner scrolls back")
    t.layout(outer, 200)
    assert(t.scrollOf(inner) == 0.0, "inner at the top")
    assert(t.scrollAt(t.x[inner.id] + 2, t.y[inner.id] + 2, 0.0 - 40.0), "outer takes the next step")
    t.layout(outer, 200)
    assert(t.scrollOf(outer) == 0.0, "outer chained to the top")
}

test fn aspectRatioSetsHeight() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
