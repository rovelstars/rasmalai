    let presenceTouched: Array<Bool> = []

    init(e: TextEngine) {
        this.engine = e
        this.linkHandler = (u: String) => {}
        this.cursorHandler = (s: Int) => {}
        let i = 0
        while i < 8 {
            this.pointerIds.push(-1)
            this.pointerDownV.push(false)
            this.pointerStartX.push(0.0)
            this.pointerStartY.push(0.0)
            this.pointerLastX.push(0.0)
            this.pointerLastY.push(0.0)
            this.pointerButtonV.push(0)
            this.pointerNodeV.push(-1)
            this.pointerPhaseV.push(0)
            this.pointerTimed.push(false)
            this.pointerLinkV.push("")
            this.pointerSampleN.push(0)
            this.pointerHoldV.push(0.0)
            this.pointerLongFired.push(false)
            i += 1
        }
        let s = 0
        while s < 64 {
            this.pointerSampleT.push(0)
            this.pointerSampleX.push(0.0)
            this.pointerSampleY.push(0.0)
            s += 1
        }
    }

    fn resetNode(id: Int, r: Role, n: String, k: String) {
        let wasList = this.role[id] == roleId(Role.list)
        let wasScroll = this.role[id] == roleId(Role.scroll)
        let keepScroll = (wasList && r == Role.list) || (wasScroll && r == Role.scroll)
        this.role[id] = roleId(r)
        this.name[id] = n
        this.key[id] = k
        this.parent[id] = -1
        this.first[id] = -1
        this.next[id] = -1
        this.last[id] = -1
        this.count[id] = 0
        this.actions[id] = 0
        this.value[id] = ""
        this.checked[id] = false
        this.handler[id] = -1
        this.textHandler[id] = -1
        this.richHandler[id] = -1
        this.canvasHandler[id] = -1
        this.numberHandler[id] = -1
        this.dragKindV[id] = ""
        this.dragTextV[id] = ""
        this.dropKindsV[id] = ""
        this.dropHandlerV[id] = -1
        this.fixedW[id] = 0
        this.fixedH[id] = 0
        this.textAlignV[id] = 0
        this.textLines[id] = 0
        this.textWrapV[id] = textWraps(roleId(r))
        if this.textSpansV[id].length() > 0 {
            this.textSpansV[id] = []
        }
        this.disabledV[id] = false
        this.clipV[id] = false
        this.clipRadiusV[id] = 0.0
        this.shadowColorV[id] = 0
        this.shadowDxV[id] = 0.0
        this.shadowDyV[id] = 0.0
        this.shadowBlurV[id] = 0.0
        this.shadowRadiusV[id] = 0.0
        this.elevationV[id] = 0
        this.opacityV[id] = 1.0
        this.blendV[id] = 0
        this.maskRadiusV[id] = 0.0
        this.blurSigmaV[id] = 0.0
        if !keepScroll {
            this.scrollV[id] = 0.0
            this.scrollVelV[id] = 0.0
            this.scrollFlingV[id] = false
            this.scrollOverV[id] = 0.0
            this.scrollSpringV[id].setValue(0.0)
            this.scrollSpringV[id].setTarget(0.0)
            this.scrollDecayV[id].rebase(0.0, 0.0)
        }
        this.scrollMax[id] = 0.0
        this.numberV[id] = 0.0
        this.offsetYV[id] = 0.0
        this.padV[id] = -1
        this.gapV[id] = -1
        this.marginV[id] = 0
        this.growV[id] = 0.0
        this.shrinkV[id] = 1.0
        this.mainAlignV[id] = 0
        this.crossAlignV[id] = 0
        this.minWV[id] = 0
        this.minHV[id] = 0
        this.maxWV[id] = 0
        this.maxHV[id] = 0
        this.absV[id] = false
        this.leftV[id] = -1
        this.topV[id] = -1
        this.rightV[id] = -1
        this.bottomV[id] = -1
        this.columnsV[id] = 1
        this.portalV[id] = false
        this.inertV[id] = false
        this.roundV[id] = false
        this.accentV[id] = false
        this.toneV[id] = 0
        this.raisedV[id] = false
        this.gradientV[id] = false
        this.textSizeV[id] = 0
        this.fontWeightV[id] = 400
        this.italicV[id] = false
        this.lineHeightV[id] = 0.0
        this.letterSpacingV[id] = 0.0
        this.zV[id] = 0
        this.gapPctV[id] = 0.0
        this.gapPxV[id] = 0
        this.autoV[id] = false
        this.idealWV[id] = 0
        this.idealHV[id] = 0
        this.rovingV[id] = false
        this.imageV[id] = ByteBuffer.allocate(0)
        this.imageFitV[id] = 0
        this.imageIntrWV[id] = -1
        this.imageIntrHV[id] = -1
        this.seqV[id] = 0
        this.cacheVer[id] = -1
        this.cacheAvail[id] = -1
        this.cacheExact[id] = false
        this.cacheW[id] = 0
        this.cacheH[id] = 0
        this.portalLayerV[id] = -1
        this.ratioV[id] = 0.0
        this.alignSelfV[id] = -1
        this.orderV[id] = 0
        this.sizeV[id] = 0
        this.tooltipV[id] = ""
        this.selectedV[id] = false
        this.expandedV[id] = -1
        this.busyV[id] = false
        this.requiredV[id] = false
        this.invalidV[id] = 0
        this.levelV[id] = 0
        this.liveV[id] = 0
        this.descriptionV[id] = ""
        this.labelIdV[id] = -1
        this.describedByIdV[id] = -1
        this.controlsIdV[id] = -1
        this.rangeMinV[id] = 0.0
        this.rangeMaxV[id] = 0.0
        this.rangeStepV[id] = 0.0
        this.x[id] = 0
        this.y[id] = 0
        this.w[id] = 0
        this.h[id] = 0
        this.live[id] = true
    }

    fn keyed(k: String): Int {
        let i = 0
        while i < this.keyIndexKeys.length() {
            if this.keyIndexKeys[i] == k {
                return this.keyIndexIds[i]
            }
            i += 1
        }
        return -1
    }

    /** Start a frame. Existing nodes become reusable and handlers are cleared. */
    pub fn beginFrame() {
        this.stepPresence()
        this.stepGestures(this.frameDtV)
        this.keyIndexKeys = []
        this.keyIndexIds = []
        this.claimed = []
        let i = 0
        while i < this.role.length() {
            this.claimed.push(false)
            if this.live[i] && this.key[i] != "" {
                this.keyIndexKeys.push(this.key[i])
                this.keyIndexIds.push(i)
            }
            this.live[i] = false
            i += 1
        }
        this.handlers = []
        this.textHandlers = []
        this.richHandlers = []
        this.canvasHandlers = []
        this.numberHandlers = []
        this.dropHandlers = []
        this.cursor = 0
        this.aligned = true
        this.pendingKey = ""
        let t = 0
        while t < this.presenceTouched.length() {
            this.presenceTouched[t] = false
            t += 1
        }
        this.frameOpen = true
    }

    /** Close the frame and drop focus from nodes that were not rebuilt. */
    /**
     * Snapshot the presented state. Call once after painting a frame, so input
     * that arrives between frames is compared against what the screen shows
     * rather than against a value that was already mutated by the event.
     */
    pub fn commit() {
        let i = 0
        while i < this.role.length() {
            if this.live[i] {
                this.prevX[i] = this.x[i]
                this.prevY[i] = this.y[i]
                this.prevW[i] = this.w[i]
                this.prevH[i] = this.h[i]
                this.prevName[i] = this.name[i]
                this.prevValue[i] = this.value[i]
                this.prevChecked[i] = this.checked[i]
                this.prevRole[i] = this.role[i]
                this.prevDisabled[i] = this.disabledV[i]
                this.prevCaret[i] = this.caretV[i]
                this.prevPreedit[i] = this.preeditV[i]
                this.prevSelStart[i] = this.selStartV[i]
                this.prevSelEnd[i] = this.selEndV[i]
                this.prevNumber[i] = this.numberV[i]
                this.prevMaskRadius[i] = this.maskRadiusV[i]
                this.prevBlurSigma[i] = this.blurSigmaV[i]
                this.prevOpacity[i] = this.opacityV[i]
                this.prevBlend[i] = this.blendV[i]
            } else {
                this.prevW[i] = 0
                this.prevH[i] = 0
            }
            i += 1
        }
        this.prevFocus = this.focus
        this.prevFocusVisible = this.focusVisible
        this.prevHovered = this.hovered
        this.prevPressed = this.pressed
    }

    pub fn endFrame() {
        if this.focus >= 0 && !this.live[this.focus] {
            this.focus = -1
        }
        if this.scope >= 0 && !this.live[this.scope] {
            this.scope = -1
        }
        this.compactPresence()
        this.frameOpen = false
        this.pendingKey = ""
    }

    pub fn setPendingKey(k: String) {
        this.pendingKey = k
    }

    pub fn setKey(id: Int, k: String) {
        if id >= 0 && id < this.key.length() {
            this.key[id] = k
        }
    }

    /** Replace the text backend. Called once by the app before the first view. */
    pub fn setTextEngine(e: TextEngine) {
        this.engine = e
    }

    pub fn setTextAlign(id: Int, a: Align) {
        if id >= 0 && id < this.textAlignV.length() {
            this.textAlignV[id] = alignId(a)
        }
    }

    pub fn setTextWrap(id: Int, on: Bool) {
        this.touch()
        if id >= 0 && id < this.textWrapV.length() {
            this.textWrapV[id] = on
        }
    }

    pub fn setTextMaxLines(id: Int, n: Int) {
        this.touch()
        if id >= 0 && id < this.textLines.length() {
            this.textLines[id] = n
        }
    }

    /** Inline style spans for this node's text. */
    pub fn setTextSpans(id: Int, spans: Array<TextSpan>) {
        this.touch()
        if id >= 0 && id < this.textSpansV.length() {
            this.textSpansV[id] = spans
        }
    }

    pub fn textSpansOf(id: Int): Array<TextSpan> {
        if id >= 0 && id < this.textSpansV.length() {
            return this.textSpansV[id]
        }
        return []
    }

    /** Handler called once for a completed link click. */
    pub fn setLinkHandler(cb: fn(String): Void) {
        this.linkHandler = cb
    }

    /** Handler called with the cursor shape id when it changes. */
    pub fn setCursorHandler(cb: fn(Int): Void) {
        this.cursorHandler = cb
    }

    /** Current cursor shape id: 0 default, 1 text, 2 pointer. */
    pub fn cursorShape(): Int {
        return this.cursorShapeV
    }

    fn setCursorShape(shape: Int) {
        if shape == this.cursorShapeV {
            return
        }
        this.cursorShapeV = shape
        this.cursorHandler(shape)
    }

    /** Left edge of one laid-out row, including text padding and alignment. */
    fn textRowX(id: Int, row: Int): Float {
        let r = this.role[id]
        let lay = this.textLayoutV[id]
        let pad = textPad(r)
        let inner = Float(this.w[id]) - pad * 2.0
        let rx = Float(this.x[id]) + pad
        if row >= 0 && row < lay.rows.length() {
            let width = lay.rows[row].width
            let a = this.textAlignV[id]
            if this.rtlV && a == 0 {
                a = 2
            } else if this.rtlV && a == 2 {
                a = 0
            }
            if a == 1 {
                rx = Float(this.x[id]) + pad + (inner - width) / 2.0
            } else if a == 2 {
                rx = Float(this.x[id]) + pad + inner - width
            }
        }
        return rx
    }

    /** Top edge of one laid-out row, matching the paint origin. */
    fn textRowY(id: Int, row: Int): Float {
        let r = this.role[id]
        let lay = this.textLayoutV[id]
        let ty = Float(this.y[id]) + (Float(this.h[id]) - lay.height) / 2.0
        if r == 4 || r == 5 {
            ty = Float(this.y[id])
        } else if r == 7 {
            ty = Float(this.y[id]) + 4.0
        } else if r == 12 {
            ty = Float(this.y[id]) + textPadY(r)
        }
        let i = 0
        while i < row && i < lay.rows.length() {
            ty += lay.rows[i].height
            i += 1
        }
        return ty
    }

    fn linkAtNode(id: Int, x: Int, y: Int): String {
        if id < 0 || id >= this.role.length() {
            return ""
        }
        let r = this.role[id]
        if r != roleId(Role.text) && r != roleId(Role.textbox) {
            return ""
        }
        let spans = this.textSpansV[id]
        if spans.length() == 0 || this.verticalV {
            return ""
        }
        let lay = this.textLayoutV[id]
        let ri = 0
        while ri < lay.runs.length() {
            let run = lay.runs[ri]
            if (run.flags & 1) == 0 && run.end > run.start && run.row < lay.rows.length() {
                let ry = this.textRowY(id, run.row)
                let rh = lay.rows[run.row].height
                let rx = this.textRowX(id, run.row)
                if Float(y) >= ry && Float(y) < ry + rh {
                    if Float(x) >= rx + run.x && Float(x) < rx + run.x + run.advance {
                        let count = run.end - run.start
                        let rel = (Float(x) - (rx + run.x)) * Float(count) / run.advance
                        let idx = run.start + Int(rel)
                        let at = idx
                        if at < run.start { at = run.start }
                        if at >= run.end { at = run.end - 1 }
                        let sp = spanAt(spans, at)
                        if sp != null {
                            return sp.link
                        }
                        return ""
                    }
                }
            }
            ri += 1
        }
        return ""
    }

    /** The URL under a screen point, or an empty string. */
    pub fn linkAt(x: Int, y: Int): String {
        let hit = this.hitTest(x, y)
        return this.linkAtNode(hit, x, y)
    }

    fn pointerTargetFor(hit: Int, x: Int, y: Int): PointerTarget {
        if hit < 0 || hit >= this.role.length() {
            return new PointerTarget("", 0)
        }
        let r = this.role[hit]
        let shape = 0
        if r == roleId(Role.textbox) {
            shape = 1
        }
        let url = this.linkAtNode(hit, x, y)
        if url != "" {
            shape = 2
        }
        return new PointerTarget(url, shape)
    }

    fn pointerTargetAt(x: Int, y: Int): PointerTarget {
        return this.pointerTargetFor(this.hitTest(x, y), x, y)
    }

    /** One rectangle per link span on a text or textbox node. */
    pub fn linkRects(id: Int): Array<LinkRect> {
        let out: Array<LinkRect> = []
        if id >= 0 && id < this.role.length() {
            let r = this.role[id]
            if (r == roleId(Role.text) || r == roleId(Role.textbox)) && !this.verticalV {
                let spans = this.textSpansV[id]
                if spans.length() > 0 {
                    let lay = this.textLayoutV[id]
                    let source = this.textOf(id)
                    let len = source.length()
                    let i = 0
                    while i < spans.length() {
                        let sp = spans[i]
                        if sp.link != "" && sp.start < sp.end {
                            let minX = 0.0
                            let maxX = 0.0
                            let minY = 0.0
                            let maxY = 0.0
                            let found = false
                            let ri = 0
                            while ri < lay.runs.length() {
                                let run = lay.runs[ri]
                                if (run.flags & 1) == 0 && run.end > run.start && run.row < lay.rows.length()
                                    && run.end > sp.start && run.start < sp.end {
                                    let count = run.end - run.start
                                    let lead = 0
                                    if sp.start > run.start {
                                        lead = sp.start - run.start
                                    }
                                    let tail = count
                                    if sp.end < run.end {
                                        tail = sp.end - run.start
                                    }
                                    let x0 = this.textRowX(id, run.row) + run.x + run.advance * Float(lead) / Float(count)
                                    let x1 = this.textRowX(id, run.row) + run.x + run.advance * Float(tail) / Float(count)
                                    let ry = this.textRowY(id, run.row)
                                    let rh = lay.rows[run.row].height
                                    if x1 < x0 {
                                        let t = x0
                                        x0 = x1
                                        x1 = t
                                    }
                                    if !found {
                                        minX = x0
                                        maxX = x1
                                        minY = ry
                                        maxY = ry + rh
                                        found = true
                                    } else {
                                        if x0 < minX { minX = x0 }
                                        if x1 > maxX { maxX = x1 }
                                        if ry < minY { minY = ry }
                                        if ry + rh > maxY { maxY = ry + rh }
                                    }
                                }
                                ri += 1
                            }
                            if found {
                                let s = sp.start
                                let e = sp.end
                                if s < 0 { s = 0 }
                                if e > len { e = len }
                                if s > e { s = e }
                                out.push(new LinkRect(
                                    sp.link,
                                    source.slice(s, e),
                                    Int(minX),
                                    Int(minY),
                                    Int(maxX - minX + 0.5),
                                    Int(maxY - minY + 0.5)
                                ))
                            }
                        }
                        i += 1
                    }
                }
            }
        }
        return out
    }

    pub fn setDraggable(id: Int, kind: String, text: String) {
        if id >= 0 && id < this.dragKindV.length() {
            this.dragKindV[id] = kind
            this.dragTextV[id] = text
        }
    }

    pub fn setDropTarget(id: Int, kinds: String, cb: fn(DragData): Void) {
        if id >= 0 && id < this.dropKindsV.length() {
            this.dropKindsV[id] = kinds
            this.dropHandlerV[id] = this.dropHandlers.length()
            this.dropHandlers.push(cb)
        }
    }

    pub fn setDisabled(id: Int, on: Bool) {
        if id >= 0 && id < this.disabledV.length() {
            this.disabledV[id] = on
            if on && this.focus == id {
                this.focus = -1
            }
        }
    }

