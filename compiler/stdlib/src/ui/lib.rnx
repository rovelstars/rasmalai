    assert(t.unnamedInteractive() == -1, "all named")
}

test fn frameClockFreezesWhilePaused() {
    let c = new FrameClock()
    c.tick(1000000000)
    c.tick(1016666666)
    assert(c.dt() > 0.016, "delta advances")
    let running = c.elapsed()
    c.setPaused(true)
    c.tick(3000000000)
    assert(c.dt() == 0.0, "paused delta is zero")
    assert(c.elapsed() == running, "paused time does not advance")
    c.setPaused(false)
    c.tick(4000000000)
    assert(c.dt() == 0.0, "resume does not jump")
    c.tick(4010000000)
    assert(c.dt() > 0.0, "running again after resume")
}

test fn canvasKeepsItsSizeAndDrawsAPolygon() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let c = b.canvas("cube", 120, 90, (cv: Canvas) => {
        cv.fill(rgba(10, 20, 30, 255))
        cv.polygon(rgba(200, 50, 50, 255), [1.0, 2.0, 20.0, 2.0, 10.0, 18.0])
    })
    root.addChild(c)
    t.endFrame()
    t.layout(root, 300)
    let d = Painter.paint(t, 300, 200, Theme.dark())
    assert(d.describe(3) == "polygon " + rgba(200, 50, 50, 255).toString() + " 3 points", d.describe(3))
    assert(d.describe(2).startsWith("fill " + rgba(10, 20, 30, 255).toString() + " 16.0,16.0 120.0x90.0"), d.describe(2))
}

test fn buildCarriesTheFrameClock() {
    let t = new Tree(TextEngine.fixed())
    let b = new Build(t)
    let c = new FrameClock()
    b.setClock(c)
    assert(b.frameClock() == c, "clock shared")
}

test fn canvasesReportSeparateDamage() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let row = b.row()
    row.addChild(b.canvas("a", 300, 300, (c: Canvas) => {}))
    row.addChild(b.canvas("b", 300, 300, (c: Canvas) => {}))
    row.addChild(b.canvas("c", 300, 300, (c: Canvas) => {}))
    root.addChild(row)
    t.endFrame()
    t.layout(root, 960)
    t.commit()

    t.beginFrame()
    let b2 = new Build(t)
    let root2 = b2.column()
    let row2 = b2.row()
    row2.addChild(b2.canvas("a", 300, 300, (c: Canvas) => {}))
    row2.addChild(b2.canvas("b", 300, 300, (c: Canvas) => {}))
    row2.addChild(b2.canvas("c", 300, 300, (c: Canvas) => {}))
    root2.addChild(row2)
    t.endFrame()
    t.layout(root2, 960)
    let d = t.damageOf(960, 470, false)
    t.commit()
    assert(d.count() == 3, "three canvases, three regions: " + d.count().toString())
}

test fn regionPaintSkipsUnchangedNodes() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.addChild(b.heading("Title"))
    root.addChild(b.buttonInert("Reset"))
    t.endFrame()
    t.layout(root, 300)
    let full = Painter.paint(t, 300, 200, Theme.dark())
    let dm = new Damage()
    dm.add(0, 0, 300, 40)
    let part = Painter.paintRegions(t, 300, 200, Theme.dark(), dm)
    assert(part.recordCount() < full.recordCount(), "region paint drops the button")
    assert(part.toString().contains("Title"), part.toString())
    assert(!part.toString().contains("Reset"), part.toString())
}

test fn shortcutsBindReplaceAndRun() {
    let s = new Shortcuts()
    let hits = [0]
    assert(!s.bind("Ctrl+S", () => { hits[0] += 1 }), "new binding")
    assert(s.run("ctrl+s"), "case-insensitive")
    assert(hits[0] == 1, "handler ran")
    assert(s.bind("ctrl+s", () => { hits[0] += 10 }), "replaced")
    assert(s.len() == 1, "one chord")
    assert(s.run("CTRL+S"), "still bound")
    assert(hits[0] == 11, "replacement ran")
    assert(!s.run("ctrl+x"), "unknown chord")
}

test fn disabledControlsStayOutOfFocusAndInput() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let hits = [0]
    let btn = b.button("Go", () => { hits[0] += 1 })
    btn.disabled(true)
    let root = b.column()
    root.addChild(btn)
    t.endFrame()
    t.layout(root, 300)
    assert(!t.pointerDown(t.x[btn.id] + 2, t.y[btn.id] + 2), "disabled tap ignored")
    assert(hits[0] == 0, "handler not fired")
    assert(t.focusNext() == -1, "disabled skipped by focus")
}

test fn pointerFocusHidesTheRing() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let sl = b.sliderValue("Volume", 0.5, (v: Float) => {})
    let root = b.column()
    root.addChild(sl)
    t.endFrame()
    t.layout(root, 300)
    t.pointerDown(t.x[sl.id] + 40, t.y[sl.id] + 36)
    assert(!t.focusIsVisible(), "pointer focus has no ring")
    t.pointerLeave()
    t.focusNext()
    assert(t.focusIsVisible(), "keyboard focus shows the ring")
}

test fn pointerLeaveCancelsADrag() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let sl = b.sliderValue("Volume", 0.2, (v: Float) => {})
    let root = b.column()
    root.addChild(sl)
    t.endFrame()
    t.layout(root, 300)
    t.pointerDown(t.x[sl.id] + 10, t.y[sl.id] + 36)
    let before = t.numberOf(sl)
    assert(t.pointerLeave(), "leave changes state")
    assert(t.numberOf(sl) == before, "leave keeps the last value")
    t.pointerMove(t.x[sl.id] + 200, t.y[sl.id] + 36)
    assert(t.numberOf(sl) == before, "no drag after leave")
}

test fn textFieldEditsAtTheCaret() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let seen = [""]
    let field = b.textField("ab", "type", (v: String) => { seen[0] = v })
    let root = b.column()
    root.addChild(field)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(field)
    assert(t.typeText(field, "c"), "typed")
    assert(t.valueOf(field) == "abc", t.valueOf(field))
    assert(t.keyDown(field, Key.left), "moved left")
    assert(t.typeText(field, "X"), "typed in the middle")
    assert(t.valueOf(field) == "abXc", t.valueOf(field))
    assert(t.keyDown(field, Key.backspace), "backspace")
    assert(t.valueOf(field) == "abc", t.valueOf(field))
    assert(seen[0] == "abc", "handler saw the value")
}

test fn sliderMovesWithArrowKeys() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let moves = [0]
    let sl = b.slider("Volume")
    let root = b.column()
    root.addChild(sl)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(sl)
    let before = t.numberOf(sl)
    assert(t.keyDown(sl, Key.right), "right steps")
    assert(t.numberOf(sl) > before, "value grew")
    assert(t.keyDown(sl, Key.home), "home")
    assert(t.numberOf(sl) == 0.0, "clamped at zero")
}

test fn virtualListBuildsOnlyVisibleRows() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let v = b.virtualList("rows", "rows", 1000, 30, 120)
    let root = b.column()
    root.addChild(v.node)
    let i = 0
    while i < v.count {
        let r = b.listItem("row " + (v.first + i).toString(), () => {})
        r.fixedHeight(30)
        v.node.addChild(r)
        i += 1
    }
    t.endFrame()
    t.layout(root, 320)
    assert(t.childCount(v.node) <= 6, "only the viewport rows: " + t.childCount(v.node).toString())
    assert(t.scrollAt(t.x[v.node.id] + 2, t.y[v.node.id] + 2, 60.0), "wheel scrolls the list")

    t.beginFrame()
    let b2 = new Build(t)
    let v2 = b2.virtualList("rows", "rows", 1000, 30, 120)
    let root2 = b2.column()
    root2.addChild(v2.node)
    let j = 0
    while j < v2.count {
        let r = b2.listItem("row " + (v2.first + j).toString(), () => {})
        r.fixedHeight(30)
        v2.node.addChild(r)
        j += 1
    }
    t.endFrame()
    t.layout(root2, 320)
    assert(t.childCount(v2.node) <= 6, "rebuilt viewport")
    assert(t.snapshot().contains("row 2"), t.snapshot())
}

test fn sliderTrackFollowsTheValue() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let got = [0.25]
    let sl = b.sliderValue("Volume", 0.25, (v: Float) => { got[0] = v })
    let root = b.column()
    root.addChild(sl)
    t.endFrame()
    t.layout(root, 300)

    t.pointerDown(t.x[sl.id] + t.w[sl.id] * 3 / 4, t.y[sl.id] + 36)
    assert(got[0] > 0.6, "drag updates the callback: " + got[0].toString())

    t.beginFrame()
    let b2 = new Build(t)
    let sl2 = b2.sliderValue("Volume", got[0], (v: Float) => { got[0] = v })
    let root2 = b2.column()
    root2.addChild(sl2)
    t.endFrame()
    t.layout(root2, 300)
    assert(t.numberOf(sl2) > 0.6, "range follows state: " + t.numberOf(sl2).toString())

    let dm = t.damageOf(300, 200, false)
    assert(dm.count() > 0, "slider value change damages")
    let th = Theme.dark()
    let d = Painter.paintRegions(t, 300, 200, th, dm)
    let i = 0
    let fillW = 0.0
    while i < d.recordCount() {
        if d.kindAt(i) == 1 && d.colorAt(i) == th.accent && d.wAt(i) > fillW {
            fillW = d.wAt(i)
        }
        i += 1
    }
    t.commit()
    assert(fillW > Float(t.w[sl2.id]) * 0.5, "track fill grew: " + fillW.toString())
}

test fn virtualListRecyclesAcrossScrolls() {
    let t = new Tree(TextEngine.fixed())
    let listId = -1
    let rounds = 0
    while rounds < 80 {
        t.beginFrame()
        let b = new Build(t)
        let v = b.virtualList("rows", "rows", 20, 30, 120)
        listId = v.node.id
        let root = b.column()
        root.addChild(v.node)
        let i = 0
        while i < v.count {
            let r = b.listItem("row " + (v.first + i).toString(), () => {})
            r.fixedHeight(30)
            v.node.addChild(r)
            i += 1
        }
        t.endFrame()
        t.layout(root, 320)
        let dy = 45.0
        if rounds >= 40 {
            dy = 0.0 - 45.0
        }
        t.scrollAt(t.x[listId] + 2, t.y[listId] + 2, dy)
        rounds += 1
    }
    assert(t.len() < 80, "node count stays bounded: " + t.len().toString())

    t.beginFrame()
    let b2 = new Build(t)
    let v2 = b2.virtualList("rows", "rows", 20, 30, 120)
    let root2 = b2.column()
    root2.addChild(v2.node)
    let j = 0
    while j < v2.count {
        let r = b2.listItem("row " + (v2.first + j).toString(), () => {})
        r.fixedHeight(30)
        v2.node.addChild(r)
        j += 1
    }
    t.endFrame()
    t.layout(root2, 320)
    assert(t.snapshot().contains("row 0"), "scrolled back to the top: " + t.snapshot())
}

test fn focusRingOnlyAfterKeyboardFocus() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let field = b.textField("", "name", (v: String) => {})
    let root = b.column()
    root.addChild(field)
    t.endFrame()
    t.layout(root, 300)
    t.pointerDown(t.x[field.id] + 5, t.y[field.id] + 5)
    assert(!t.focusIsVisible(), "click does not show the ring")
    let th = Theme.dark()
    let d1 = Painter.paint(t, 300, 120, th)
    let i = 0
    let ring1 = 0
    while i < d1.recordCount() {
        if d1.kindAt(i) == 1 && d1.colorAt(i) == th.focus {
            ring1 += 1
        }
        i += 1
    }
    assert(ring1 == 0, "no focus outline on a click")

    t.focusNext()
    let d2 = Painter.paint(t, 300, 120, th)
    let j = 0
    let ring2 = 0
    while j < d2.recordCount() {
        if d2.kindAt(j) == 1 && d2.colorAt(j) == th.focus {
            ring2 += 1
        }
        j += 1
    }
    assert(ring2 > 0, "keyboard focus paints the ring")
}

test fn sliderKnobStaysInsideTheTrack() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let sl = b.sliderValue("Volume", 0.0, (v: Float) => {})
    let root = b.column()
    root.addChild(sl)
    t.endFrame()
    t.layout(root, 300)
    let th = Theme.dark()
    let d = Painter.paint(t, 300, 120, th)
    let i = 0
    let knobX = -1.0
    while i < d.recordCount() {
        if d.kindAt(i) == 1 && d.colorAt(i) == th.text && d.wAt(i) == 10.0 {
            knobX = d.xAt(i)
        }
        i += 1
    }
    assert(knobX == Float(t.x[sl.id]), "knob sits at the left edge: " + knobX.toString())
}

test fn scrollFallsBackToTheLastList() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let v = b.virtualList("rows", "rows", 200, 30, 120)
    let root = b.column()
    root.addChild(v.node)
    let i = 0
    while i < v.count {
        let r = b.listItem("row " + (v.first + i).toString(), () => {})
        r.fixedHeight(30)
        v.node.addChild(r)
        i += 1
    }
    t.endFrame()
    t.layout(root, 320)
    assert(t.scrollAt(t.x[v.node.id] + 2, t.y[v.node.id] + 2, 90.0), "first scroll hits the list")
    let after = t.scrollOf(v.node)
    assert(t.scrollAt(2, 2, 0.0 - 30.0), "fallback scrolls the last list")
    assert(t.scrollOf(v.node) < after, "fallback moved the list")
}

test fn layoutAppliesPaddingGapAndMargin() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(10)
    root.gap(4)
    let first = b.text("a")
    first.fixedHeight(20)
    first.margin(3)
    let second = b.text("b")
    second.fixedHeight(20)
    second.margin(3)
    root.addChild(first)
    root.addChild(second)
    t.endFrame()
    t.layout(root, 200)
    assert(t.x[first.id] == 13, "padding and margin shift the child")
    assert(t.y[second.id] == t.y[first.id] + 20 + 6 + 4, "margin and gap stack")
    assert(t.h[root.id] == 76, "padding and margins count in the height: " + t.h[root.id].toString())
}

test fn layoutRowFixedAndGrow() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    let side = b.column()
    side.fixedWidth(120)
    side.fixedHeight(80)
    let detail = b.column()
    detail.grow(1.0)
    detail.fixedHeight(80)
    row.addChild(side)
    row.addChild(detail)
    t.endFrame()
    t.layout(row, 400)
    assert(t.w[side.id] == 120, "fixed sidebar keeps its width")
    assert(t.w[detail.id] == 272, "grow takes the rest after the gap: " + t.w[detail.id].toString())
    assert(t.h[row.id] == 80, "row height is the tallest child")
}

test fn layoutGrowsIntoTheWindowHeight() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let head = b.text("head")
    head.fixedHeight(40)
    let body = b.row()
    body.grow(1.0)
    body.alignCross(Align.stretch)
    let side = b.column()
    side.fixedWidth(100)
    let main = b.column()
    main.grow(1.0)
    body.addChild(side)
    body.addChild(main)
    let foot = b.text("foot")
    foot.fixedHeight(30)
    root.addChild(head)
    root.addChild(body)
    root.addChild(foot)
    t.endFrame()
    t.layoutIn(root, 500, 300)
    assert(t.h[root.id] == 300, "root fills the window")
    assert(t.h[head.id] == 40, "header keeps its height")
    assert(t.h[foot.id] == 30, "footer keeps its height")
    assert(t.h[body.id] == 182, "body takes the rest: " + t.h[body.id].toString())
    assert(t.h[side.id] == 182, "sidebar fills the row height")
    assert(t.h[main.id] == 182, "detail fills the row height")
    assert(t.w[side.id] == 100, "sidebar keeps its width")
    assert(t.w[main.id] == 360, "detail takes the remaining width")
}

test fn layoutAlignsMainAndCross() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.fixedHeight(100)
    root.alignMain(Align.center)
    root.alignCross(Align.center)
    let item = b.text("x")
    item.fixedHeight(20)
    item.fixedWidth(40)
    root.addChild(item)
    t.endFrame()
    t.layout(root, 200)
    assert(t.y[item.id] == 40, "main axis centers the child")
    assert(t.x[item.id] == 80, "cross axis centers the child")
}

test fn layoutClampsToMinAndMax() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let narrow = b.text("narrow")
    narrow.fixedWidth(500)
    narrow.maxWidth(200)
    let short = b.text("short")
    short.fixedHeight(10)
    short.minHeight(40)
    root.addChild(narrow)
    root.addChild(short)
    t.endFrame()
    t.layout(root, 600)
    assert(t.w[narrow.id] == 200, "max width clamps the box")
    assert(t.h[short.id] == 40, "min height clamps the box")
}

test fn layoutRowShrinksOverflow() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    row.gap(4)
    let first = b.slider("first")
    let second = b.slider("second")
    let detail = b.column()
    detail.grow(1.0)
    detail.fixedHeight(44)
    row.addChild(first)
    row.addChild(second)
    row.addChild(detail)
    t.endFrame()
    t.layout(row, 300)
    assert(t.w[first.id] < 180, "first slider shrinks: " + t.w[first.id].toString())
    assert(t.w[first.id] == t.w[second.id], "both sliders shrink together")
}

test fn layoutColumnStretchesWidth() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.alignCross(Align.stretch)
    let child = b.button("wide", () => {})
    let fixed = b.text("fixed")
    fixed.fixedWidth(50)
    root.addChild(child)
    root.addChild(fixed)
    t.endFrame()
    t.layout(root, 300)
    assert(t.w[child.id] == 300, "stretch fills the column width: " + t.w[child.id].toString())
    assert(t.w[fixed.id] == 50, "stretch keeps an explicit width")
}

test fn stackOverlaysChildrenInOrder() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let stack = b.stack()
    let under = b.text("under")
    under.fixedWidth(100)
    under.fixedHeight(20)
    let over = b.text("over")
    over.fixedWidth(50)
    over.fixedHeight(40)
    stack.addChild(under)
    stack.addChild(over)
    t.endFrame()
    t.layout(stack, 120)
    assert(t.x[under.id] == t.x[over.id], "stack children share an origin")
    assert(t.y[under.id] == t.y[over.id], "stack children share an origin")
    assert(t.h[stack.id] == 40, "stack height is the tallest child")
    assert(t.hitTest(1, 1) == over.id, "the later child is on top")
}

test fn crossfadeStacksItsChildrenOnOneOrigin() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let outgoing = Text("outgoing")
    outgoing.height = 30
    let incoming = Text("incoming")
    incoming.height = 50
    let root = View.mount(t, Crossfade([outgoing, incoming]))
    t.endFrame()
    t.layout(root, 200)
    let old = t.find(Role.text, "outgoing")
    let fresh = t.find(Role.text, "incoming")
    assert(t.role[root.id] == 17, "crossfade uses the stack role")
    assert(old >= 0 && fresh >= 0, "crossfade mounts both children")
    assert(t.x[old] == t.x[fresh] && t.y[old] == t.y[fresh], "crossfade children share an origin")
    assert(t.h[root.id] == 50, "crossfade takes the tallest child")
}

test fn scrollMovesChildrenAndClamps() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let view = b.scroll()
    view.fixedHeight(60)
    let i = 0
    while i < 4 {
        let row = b.text("row " + i.toString())
        row.fixedHeight(40)
        view.addChild(row)
        i += 1
    }
    root.addChild(view)
    t.endFrame()
    t.layout(root, 200)
    assert(t.h[view.id] == 60, "scroll keeps its viewport")
    assert(t.scrollMaxOf(view) == 100.0, "content is 160 in a 60 viewport")
    let first = t.first[view.id]
    assert(t.y[first] == 0, "content starts at the top")
    assert(t.scrollAt(t.x[view.id] + 2, t.y[view.id] + 2, 40.0), "wheel scrolls the viewport")
    t.layout(root, 200)
    assert(t.scrollOf(view) == 40.0, "scroll offset is kept")
    assert(t.y[first] == -40, "the first row moves up")
}

test fn wrapFlowsChildrenIntoLines() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let wrap = b.wrap()
    wrap.gap(0)
    wrap.padding(0)
    let a = b.button("a", () => {})
    a.fixedWidth(60)
    a.fixedHeight(20)
    let c = b.button("c", () => {})
    c.fixedWidth(60)
    c.fixedHeight(20)
    let d = b.button("d", () => {})
    d.fixedWidth(60)
    d.fixedHeight(20)
    wrap.addChild(a)
    wrap.addChild(c)
    wrap.addChild(d)
    t.endFrame()
    t.layout(wrap, 100)
    assert(t.y[c.id] == 20, "second child starts a new line")
    assert(t.y[d.id] == 40, "third child starts a new line")
    assert(t.h[wrap.id] == 60, "three lines of twenty")
}

test fn spacerTakesFreeSpace() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    let left = b.button("left", () => {})
    let gap = b.spacer()
    let right = b.button("right", () => {})
    row.addChild(left)
    row.addChild(gap)
    row.addChild(right)
    t.endFrame()
    t.layout(row, 300)
    assert(t.w[gap.id] > 0, "spacer gets the free width: " + t.w[gap.id].toString())
    assert(t.x[right.id] > t.x[left.id] + t.w[left.id], "spacer pushes the right child")
}

test fn absolutePinsToEdges() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.fixedHeight(100)
    let flow = b.text("flow")
    flow.fixedHeight(20)
    let box = b.text("box")
    box.fixedWidth(40)
    box.fixedHeight(30)
    box.absolute()
    box.left(10)
    box.top(20)
    let corner = b.text("corner")
    corner.fixedWidth(30)
    corner.fixedHeight(30)
    corner.absolute()
    corner.right(5)
    corner.bottom(7)
    root.addChild(flow)
    root.addChild(box)
    root.addChild(corner)
    t.endFrame()
    t.layout(root, 200)
    assert(t.x[box.id] == 10, "left edge pins the box")
    assert(t.y[box.id] == 20, "top edge pins the box")
    assert(t.x[corner.id] == 165, "right edge pins the box: " + t.x[corner.id].toString())
    assert(t.y[corner.id] == 63, "bottom edge pins the box: " + t.y[corner.id].toString())
    assert(t.y[flow.id] == 0, "absolute children stay out of the flow")
}

test fn absoluteStretchesBetweenEdges() {
    let t = new Tree(TextEngine.fixed())
