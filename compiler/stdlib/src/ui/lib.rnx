        if id >= 0 && id < this.imageIntrWV.length() {
            this.imageIntrWV[id] = w
            this.imageIntrHV[id] = h
        }
    }

    pub fn setInert(id: Int, on: Bool) {
        if id >= 0 && id < this.inertV.length() {
            this.inertV[id] = on
        }
    }

    pub fn setRound(id: Int, on: Bool) {
        if id >= 0 && id < this.roundV.length() {
            this.roundV[id] = on
        }
    }

    pub fn setAccent(id: Int, on: Bool) {
        if id >= 0 && id < this.accentV.length() {
            this.accentV[id] = on
        }
    }

    pub fn setTone(id: Int, t: ButtonTone) {
        if id >= 0 && id < this.toneV.length() {
            this.toneV[id] = buttonToneId(t)
        }
    }

    pub fn setRaised(id: Int, on: Bool) {
        if id >= 0 && id < this.raisedV.length() {
            this.raisedV[id] = on
        }
    }

    pub fn setElevation(id: Int, e: ElevationToken) {
        if id >= 0 && id < this.elevationV.length() {
            let level = 0
            if e == ElevationToken.level1 { level = 1 }
            if e == ElevationToken.level2 { level = 2 }
            if e == ElevationToken.level3 { level = 3 }
            if e == ElevationToken.level4 { level = 4 }
            if e == ElevationToken.level5 { level = 5 }
            this.elevationV[id] = level
        }
    }

    pub fn setGradient(id: Int, on: Bool) {
        if id >= 0 && id < this.gradientV.length() {
            this.gradientV[id] = on
        }
    }

    pub fn setTextSize(id: Int, px: Int) {
        if id >= 0 && id < this.textSizeV.length() {
            this.textSizeV[id] = px
        }
    }

    /** CSS weight for this node's text, 100 to 900. */
    pub fn setFontWeight(id: Int, weight: Int) {
        this.touch()
        if id >= 0 && id < this.fontWeightV.length() {
            let w = weight
            if w <= 0 { w = 400 }
            if w < 100 { w = 100 }
            if w > 900 { w = 900 }
            this.fontWeightV[id] = w
        }
    }

    pub fn fontWeightOf(id: Int): Int {
        if id >= 0 && id < this.fontWeightV.length() && this.fontWeightV[id] != 400 {
            return this.fontWeightV[id]
        }
        if id >= 0 && id < this.role.length() {
            return this.themeV.typeScale.styleForRole(this.role[id]).weight
        }
        return 400
    }

    pub fn setItalic(id: Int, on: Bool) {
        this.touch()
        if id >= 0 && id < this.italicV.length() {
            this.italicV[id] = on
        }
    }

    pub fn italicOf(id: Int): Bool {
        if id >= 0 && id < this.italicV.length() {
            return this.italicV[id]
        }
        return false
    }

    /** Row height as a multiplier of the font size; zero keeps normal spacing. */
    pub fn setLineHeight(id: Int, f: Float) {
        this.touch()
        if id >= 0 && id < this.lineHeightV.length() {
            let v = f
            if v < 0.0 { v = 0.0 }
            this.lineHeightV[id] = v
        }
    }

    pub fn lineHeightOf(id: Int): Float {
        if id >= 0 && id < this.lineHeightV.length() && this.lineHeightV[id] > 0.0 {
            return this.lineHeightV[id]
        }
        if id >= 0 && id < this.role.length() {
            return this.themeV.typeScale.styleForRole(this.role[id]).lineHeight
        }
        return 0.0
    }

    /** Extra advance per character, in logical pixels. */
    pub fn setLetterSpacing(id: Int, f: Float) {
        this.touch()
        if id >= 0 && id < this.letterSpacingV.length() {
            this.letterSpacingV[id] = f
        }
    }

    pub fn letterSpacingOf(id: Int): Float {
        if id >= 0 && id < this.letterSpacingV.length() && this.letterSpacingV[id] != 0.0 {
            return this.letterSpacingV[id]
        }
        if id >= 0 && id < this.role.length() {
            return this.themeV.typeScale.styleForRole(this.role[id]).tracking
        }
        return 0.0
    }

    /** True when this node or any ancestor is inert. */
    pub fn inertAt(id: Int): Bool {
        let cur = id
        while cur != -1 && cur < this.inertV.length() {
            if this.inertV[cur] {
                return true
            }
            cur = this.parent[cur]
        }
        return false
    }

    pub fn setPortal(id: Int, layer: Int) {
        if id >= 0 && id < this.portalV.length() {
            this.portalV[id] = true
            this.portalLayerV[id] = layer
        }
    }

