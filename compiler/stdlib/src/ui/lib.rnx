test fn valuesAndCheckedStatesReachTheSnapshot() {
    let t = new Tree(TextEngine.fixed())
    let b = new Build(t)
    let root = b.column()
    let size = b.slider("Text size")
    let motion = b.toggle("Reduce motion")
    root.addChild(size)
    root.addChild(motion)
    t.setValue(size, "1.2")
    t.setChecked(motion, true)
    assert(t.valueOf(size) == "1.2", "value stored")
    assert(t.isChecked(motion), "checked stored")
    let snap = t.snapshot()
    assert(snap.contains("slider Text size value=1.2"), snap)
    assert(snap.contains("toggle Reduce motion checked"), snap)
}

