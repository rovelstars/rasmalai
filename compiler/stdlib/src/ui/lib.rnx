    root.padding(0)
    let short = b.text("hi")
    short.fitContent()
    let long = b.text("alpha beta gamma delta")
    long.fitContent()
    root.addChild(short)
    root.addChild(long)
    t.endFrame()
    t.layout(root, 100)
    assert(t.w[short.id] == 16, "short text keeps its content width: " + t.w[short.id].toString())
    assert(t.w[long.id] == 100, "long text caps at the available width: " + t.w[long.id].toString())
}

test fn dividerAndProgressPaint() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.gap(0)
    let rule = b.divider()
    let bar = b.progress(0.5)
    root.addChild(rule)
    root.addChild(bar)
    t.endFrame()
    t.layout(root, 200)
    assert(t.h[rule.id] == 1, "divider is one pixel")
    assert(t.h[bar.id] == 8, "progress bar is eight pixels")
    let th = Theme.dark()
    let dl = Painter.paint(t, 200, 100, th)
    let i = 0
    let fillW = 0.0
    while i < dl.recordCount() {
        if dl.kindAt(i) == 1 && dl.colorAt(i) == th.accent {
            fillW = dl.wAt(i)
        }
        i += 1
    }
    assert(fillW == 100.0, "progress fill follows the value: " + fillW.toString())
}

class SegPick {
    let index: Int = 0
}

test fn segmentedCallsTheIndex() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let picked = new SegPick()
    let control = b.segmented(["A", "B", "C"], 0, (i: Int) => { picked.index = i })
    root.addChild(control)
    t.endFrame()
    t.layout(root, 300)
    let second = t.find(Role.radio, "B")
    assert(second != -1, "segmented options are radios")
    t.pointerDown(t.x[second] + 5, t.y[second] + 5)
    assert(picked.index == 1, "the second option reports index one: " + picked.index.toString())
}

test fn iconPaintsAClosedGlyph() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let icon = b.icon("close", 16)
    root.addChild(icon)
    t.endFrame()
    t.layout(root, 100)
    assert(t.w[icon.id] == 16, "icon is sixteen wide")
    assert(t.h[icon.id] == 16, "icon is sixteen tall")
    let d = Painter.paint(t, 100, 100, Theme.dark())
    let i = 0
    let lines = 0
    while i < d.recordCount() {
        if d.kindAt(i) == 9 {
            lines += 1
        }
        i += 1
    }
    assert(lines >= 2, "close draws two strokes")
}

test fn menuCallsTheIndex() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
