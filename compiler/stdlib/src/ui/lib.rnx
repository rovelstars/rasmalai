    }

    /**
     * Point this tree at the theme that supplies its token tables. Type tokens
     * are read during layout, so a theme swap bumps the measure version.
     */
    pub fn setTheme(th: Theme) {
        this.themeV = th
        this.touch()
    }

    pub fn theme(): Theme {
        return this.themeV
    }

    pub fn space(token: SpaceToken): Int {
        return this.themeV.space(token)
    }

    /** Dynamic type multiplier for every text role. */
    pub fn setTextScale(f: Float) {
        this.touch()
        if f > 0.0 {
            this.textScaleV = f
        }
    }

    pub fn textScale(): Float {
        return this.textScaleV
    }

    /** Device pixel ratio hint. Layout stays in logical units. */
    pub fn setDensity(d: Float) {
        if d > 0.0 {
            this.densityV = d
        }
    }

    pub fn density(): Float {
        return this.densityV
    }

    /** Convert logical units to device pixels at the current density. */
    pub fn dp(n: Int): Int {
        return Int(Float(n) * this.densityV + 0.5)
    }

    /** Screen edges owned by the system, in logical units. */
    pub fn setSafeArea(top: Int, right: Int, bottom: Int, left: Int) {
        this.safeT = top
        this.safeR = right
        this.safeB = bottom
        this.safeL = left
    }

    /** The soft-keyboard inset, added to the bottom safe area. */
    pub fn setKeyboardInset(bottom: Int) {
        this.keyboardV = bottom
    }

    pub fn safeTop(): Int { return this.safeT }
    pub fn safeRight(): Int { return this.safeR }
    pub fn safeBottom(): Int { return this.safeB }
    pub fn safeLeft(): Int { return this.safeL }
    pub fn keyboardInset(): Int { return this.keyboardV }

    pub fn setZIndex(id: Int, z: Int) {
        if id >= 0 && id < this.zV.length() {
            this.zV[id] = z
        }
    }

