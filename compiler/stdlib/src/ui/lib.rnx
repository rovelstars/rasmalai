    assert(save != -1, "menu items are list items")
    t.pointerDown(t.x[save] + 5, t.y[save] + 5)
    assert(picked.index == 1, "Save reports index one: " + picked.index.toString())
}

test fn popoverIsAbsolute() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
