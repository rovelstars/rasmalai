    assert(t.y[pop.id] == 20, "popover pins top")
    assert(t.w[pop.id] == 160, "popover keeps its width")
}

test fn toastPinsBottomRight() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let stack = b.stack()
    stack.padding(0)
    stack.fixedHeight(300)
    let toast = b.toast("Saved")
    stack.addChild(toast)
