        this.minWV[id] = c.minW
        this.maxWV[id] = c.maxW
        this.minHV[id] = c.minH
        this.maxHV[id] = c.maxH
        this.idealWV[id] = c.idealW
        this.idealHV[id] = c.idealH
        this.touch()
    }

