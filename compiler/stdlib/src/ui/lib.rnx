//! The UI core, first slice: roles, actions, the node arena, and the builder.
//!
//! Nodes live in parallel arrays addressed by an integer id, so a subtree walk
//! is index arithmetic and a snapshot is a copy. A handle carries its tree, so
//! `addChild` needs no ambient state and the block syntax has one method to
//! call. Roles and actions are stored as wire ids because an enum-typed array
//! costs more than an integer lane; the enums stay in the signatures.

pub enum Role {
    root,
    column,
    row,
    section,
    heading,
    text,
    button,
    slider,
    toggle,
    radio,
    radiogroup,
    textbox,
    dialog,
}

fn roleId(r: Role): Int {
    if r == Role.root { return 0 }
    if r == Role.column { return 1 }
    if r == Role.row { return 2 }
    if r == Role.section { return 3 }
    if r == Role.heading { return 4 }
    if r == Role.text { return 5 }
    if r == Role.button { return 6 }
    if r == Role.slider { return 7 }
    if r == Role.toggle { return 8 }
    if r == Role.radio { return 9 }
    if r == Role.radiogroup { return 10 }
    if r == Role.textbox { return 11 }
    return 12
}

fn roleName(id: Int): String {
    if id == 0 { return "root" }
    if id == 1 { return "column" }
    if id == 2 { return "row" }
    if id == 3 { return "section" }
    if id == 4 { return "heading" }
    if id == 5 { return "text" }
    if id == 6 { return "button" }
    if id == 7 { return "slider" }
    if id == 8 { return "toggle" }
    if id == 9 { return "radio" }
    if id == 10 { return "radiogroup" }
    if id == 11 { return "textbox" }
    if id == 12 { return "dialog" }
    return "unknown"
}

pub enum Action {
    tap,
    toggle,
    setValue,
    dismiss,
}

fn actionId(a: Action): Int {
    if a == Action.tap { return 1 }
    if a == Action.toggle { return 2 }
    if a == Action.setValue { return 4 }
    if a == Action.dismiss { return 8 }
    return 0
}

pub enum Key {
    enter,
    space,
    escape,
    left,
    right,
    up,
    down,
}

/**
 * A node handle. It carries the tree so `addChild` needs no ambient state, and
 * it is two words, so passing it around is free.
 */
pub struct Node {
    let tree: Tree
    let id: Int

    /** Attach a child at the end of this node's children. */
    pub fn addChild(c: Node) {
        this.tree.attach(this.id, c.id)
    }

    /** Give this node a rectangle in screen space. */
    pub fn bounds(x: Int, y: Int, w: Int, h: Int) {
        this.tree.setBounds(this.id, x, y, w, h)
    }
}

/** The arena. Ids are creation order until keyed reconciliation lands. */
pub class Tree {
    let role: Array<Int> = []
    let name: Array<String> = []
    let parent: Array<Int> = []
    let first: Array<Int> = []
    let next: Array<Int> = []
    let last: Array<Int> = []
    let count: Array<Int> = []
    let actions: Array<Int> = []
    let value: Array<String> = []
    let checked: Array<Bool> = []
    let handler: Array<Int> = []
    let handlers: Array<fn(): Void> = []
    let textHandler: Array<Int> = []
    let textHandlers: Array<fn(String): Void> = []
    let x: Array<Int> = []
    let y: Array<Int> = []
    let w: Array<Int> = []
    let h: Array<Int> = []
    let focus: Int = -1

    pub fn newNode(r: Role, n: String): Node {
        let id = this.role.length()
        this.role.push(roleId(r))
        this.name.push(n)
        this.parent.push(-1)
        this.first.push(-1)
        this.next.push(-1)
        this.last.push(-1)
        this.count.push(0)
        this.actions.push(0)
        this.value.push("")
        this.checked.push(false)
        this.handler.push(-1)
        this.textHandler.push(-1)
        this.x.push(0)
        this.y.push(0)
        this.w.push(0)
        this.h.push(0)
        return Node(tree: this, id: id)
    }

    fn interactive(r: Role, n: String, mask: Int): Node {
        let node = this.newNode(r, n)
        this.actions[node.id] = mask
        return node
    }

    /** Link a child under a parent, keeping child order. */
    pub fn attach(p: Int, c: Int) {
        if p == c || p < 0 || c < 0 || c >= this.role.length() {
            return
        }
        this.parent[c] = p
        if this.first[p] == -1 {
            this.first[p] = c
        } else {
            this.next[this.last[p]] = c
        }
        this.last[p] = c
        this.count[p] += 1
    }

    pub fn button(s: String, onTap: fn(): Void): Node {
        let node = this.interactive(Role.button, s, actionId(Action.tap))
        this.handler[node.id] = this.handlers.length()
        this.handlers.push(onTap)
        return node
    }

    pub fn buttonInert(s: String): Node {
        return this.interactive(Role.button, s, actionId(Action.tap))
    }

    /** The current value of a text field or slider, for the semantic tree. */
    pub fn setValue(n: Node, v: String) {
        this.value[n.id] = v
    }

    pub fn valueOf(n: Node): String {
        return this.value[n.id]
    }

    /** The checked state of a toggle, radio, or checkbox. */
    pub fn setChecked(n: Node, v: Bool) {
        this.checked[n.id] = v
    }

    pub fn isChecked(n: Node): Bool {
        return this.checked[n.id]
    }

    pub fn slider(s: String): Node {
        return this.interactive(Role.slider, s, actionId(Action.setValue))
    }

    pub fn toggle(s: String): Node {
        return this.interactive(Role.toggle, s, actionId(Action.toggle))
    }

    pub fn checkbox(s: String, on: Bool, onToggle: fn(): Void): Node {
        let node = this.interactive(Role.radio, s, actionId(Action.toggle))
        this.checked[node.id] = on
        this.handler[node.id] = this.handlers.length()
        this.handlers.push(onToggle)
        return node
    }

    pub fn radio(s: String, selected: Bool, onTap: fn(): Void): Node {
        let node = this.interactive(Role.radio, s, actionId(Action.tap))
        this.checked[node.id] = selected
        this.handler[node.id] = this.handlers.length()
        this.handlers.push(onTap)
        return node
    }

    pub fn textField(v: String, placeholder: String, onChange: fn(String): Void): Node {
        let node = this.newNode(Role.textbox, placeholder)
        this.actions[node.id] = actionId(Action.setValue)
        this.value[node.id] = v
        this.textHandler[node.id] = this.textHandlers.length()
        this.textHandlers.push(onChange)
        return node
    }

    /** Apply typed text and notify the field's handler. */
    pub fn setText(n: Node, v: String): Bool {
        if this.role[n.id] != roleId(Role.textbox) {
            return false
        }
        this.value[n.id] = v
        let h = this.textHandler[n.id]
        if h < 0 {
            return false
        }
        this.textHandlers[h](v)
        return true
    }

    /** Route a pointer press through the hit test to the same handler a key reaches. */
    pub fn pointerDown(x: Int, y: Int): Bool {
        let id = this.hitTest(x, y)
        if id == -1 || this.actions[id] == 0 {
            return false
        }
        return this.fire(Node(tree: this, id: id))
    }

    pub fn toggleWith(s: String, onToggle: fn(): Void): Node {
        let node = this.interactive(Role.toggle, s, actionId(Action.toggle))
        this.handler[node.id] = this.handlers.length()
        this.handlers.push(onToggle)
        return node
    }

    fn setBounds(id: Int, x: Int, y: Int, w: Int, h: Int) {
        this.x[id] = x
        this.y[id] = y
        this.w[id] = w
        this.h[id] = h
    }

    pub fn len(): Int {
        return this.role.length()
    }

    pub fn childCount(n: Node): Int {
        return this.count[n.id]
    }

    pub fn focusOn(n: Node) {
        if n.id >= 0 && n.id < this.role.length() {
            this.focus = n.id
        }
    }

    pub fn focused(): Int {
        return this.focus
    }

    pub fn can(n: Node, a: Action): Bool {
        return (this.actions[n.id] & actionId(a)) != 0
    }

    fn fire(n: Node): Bool {
        let h = this.handler[n.id]
        if h < 0 {
            return false
        }
        this.handlers[h]()
        return true
    }

    pub fn tap(n: Node): Bool {
        if (this.actions[n.id] & actionId(Action.tap)) == 0 {
            return false
        }
        return this.fire(n)
    }

    /** Activation keys reach the same handler a tap does. */
    pub fn keyDown(n: Node, k: Key): Bool {
        if k == Key.enter || k == Key.space {
            if this.actions[n.id] == 0 {
                return false
            }
            return this.fire(n)
        }
        if k == Key.escape {
            if this.role[n.id] == roleId(Role.dialog) {
                return this.fire(n)
            }
        }
        return false
    }

    pub fn focusNext(): Int {
        let seen = this.nextInteractive(this.focus + 1)
        if seen == -1 {
            seen = this.nextInteractive(0)
        }
        if seen != -1 {
            this.focus = seen
        }
        return seen
    }

    pub fn focusPrev(): Int {
        let seen = this.prevInteractive(this.focus - 1)
        if seen == -1 {
            seen = this.prevInteractive(this.role.length() - 1)
        }
        if seen != -1 {
            this.focus = seen
        }
        return seen
    }

    fn nextInteractive(start: Int): Int {
        let i = start
        while i < this.role.length() {
            if this.actions[i] != 0 {
                return i
            }
            i += 1
        }
        return -1
    }

    fn prevInteractive(start: Int): Int {
        let i = start
        while i >= 0 {
            if this.actions[i] != 0 {
                return i
            }
            i -= 1
        }
        return -1
    }

    pub fn hitTest(px: Int, py: Int): Int {
        return this.hitFrom(0, px, py)
    }

    fn hitFrom(id: Int, px: Int, py: Int): Int {
        let hit = -1
        let c = this.first[id]
        while c != -1 {
            let inner = this.hitFrom(c, px, py)
            if inner != -1 {
                hit = inner
            }
            c = this.next[c]
        }
        if hit != -1 {
            return hit
        }
        if px >= this.x[id] && py >= this.y[id] && px < this.x[id] + this.w[id] && py < this.y[id] + this.h[id] {
            return id
        }
        return -1
    }

    pub fn find(r: Role, n: String): Int {
        return this.findFrom(0, roleId(r), n)
    }

    fn findFrom(id: Int, rid: Int, n: String): Int {
        if this.role[id] == rid && this.name[id] == n {
            return id
        }
        let c = this.first[id]
        while c != -1 {
            let hit = this.findFrom(c, rid, n)
            if hit != -1 {
                return hit
            }
            c = this.next[c]
        }
        return -1
    }

    pub fn unnamedInteractive(): Int {
        return this.unnamedFrom(0)
    }

    fn unnamedFrom(id: Int): Int {
        if this.actions[id] != 0 && this.name[id] == "" {
            return id
        }
        let c = this.first[id]
        while c != -1 {
            let hit = this.unnamedFrom(c)
            if hit != -1 {
                return hit
            }
            c = this.next[c]
        }
        return -1
    }

    fn inset(r: Int): Int {
        if r == 1 { return 16 }
        if r == 3 { return 12 }
        return 0
    }

    fn gapFor(r: Int): Int {
        if r == 1 { return 8 }
        if r == 2 { return 8 }
        if r == 3 { return 8 }
        return 0
    }

    fn leafHeight(r: Int): Int {
        if r == 4 { return 30 }
        if r == 6 { return 32 }
        if r == 7 { return 32 }
        if r == 8 { return 32 }
        if r == 11 { return 32 }
        return 22
    }

    fn intrinsicWidth(id: Int): Int {
        let r = this.role[id]
        let text = this.name[id].length() * 8
        if r == 6 { return text + 28 }
        if r == 7 { return 180 }
        if r == 8 { return 180 }
        if r == 11 { return 220 }
        if r == 0 { return 0 }
        return text
    }

    fn contentWidth(id: Int, avail: Int): Int {
        let r = this.role[id]
        if r == 0 {
            return avail
        }
        if r == 1 || r == 3 {
            return avail - this.inset(r) * 2
        }
        if r == 2 {
            let n = this.count[id]
            if n == 0 { return 0 }
            return (avail - this.gapFor(r) * (n - 1)) / n
        }
        let iw = this.intrinsicWidth(id)
        if iw < avail { return iw }
        return avail
    }

    fn measure(id: Int, avail: Int) {
        let r = this.role[id]
        let width = this.contentWidth(id, avail)
        if r == 0 || r == 1 || r == 3 || r == 2 {
            let total = 0
            let children = 0
            let c = this.first[id]
            while c != -1 {
                this.measure(c, this.contentWidth(c, width))
                if r == 2 {
                    if this.h[c] > total {
                        total = this.h[c]
                    }
                } else {
                    total += this.h[c]
                    children += 1
                }
                c = this.next[c]
            }
            this.w[id] = width
            if r == 2 {
                this.h[id] = total
            } else {
                let gaps = 0
                if children > 1 {
                    gaps = this.gapFor(r) * (children - 1)
                }
                this.h[id] = total + gaps + this.inset(r) * 2
            }
        } else {
            this.w[id] = width
            this.h[id] = this.leafHeight(r)
        }
    }

    fn place(id: Int, x: Int, y: Int) {
        this.x[id] = x
        this.y[id] = y
        let r = this.role[id]
        if r == 0 || r == 1 || r == 3 || r == 2 {
            let inset = this.inset(r)
            let gap = this.gapFor(r)
            let cx = x + inset
            let cy = y + inset
            let c = this.first[id]
            while c != -1 {
                if r == 2 {
                    this.place(c, cx, cy)
                    cx += this.w[c] + gap
                } else {
                    this.place(c, cx, cy)
                    cy += this.h[c] + gap
                }
                c = this.next[c]
            }
        }
    }

    /** One measure pass and one place pass. Widths flow down, heights up. */
    pub fn layout(root: Node, width: Int) {
        this.measure(root.id, width)
        this.place(root.id, 0, 0)
    }

    /** One line per node in tree order, for snapshots and the inspector. */
    pub fn snapshot(): String {
        let out: Array<String> = []
        let id = 0
        let depth = 0
        while id != -1 {
            let pad = ""
            let i = 0
            while i < depth {
                pad = pad + "  "
                i += 1
            }
            let mark = ""
            if id == this.focus {
                mark = " *"
            }
            let extra = ""
            if this.checked[id] {
                extra = " checked"
            }
            if this.value[id] != "" {
                extra = extra + " value=" + this.value[id]
            }
            out.push(pad + roleName(this.role[id]) + " " + this.name[id] + extra + mark)
            if this.first[id] != -1 {
                id = this.first[id]
                depth += 1
            } else {
                let cur = id
                let d = depth
                while cur != 0 && this.next[cur] == -1 {
                    cur = this.parent[cur]
                    d -= 1
                }
                if cur == 0 {
                    id = -1
                } else {
                    id = this.next[cur]
                    depth = d
                }
            }
        }
        return out.join("\n")
    }
}

/** A view context. Factories create nodes; the view attaches them. */
pub class Build {
    let tree: Tree

    init(tree: Tree) {
        this.tree = tree
    }

    pub fn handle(): Tree {
        return this.tree
    }

    pub fn column(): Node {
        return this.tree.newNode(Role.column, "")
    }

    pub fn row(): Node {
        return this.tree.newNode(Role.row, "")
    }

    pub fn section(title: String): Node {
        let node = this.tree.newNode(Role.section, "")
        node.addChild(this.tree.newNode(Role.heading, title))
        return node
    }

    pub fn text(s: String): Node {
        return this.tree.newNode(Role.text, s)
    }

    pub fn heading(s: String): Node {
        return this.tree.newNode(Role.heading, s)
    }

    pub fn button(s: String, onTap: fn(): Void): Node {
        return this.tree.button(s, onTap)
    }

    pub fn buttonInert(s: String): Node {
        return this.tree.buttonInert(s)
    }

    pub fn slider(s: String): Node {
        return this.tree.slider(s)
    }

    pub fn toggle(s: String): Node {
        return this.tree.toggle(s)
    }

    pub fn toggleWith(s: String, onToggle: fn(): Void): Node {
        return this.tree.toggleWith(s, onToggle)
    }

    pub fn checkbox(s: String, on: Bool, onToggle: fn(): Void): Node {
        return this.tree.checkbox(s, on, onToggle)
    }

    pub fn radio(s: String, selected: Bool, onTap: fn(): Void): Node {
        return this.tree.radio(s, selected, onTap)
    }

    pub fn textField(v: String, placeholder: String, onChange: fn(String): Void): Node {
        return this.tree.textField(v, placeholder, onChange)
    }
}

test fn childrenKeepCreationOrder() {
    let t = new Tree()
    let b = new Build(t)
    let col = b.column()
    col.addChild(b.text("one"))
    col.addChild(b.text("two"))
    assert(t.len() == 3, "three nodes")
    assert(t.childCount(col) == 2, "two children")
    assert(t.find(Role.text, "two") == 2, "depth-first order")
}

test fn hitTestPrefersTheDeepestNode() {
    let t = new Tree()
    let b = new Build(t)
    let col = b.column()
    let btn = b.buttonInert("Save")
    col.addChild(btn)
    col.bounds(0, 0, 200, 100)
    btn.bounds(10, 10, 80, 24)
    assert(t.hitTest(20, 20) == btn.id, "inside the button")
    assert(t.hitTest(150, 90) == col.id, "inside the column only")
    assert(t.hitTest(300, 300) == -1, "outside")
}

test fn tapRunsTheAttachedHandler() {
    let t = new Tree()
    let b = new Build(t)
    let hits: Array<Int> = []
    let btn = b.button("Add", () => { hits.push(1) })
    assert(t.tap(btn), "tapped")
    assert(hits.length() == 1, "handler ran once")
}

test fn enterAndTapReachTheSameHandler() {
    let t = new Tree()
    let b = new Build(t)
    let hits: Array<Int> = []
    let btn = b.button("Add", () => { hits.push(1) })
    t.focusOn(btn)
    assert(t.keyDown(btn, Key.enter), "enter handled")
    assert(t.tap(btn), "tap handled")
    assert(hits.length() == 2, "one handler, two sources")
}

test fn focusMovesThroughInteractiveNodesOnly() {
    let t = new Tree()
    let b = new Build(t)
    let root = b.column()
    root.addChild(b.text("label"))
    let first = b.buttonInert("One")
    root.addChild(first)
    root.addChild(b.text("more"))
    let second = b.toggle("Two")
    root.addChild(second)
    assert(t.focusNext() == first.id, "skips text")
    assert(t.focusNext() == second.id, "next interactive")
    assert(t.focusNext() == first.id, "wraps")
    assert(t.focusPrev() == second.id, "backwards wraps")
}

test fn layoutStacksColumnChildren() {
    let t = new Tree()
    let b = new Build(t)
    let col = b.column()
    let first = b.buttonInert("First")
    let second = b.buttonInert("Second")
    col.addChild(first)
    col.addChild(second)
    t.layout(col, 400)
    assert(t.x[first.id] == 16, "children start at the column inset")
    assert(t.y[second.id] > t.y[first.id] + t.h[first.id], "second sits below the first")
    assert(t.hitTest(t.x[second.id] + 2, t.y[second.id] + 2) == second.id, "hit lands on the second button")
}

test fn pointerDownReachesTheSameHandlerAsEnter() {
    let t = new Tree()
    let b = new Build(t)
    let root = b.column()
    let hits: Array<Int> = []
    let btn = b.button("Save", () => { hits.push(1) })
    root.addChild(btn)
    t.layout(root, 200)
    btn.bounds(10, 10, 80, 24)
    assert(t.pointerDown(20, 20), "hit the button")
    assert(t.keyDown(btn, Key.enter), "key path")
    assert(hits.length() == 2, "one handler, two sources")
    assert(!t.pointerDown(2, 2), "outside every interactive node")
}

test fn typingReachesTheFieldHandler() {
    let t = new Tree()
    let b = new Build(t)
    let seen: Array<String> = []
    let field = b.textField("", "Search settings", (v: String) => { seen.push(v) })
    assert(t.setText(field, "theme"), "handled")
    assert(t.valueOf(field) == "theme", "value stored")
    assert(seen.length() == 1, "handler ran once")
}

test fn valuesAndCheckedStatesReachTheSnapshot() {
    let t = new Tree()
    let b = new Build(t)
    let root = b.column()
    let size = b.slider("Text size")
    let motion = b.toggle("Reduce motion")
    root.addChild(size)
    root.addChild(motion)
    t.setValue(size, "1.2")
    t.setChecked(motion, true)
    assert(t.valueOf(size) == "1.2", "value stored")
    assert(t.isChecked(motion), "checked stored")
    let snap = t.snapshot()
    assert(snap.contains("slider Text size value=1.2"), snap)
    assert(snap.contains("toggle Reduce motion checked"), snap)
}

test fn everyInteractiveNodeHasAName() {
    let t = new Tree()
    let b = new Build(t)
    b.slider("Text size")
    b.toggle("Reduce motion")
    b.buttonInert("Reset")
    assert(t.unnamedInteractive() == -1, "all named")
}
