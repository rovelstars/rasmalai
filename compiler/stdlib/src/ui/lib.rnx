    pub fn setInvalid(id: Int, n: Int) {
        if id >= 0 && id < this.invalidV.length() {
            let v = n
            if v < 0 { v = 0 }
            if v > 3 { v = 3 }
            this.invalidV[id] = v
        }
    }

    pub fn setLevel(id: Int, n: Int) {
        if id >= 0 && id < this.levelV.length() {
            let v = n
            if v < 0 { v = 0 }
            this.levelV[id] = v
        }
    }

    pub fn setLive(id: Int, n: Int) {
        if id >= 0 && id < this.liveV.length() {
            let v = n
            if v < 0 { v = 0 }
            if v > 2 { v = 2 }
            this.liveV[id] = v
        }
    }

