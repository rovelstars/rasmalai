    t.layout(stack, 400)
    assert(t.x[toast.id] == 144, "toast pins right: " + t.x[toast.id].toString())
    assert(t.y[toast.id] + t.h[toast.id] + 16 == 300, "toast pins bottom: " + t.y[toast.id].toString())
}

test fn tooltipPaintsOnHover() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let button = b.button("Save", () => {})
    button.tooltip("Store the file")
    root.addChild(button)
    t.endFrame()
    t.layout(root, 200)
    let before = Painter.paint(t, 200, 100, Theme.dark()).recordCount()
    t.pointerMove(t.x[button.id] + 5, t.y[button.id] + 5)
    let after = Painter.paint(t, 200, 100, Theme.dark()).recordCount()
    assert(after > before, "hover adds the tooltip records")
    t.pointerLeave()
    let off = Painter.paint(t, 200, 100, Theme.dark()).recordCount()
    assert(off == before, "leaving removes the tooltip")
}

test fn scopeRestoresPreviousFocus() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let opener = b.button("Open", () => {})
    let dialog = b.dialog("About")
    let close = b.button("Close", () => {})
    dialog.addChild(close)
    root.addChild(opener)
    root.addChild(dialog)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(opener)
    assert(t.focused() == opener.id, "opener starts focused")
    t.focusScope(dialog)
    t.focusOn(close)
    assert(t.focused() == close.id, "focus moves into the dialog")
    t.clearFocusScope()
    assert(t.focused() == opener.id, "focus returns to the opener")
    t.clearFocusScope()
    assert(t.focused() == opener.id, "a second clear does not steal focus")
}

test fn shortcutScopesShadowGlobals() {
    let sh = new Shortcuts()
    let state = new SegPick()
    sh.bind("ctrl+k", () => { state.index = 1 })
    assert(sh.run("ctrl+k"), "global chord runs")
    assert(state.index == 1, "global handler ran")
    let scope = sh.pushScope()
    sh.bindScoped(scope, "ctrl+k", () => { state.index = 2 })
    assert(sh.run("ctrl+k"), "scoped chord runs")
    assert(state.index == 2, "scoped handler shadows the global one")
    sh.popScope()
    assert(sh.run("ctrl+k"), "global chord runs again")
    assert(state.index == 1, "global handler is restored")
}

test fn clipboardSelectionRoundTrips() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let field = b.textField("hello", "name", (v: String) => {})
    root.addChild(field)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(field)
    t.selectAllText(field)
    assert(t.selectedText(field) == "hello", "selection reads back")
    assert(t.replaceSelection(field, "world"), "selection is replaced")
    assert(t.valueOf(field) == "world", "value follows the replacement")
}

test fn imePreeditShowsAndCommitInserts() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let field = b.textField("ab", "name", (v: String) => {})
    root.addChild(field)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(field)
    t.setPreedit(field, "に")
    assert(t.preeditOf(field) == "に", "preedit is stored")
    assert(t.valueOf(field) == "ab", "preedit is not committed")
    let d = Painter.paint(t, 300, 120, Theme.dark())
    let text = Display.textOf(d.finish(300, 120))
    assert(text.contains("に"), "preedit is painted: " + text)
    t.typeText(field, "に")
    t.clearPreedit(field)
    assert(t.valueOf(field) == "abに", "commit inserts the text: " + t.valueOf(field))
    assert(t.preeditOf(field) == "", "commit clears the preedit")
}

test fn imeDeletesSurroundingText() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    let field = b.textField("abcd", "name", (v: String) => {})
    root.addChild(field)
    t.endFrame()
    t.layout(root, 300)
    t.focusOn(field)
    t.keyDown(field, Key.left)
    t.keyDown(field, Key.left)
    assert(t.caretX(field) > 0, "caret offset is measured")
    assert(t.deleteSurrounding(field, 1, 1), "delete surrounding reports a change")
    assert(t.valueOf(field) == "ad", "surrounding text is removed: " + t.valueOf(field))
}

test fn framePacketCarriesLayoutAndSemantics() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.addChild(b.heading("Frame"))
    let button = b.button("Add", () => {})
    root.addChild(button)
    root.addChild(b.textField("hi", "name", (v: String) => {}))
    t.endFrame()
    t.layout(root, 320)
    let data = FramePacket.encode(t, 320, 240, 2000, 1)
    let packet = FramePacket.decode(data)
    assert(packet.width == 320, "packet width")
    assert(packet.height == 240, "packet height")
    assert(packet.scale == 2000, "packet scale is 2x")
    assert(packet.color == 1, "packet color space")
    assert(packet.count() > 0, "packet has nodes")
    let i = 0
    let saw = false
    while i < packet.count() {
        let n = packet.at(i)
        if n.name == "Add" {
            saw = true
            assert(n.roleId == 6, "packet role")
            assert(n.actions == 1, "packet actions")
            assert(n.x == t.x[button.id], "packet bounds")
        }
        i += 1
    }
    assert(saw, "packet carries the button")
    let one = FramePacket.decode(FramePacket.encode(t, 320, 240, 1000, 0))
    assert(one.scale == 1000 && one.width == 320, "1x packet tags scale")
}

test fn cameraTransformsAndInverts() {
    let cam = new Camera(2.0, 10.0, 20.0)
    assert(cam.screenX(5.0) == 20.0, "world x maps to screen")
    assert(cam.screenY(5.0) == 30.0, "world y maps to screen")
    assert(cam.worldX(20.0) == 5.0, "screen x maps back")
    assert(cam.worldY(30.0) == 5.0, "screen y maps back")
    let wx = cam.worldX(10.0)
    let wy = cam.worldY(10.0)
    cam.zoomAt(10.0, 10.0, 2.0)
    assert(cam.screenX(wx) == 10.0, "zoom keeps the anchor fixed in x")
    assert(cam.screenY(wy) == 10.0, "zoom keeps the anchor fixed in y")
    assert(cam.scale() == 4.0, "zoom multiplies the scale")
    cam.panBy(5.0, 0.0)
    assert(cam.x() == 15.0, "pan moves the origin")
}

test fn cameraPaintAndHitTest() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let button = b.button("Zoom", () => {})
    button.fixedWidth(80)
    button.fixedHeight(30)
    root.addChild(button)
    t.endFrame()
    t.layout(root, 200)
    let cam = new Camera(2.0, 0.0, 0.0)
    let d = Painter.paintCamera(t, 400, 200, Theme.dark(), cam)
    let sawTransform = false
    let i = 0
    while i < d.recordCount() {
        if d.kindAt(i) == 7 {
            sawTransform = true
        }
        i += 1
    }
    assert(sawTransform, "camera paints a transform")
    assert(t.hitTestCamera(60.0, 20.0, cam) == button.id, "hit test applies the inverse")
    assert(t.hitTest(150, 10) == root.id, "untransformed hit test misses the button")
}

test fn portalsPaintAboveTheTree() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.stack()
    root.padding(0)
    root.fixedHeight(120)
    let base = b.text("base")
    base.fixedWidth(200)
    base.fixedHeight(120)
    let layer = b.stack()
    layer.fixedWidth(200)
    layer.fixedHeight(120)
    let card = b.button("Card", () => {})
    card.fixedWidth(100)
    card.fixedHeight(40)
    card.absolute()
    card.left(20)
    card.top(20)
    card.portal(root)
    root.addChild(layer)
    root.addChild(base)
    root.addChild(card)
    t.endFrame()
    t.layout(root, 200)
    let d = Painter.paint(t, 200, 120, Theme.dark())
    let last = d.kindAt(d.recordCount() - 1)
    assert(t.hitTest(40, 30) == card.id, "a portal wins hit testing")
    assert(t.parent[card.id] == root.id, "the logical parent stays")
    assert(last != 8, "portal records paint after the tree")
}

test fn springSettlesAndKeepsVelocity() {
    let s = new Spring(200.0, 20.0, 0.0)
    s.setTarget(10.0)
    let t = 0.0
    while t < 2.0 {
        s.step(1.0 / 60.0)
        t += 1.0 / 60.0
    }
    assert(s.settled(), "spring settles")
    assert(s.value() == 10.0, "spring reaches the target")
    s.setTarget(0.0)
    s.step(1.0 / 60.0)
    let moving = s.velocity()
    s.retarget(10.0)
    assert(s.velocity() == moving, "retarget keeps velocity")
    s.interrupt()
    assert(s.velocity() == 0.0, "interrupt holds the present value")
}

test fn sheetPicksADetent() {
    let sh = Sheet.of([40.0, 300.0, 600.0], 1)
    assert(sh.height() == 300.0, "sheet starts at its detent")
    sh.dragBy(40.0)
    assert(sh.height() == 340.0, "drag moves the sheet")
    sh.release(0.0)
    assert(sh.index() == 1, "slow release snaps to the nearest detent")
    sh.release(1200.0)
    assert(sh.index() == 2, "fast fling moves up one detent")
    sh.release(0.0 - 1200.0)
    assert(sh.index() == 1, "fast fling moves down one detent")
    sh.dragBy(9999.0)
    assert(sh.height() == 600.0, "drag clamps at the largest detent")
    sh.dragBy(0.0 - 9999.0)
    assert(sh.height() == 40.0, "drag clamps at the smallest detent")
}

test fn matchedGeometryInterpolates() {
    let m = new Match(0.0, 0.0, 100.0, 50.0, 200.0, 100.0, 300.0, 150.0)
    assert(m.progress() == 0.0, "match starts at the source")
    assert(m.x() == 0.0 && m.w() == 100.0, "source rect")
    m.open()
    let t = 0.0
    while t < 2.0 && !m.done() {
        m.step(1.0 / 60.0)
        t += 1.0 / 60.0
    }
    assert(m.done(), "match settles")
    assert(m.x() == 200.0 && m.w() == 300.0, "match reaches the target")
    m.close()
    m.step(1.0 / 60.0)
    let p = m.progress()
    assert(p < 1.0, "close starts back toward the source")
}

test fn ambientLifecycleThrottles() {
    let a = new Ambient()
    assert(a.state() == "live", "ambient starts live")
    assert(a.advance(10.0) == 10.0, "live passes the delta")
    a.setCovered(true)
    assert(a.state() == "throttled", "covered throttles")
    assert(a.advance(10.0) == 2.5, "throttled quarter rate")
    a.freeze(true)
    assert(a.state() == "frozen", "freeze wins")
    assert(a.advance(10.0) == 0.0, "frozen passes nothing")
    a.freeze(false)
    a.setVisible(false)
    assert(a.advance(10.0) == 0.0, "hidden freezes")
}

test fn gestureArenaArbitratesByAxis() {
    let arena = new GestureArena()
    let h = arena.add(GestureAxis.horizontal, 10, 2, 100)
    let v = arena.add(GestureAxis.vertical, 10, 2, 200)
    assert(arena.size() == 2, "arena tracks claims")
    assert(arena.begin(GestureAxis.horizontal) == 100, "horizontal claim wins its axis")
    assert(arena.lastDecision().contains("claim 100"), "decision is traced")
    arena.release()
    assert(arena.begin(GestureAxis.vertical) == 200, "vertical claim wins after release")
    arena.release()
    assert(arena.begin(GestureAxis.none) == -1, "no axis means no winner")
}

test fn gestureArenaPrefersPriorityThenDepth() {
    let arena = new GestureArena()
    arena.add(GestureAxis.vertical, 5, 9, 10)
    arena.add(GestureAxis.vertical, 9, 1, 20)
    assert(arena.begin(GestureAxis.vertical) == 20, "priority beats depth")
    arena.release()
    arena.clear()
    arena.add(GestureAxis.vertical, 5, 1, 30)
    arena.add(GestureAxis.vertical, 5, 4, 40)
    assert(arena.begin(GestureAxis.vertical) == 40, "equal priority resolves by depth")
    arena.release()
    arena.clear()
    arena.add(GestureAxis.vertical, 5, 2, 50)
    arena.add(GestureAxis.both, 5, 2, 60)
    assert(arena.begin(GestureAxis.vertical) == 60, "later claim breaks a full tie")
}

test fn gestureClaimIsStickyUntilRelease() {
    let arena = new GestureArena()
    arena.add(GestureAxis.horizontal, 10, 1, 1)
    arena.add(GestureAxis.vertical, 99, 5, 2)
    assert(arena.begin(GestureAxis.horizontal) == 1, "first claim wins")
    assert(arena.begin(GestureAxis.vertical) == 1, "an active claim is not stolen")
    assert(arena.lastDecision().contains("sticky"), "sticky decision is traced")
    arena.release()
    assert(arena.begin(GestureAxis.vertical) == 2, "release allows the other claim")
}

test fn stageRaisesAndLowersTheSheet() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.stack()
    root.padding(0)
    root.fixedHeight(400)
    let content = b.column()
    content.padding(0)
    let pageButton = b.button("Page", () => {})
    pageButton.fixedWidth(100)
    pageButton.fixedHeight(32)
    content.addChild(pageButton)
    content.addChild(b.text("background"))
    let overlay = b.stack()
    overlay.padding(0)
    overlay.fixedHeight(200)
    let close = b.button("Close", () => {})
    close.fixedWidth(100)
    close.fixedHeight(32)
    overlay.addChild(close)
    root.addChild(content)
    root.addChild(overlay)
    t.endFrame()
    t.layout(root, 400)
    t.focusOn(pageButton)
    let ambient = new Ambient()
    let sheet = Sheet.of([100.0, 300.0], 0)
    let stage = Stage.of(t, content, overlay, ambient, sheet)
    stage.present(close)
    assert(stage.isOpen(), "stage reports open")
    assert(stage.occludes(), "an open sheet occludes the ambient layer")
    assert(ambient.state() == "throttled", "ambient throttles under the sheet")
    assert(t.focused() == close.id, "focus moves into the overlay")
    assert(t.inertAt(pageButton.id), "background is inert")
    assert(t.hitTest(t.x[pageButton.id] + 2, t.y[pageButton.id] + 2) != pageButton.id, "inert content ignores hits")
    assert(!t.tap(Node(tree: t, id: pageButton.id)), "inert content ignores direct taps")
    assert(t.focusNext() == close.id, "traversal stays in the overlay")
    stage.dismiss()
    assert(!stage.occludes(), "dismissing stops occlusion")
    assert(ambient.state() == "live", "ambient resumes")
    assert(!t.inertAt(pageButton.id), "content is live again")
    assert(t.focused() == pageButton.id, "focus restores to the opener")
}

test fn imageCarriesBytesAndSize() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let png = ByteBuffer.fromArray([137, 80, 78, 71, 13, 10, 26, 10])
    let pic = b.image(png, 120, 80)
    root.addChild(pic)
    t.endFrame()
    t.layout(root, 300)
    assert(t.roleNameOf(pic.id) == "image", "image role")
    assert(t.w[pic.id] == 120 && t.h[pic.id] == 80, "image keeps its size")
    let d = Painter.paint(t, 300, 120, Theme.dark())
    let i = 0
    let found = false
    while i < d.recordCount() {
        if d.kindAt(i) == 6 {
            found = true
            assert(d.wAt(i) == 120.0 && d.hAt(i) == 80.0, "image record uses the node size")
        }
        i += 1
    }
    assert(found, "image paints an image record")
    let empty = b.image(ByteBuffer.allocate(0), 20, 20)
    root.addChild(empty)
    root.addChild(b.text("after"))
    t.endFrame()
    t.layout(root, 300)
    let d2 = Painter.paint(t, 300, 200, Theme.dark())
    let i2 = 0
    let fills = 0
    while i2 < d2.recordCount() {
        if d2.kindAt(i2) == 1 && d2.wAt(i2) == 20.0 && d2.hAt(i2) == 20.0 {
            fills += 1
        }
        i2 += 1
    }
    assert(fills >= 1, "an empty image paints a placeholder")
}

test fn zIndexReordersSiblings() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let stack = b.stack()
    stack.padding(0)
    let top = b.text("top")
    top.fixedWidth(100)
    top.fixedHeight(40)
    top.zIndex(5)
    let middle = b.text("middle")
    middle.fixedWidth(100)
    middle.fixedHeight(40)
    middle.zIndex(1)
    let bottom = b.text("bottom")
    bottom.fixedWidth(100)
    bottom.fixedHeight(40)
    bottom.zIndex(0)
    stack.addChild(top)
    stack.addChild(middle)
    stack.addChild(bottom)
    t.endFrame()
    t.layout(stack, 200)
    assert(t.first[stack.id] == bottom.id, "lowest z paints first")
    assert(t.next[bottom.id] == middle.id, "middle z follows")
    assert(t.next[middle.id] == top.id, "highest z paints last")
    assert(t.hitTest(10, 10) == top.id, "highest z wins hit testing")
    top.zIndex(-1)
    t.endFrame()
    t.layout(stack, 200)
    assert(t.first[stack.id] == top.id, "a lower z paints first at the next layout")
    assert(t.hitTest(10, 10) == middle.id, "the new top z wins hit testing")
}

test fn percentGapResolvesAgainstWidth() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    row.padding(0)
    row.gapPercent(10.0)
    let a = b.text("a")
    a.fixedWidth(40)
    a.fixedHeight(20)
    let c = b.text("c")
    c.fixedWidth(40)
    c.fixedHeight(20)
    row.addChild(a)
    row.addChild(c)
    t.endFrame()
    t.layout(row, 200)
    assert(t.x[a.id] == 0, "first child at the left")
    assert(t.x[c.id] == 60, "ten percent of 200 is a 20px gap: " + t.x[c.id].toString())
}

test fn autoMarginAbsorbsFreeSpace() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    row.padding(0)
    row.gap(0)
    row.fixedWidth(200)
    let left = b.text("left")
    left.fixedWidth(40)
    left.fixedHeight(20)
    let right = b.text("right")
    right.fixedWidth(40)
    right.fixedHeight(20)
    right.autoMargin()
    row.addChild(left)
    row.addChild(right)
    let col = b.column()
    col.padding(0)
    col.gap(0)
    col.fixedWidth(100)
    col.fixedHeight(200)
    let top = b.text("top")
    top.fixedWidth(40)
    top.fixedHeight(20)
    let bottom = b.text("bottom")
    bottom.fixedWidth(40)
    bottom.fixedHeight(20)
    bottom.autoMargin()
    col.addChild(top)
    col.addChild(bottom)
    t.endFrame()
    t.layout(row, 200)
    t.layout(col, 100)
    assert(t.x[right.id] == 100, "auto margin centers the free space on a row: " + t.x[right.id].toString())
    assert(t.y[bottom.id] == 100, "auto margin pushes to the middle of a column: " + t.y[bottom.id].toString())
}

test fn rtlMirrorsRowOrder() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let row = b.row()
    row.padding(0)
    row.gap(0)
    row.rtl()
    let first = b.text("first")
    first.fixedWidth(40)
    first.fixedHeight(20)
    let second = b.text("second")
    second.fixedWidth(40)
    second.fixedHeight(20)
    row.addChild(first)
    row.addChild(second)
    t.endFrame()
    t.layout(row, 200)
    assert(t.x[first.id] == 160, "first child sits at the right: " + t.x[first.id].toString())
    assert(t.x[second.id] == 120, "second child follows to the left: " + t.x[second.id].toString())
}

test fn safeAreaAndKeyboardInsetShrinkTheRoot() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let child = b.button("Go", () => {})
    child.fixedWidth(80)
    child.fixedHeight(30)
    root.addChild(child)
    t.endFrame()
    t.setSafeArea(10, 20, 30, 40)
    t.setKeyboardInset(50)
    t.layoutIn(root, 400, 300)
    assert(t.x[root.id] == 40, "root starts after the left inset: " + t.x[root.id].toString())
    assert(t.y[root.id] == 10, "root starts after the top inset")
    assert(t.w[root.id] == 340, "root width loses left and right: " + t.w[root.id].toString())
    assert(t.h[root.id] == 210, "root height loses safe areas and keyboard: " + t.h[root.id].toString())
    t.setKeyboardInset(0)
    t.setSafeArea(0, 0, 0, 0)
    t.layoutIn(root, 400, 300)
    assert(t.x[root.id] == 0 && t.w[root.id] == 400, "clearing insets restores the root")
}

test fn dynamicTypeScalesTextMetrics() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let label = b.text("hello")
    root.addChild(label)
    t.endFrame()
    t.layout(root, 400)
    let baseW = t.intrinsicWidth(label.id)
    let baseH = t.h[label.id]
    t.setTextScale(2.0)
    t.layout(root, 400)
    assert(t.intrinsicWidth(label.id) > baseW, "wider text at 2x: " + t.intrinsicWidth(label.id).toString())
    assert(t.h[label.id] > baseH, "taller text at 2x: " + t.h[label.id].toString())
    t.setTextScale(1.0)
    t.layout(root, 400)
    assert(t.intrinsicWidth(label.id) == baseW && t.h[label.id] == baseH, "scale returns metrics")
}

test fn boldTextMeasuresWiderThanRegular() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let regular = b.text("Weight sample")
    let bold = b.text("Weight sample")
    bold.fontWeight(700)
    root.addChild(regular)
    root.addChild(bold)
    t.endFrame()
    t.layout(root, 400)
    assert(t.intrinsicWidth(bold.id) > t.intrinsicWidth(regular.id),
        "bold " + t.intrinsicWidth(bold.id).toString() + " vs regular " + t.intrinsicWidth(regular.id).toString())
}

test fn trackingIncreasesMeasuredWidth() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let plain = b.text("Tracking sample")
    let tracked = b.text("Tracking sample")
    tracked.letterSpacing(2.0)
    root.addChild(plain)
    root.addChild(tracked)
    t.endFrame()
    t.layout(root, 400)
    assert(t.intrinsicWidth(tracked.id) > t.intrinsicWidth(plain.id),
        "tracked " + t.intrinsicWidth(tracked.id).toString() + " vs plain " + t.intrinsicWidth(plain.id).toString())
}

test fn lineHeightIncreasesRowHeight() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    let text = "Wrapped paragraph with enough words to span more than one line inside a narrow column."
    let plain = b.text(text)
    let tall = b.text(text)
    tall.lineHeight(1.9)
    root.addChild(plain)
    root.addChild(tall)
    t.endFrame()
    t.layout(root, 160)
    assert(t.textLayoutV[plain.id].rows.length() > 1, "the sample wraps")
    assert(t.h[tall.id] > t.h[plain.id],
        "tall " + t.h[tall.id].toString() + " vs plain " + t.h[plain.id].toString())
}

test fn textRunCarriesStyleLanes() {
    let d = DisplayList.create(4)
    d.textRun(0, 0.0, 0.0, 12.0, "plain")
    d.textRun(0, 0.0, 0.0, 12.0, "styled", 700, true, 2.0)
    assert(d.eAt(0) == 400.0 && d.fAt(0) == 0.0, "unset style keeps weight 400 without tracking")
    assert(d.eAt(1) == 10700.0, "italic adds 10000 to the weight lane: " + d.eAt(1).toString())
    assert(d.fAt(1) == 2.0, "tracking rides the f lane")
}

test fn fontRegistryAssignsIdsAndCaps() {
    let reg = new FontRegistry()
    let tiny = ByteBuffer.fromArray([1, 2, 3, 4])
    let first = reg.register("First", tiny)
    assert(first != null, "first face registers")
    if first != null {
        assert(first.id == 100, "ids start at 100: " + first.id.toString())
        assert(first.name == "First" && first.data.length() == 4, "face keeps its name and data")
    }
    assert(reg.register("", tiny) == null, "empty name is rejected")
    assert(reg.register("Empty", ByteBuffer.allocate(0)) == null, "empty data is rejected")
    let i = reg.len()
    while i < 16 {
        assert(reg.register("Face" + i.toString(), tiny) != null, "face " + i.toString() + " registers")
        i += 1
    }
    assert(reg.len() == 16, "sixteen faces fit: " + reg.len().toString())
    let last = reg.at(15)
    if last != null {
        assert(last.id == 115, "last id is 115: " + last.id.toString())
    }
    assert(reg.register("Over", tiny) == null, "a seventeenth face is rejected")
    assert(reg.at(16) == null, "out-of-range lookup returns null")
    assert(reg.find("First") != null, "find walks the registry")
    assert(reg.find("Missing") == null, "unknown names return null")
}

test fn fontRegistryCapsFontBytes() {
    let reg = new FontRegistry()
    let half = ByteBuffer.allocate(4194304)
    assert(reg.register("One", half) != null, "first 4 MB block fits")
    assert(reg.register("Two", half) != null, "second 4 MB block fits")
    assert(reg.bytes() == 8388608, "the registry reaches the byte cap: " + reg.bytes().toString())
    assert(reg.register("Three", ByteBuffer.fromArray([1])) == null, "one byte past 8 MB is rejected")
    assert(reg.len() == 2, "the rejected face is not stored")
}

test fn namedFaceReachesTextRecord() {
    let face = new FontFace(100, "Named", ByteBuffer.fromArray([9, 8, 7]))
    let d = DisplayList.create(4)
    d.textRun(0, 0.0, 0.0, 12.0, "plain")
    d.textRun(0, 0.0, 0.0, 12.0, "named", 600, false, 0.0, FontFamily.sans, face)
    assert(d.eAt(0) == 400.0, "generic run keeps the family lane")
    assert(d.eAt(1) == 100000600.0, "named face packs its id and weight: " + d.eAt(1).toString())
    assert(d.fontCount() == 1, "the frame stores the used face")
    d.textRun(0, 0.0, 0.0, 12.0, "again", 600, false, 0.0, FontFamily.sans, face)
    assert(d.fontCount() == 1, "the frame stores each face id once")

    let stray = new FontFace(7, "Stray", ByteBuffer.fromArray([1]))
    let low = DisplayList.create(4)
    low.textRun(0, 0.0, 0.0, 12.0, "stray", 400, false, 0.0, FontFamily.serif, stray)
    assert(low.eAt(0) == 1000400.0, "an id below 100 falls back to the generic family")
    assert(low.fontCount() == 0, "a rejected face stays out of the table")

    let high = new FontFace(200, "High", ByteBuffer.fromArray([1]))
    let over = DisplayList.create(4)
    over.textRun(0, 0.0, 0.0, 12.0, "high", 400, false, 0.0, FontFamily.mono, high)
    assert(over.eAt(0) == 2000400.0, "an id past the cap falls back to the generic family")
    assert(over.fontCount() == 0, "an out-of-cap face stays out of the table")
}

test fn fontTableCarriesNameOnly() {
    let face = new FontFace(100, "Named", ByteBuffer.fromArray([9, 8, 7]))
    let d = DisplayList.create(4)
    d.textRun(0, 0.0, 0.0, 12.0, "named", 400, false, 0.0, FontFamily.sans, face)
    let table = d.fontTable()
    let tableLen = 12 + 8 + 5
    assert(table.length() == tableLen, "table length: " + table.length().toString())
    assert(d.fontTableLength() == tableLen, "length helper agrees")
    assert(table.readUInt32LE(0) == 0x464E5432, "font table magic")
    assert(table.readUInt32LE(4) == tableLen, "table length field")
    assert(table.readUInt32LE(8) == 1, "one face")
    assert(table.readUInt32LE(12) == 100, "face id")
    assert(table.readUInt32LE(16) == 5, "name length")
    assert(table.readString(20, 5) == "Named", "name bytes")
    assert(tableLen == 12 + 8 + 5, "the table holds only the header plus id and name")

    let out = d.finish(40, 30)
    let blobAt = out.readUInt32LE(16)
    assert(out.readUInt32LE(20) == tableLen + 5, "blob bytes include the table")
    assert(out.readUInt32LE(blobAt) == 0x464E5432, "the encoded blob starts with the font table")
    let a = out.readUInt32LE(32 + 8)
    assert(a == tableLen, "text offset is shifted past the table: " + a.toString())
    assert(out.readString(blobAt + a, 5) == "named", "shifted text offset still finds the run")
    assert(out.readString(blobAt + tableLen, 5) == "named", "the run follows the table with no font bytes")
}

test fn fontTableShiftsEveryBlobOffsetKind() {
    let face = new FontFace(100, "Named", ByteBuffer.fromArray([9, 8, 7]))
    let d = DisplayList.create(8)
    d.textRun(0, 0.0, 0.0, 12.0, "named", 400, false, 0.0, FontFamily.sans, face)
    d.image(0.0, 0.0, 4.0, 4.0, ByteBuffer.fromArray([1, 2, 3]))
    d.polygon(0, [0.0, 0.0, 1.0, 1.0, 2.0, 0.0])
    let path = new Path()
    path.moveTo(0.0, 0.0)
    path.lineTo(4.0, 4.0)
    d.pathFill(path, 0)
    d.pathStroke(path, 0, 1.0)
    let stops: Array<GradientStop> = [
        new GradientStop(0.0, 0x000000FF),
        new GradientStop(1.0, 0xFFFFFFFF),
    ]
    d.gradientRect(stops, 0, 0.0, 0.0, 0.0, 12.0, 12.0)
    let tableLen = d.fontTableLength()
    assert(tableLen > 0, "the named face makes a table")
    let out = d.finish(60, 60)
    assert(d.recordCount() == 6, "six blob-offset records")
    let i = 0
    while i < d.recordCount() {
        let kind = d.kindAt(i)
        let shifted = out.readUInt32LE(32 + i * 64 + 8)
        assert(shifted == d.aAt(i) + tableLen,
            "kind " + kind.toString() + " offset " + d.aAt(i).toString() + " shifts to " + shifted.toString())
        i += 1
    }
}

test fn genericFontsKeepTheBlobUnshifted() {
    let d = DisplayList.create(4)
    d.textRun(0, 0.0, 0.0, 12.0, "plain", 400, false, 0.0, FontFamily.serif)
    assert(d.fontCount() == 0 && d.fontTableLength() == 0, "generic families need no table")
    let out = d.finish(20, 20)
    let blobAt = out.readUInt32LE(16)
    assert(blobAt == 32 + 64, "blob starts after the records")
    assert(out.readUInt32LE(20) == 5, "blob length is the text alone")
    assert(out.readUInt32LE(32 + 8) == 0, "the text offset stays at zero")
    assert(out.readUInt32LE(blobAt) != 0x464E5432, "no font table magic")
    assert(out.readString(blobAt, 5) == "plain", "plain text sits at the blob start")
}

test fn painterPassesTheNamedFace() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let face = new FontFace(100, "Named", ByteBuffer.fromArray([9, 8, 7]))
    let spans: Array<TextSpan> = [
        new TextSpan(0, 5, 600, false, 0.0, -1, FontFamily.sans, TextDecoration.none, face),
    ]
    let root = View.mount(t, RichText("named plain", spans))
    t.endFrame()
    t.layout(root, 400)
    let d = Painter.paint(t, 400, 80, Theme.dark())
    let named = false
    let i = 0
    while i < d.recordCount() {
        if d.kindAt(i) == 2 && d.textAt(i) == "named" {
            named = true
            assert(d.eAt(i) == 100000600.0, "painter packs the face id: " + d.eAt(i).toString())
        }
        i += 1
    }
    assert(named, "the named span paints its own run")
    assert(d.fontCount() == 1, "the painter records the face")
    let out = d.finish(400, 80)
    assert(out.readUInt32LE(out.readUInt32LE(16)) == 0x464E5432, "the painted frame carries the table")
}

test fn viewTextStyleReachesNodeLanes() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let styled = Text("Styled")
    styled.fontWeight = 700
    styled.italic = true
    styled.lineHeight = 1.5
    styled.letterSpacing = 1.25
    let root = View.mount(t, styled)
    t.endFrame()
    assert(t.fontWeightV[root.id] == 700, "weight lane")
    assert(t.italicV[root.id], "italic lane")
    assert(t.lineHeightV[root.id] == 1.5, "line height lane")
    assert(t.letterSpacingV[root.id] == 1.25, "letter spacing lane")
}

test fn painterCarriesTextStyleLanes() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let styled = Text("Styled")
