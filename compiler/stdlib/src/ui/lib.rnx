//! The UI core, first slice: roles, actions, the node arena, and the builder.
//!
//! Nodes live in parallel arrays addressed by an integer id, so a subtree walk
//! is index arithmetic and a snapshot is a copy. A handle carries its tree, so
//! `addChild` needs no ambient state and the block syntax has one method to
//! call. Roles and actions are stored as wire ids because an enum-typed array
//! costs more than an integer lane; the enums stay in the signatures.
//!
//! The state slice adds an explicit reactive graph. Signals, computeds, and
//! effects register with the `Reactive` context that created them; there is no
//! process-global observer. Ids are dense and dependency lists stay sorted, so
//! a drain walks integer lanes instead of hash tables.

import { ByteBuffer } from "@std/bytes"
import { Math } from "@std/math"

/** How a bitmap fills its view box. */
pub enum ImageFit {
    fill,
    contain,
    cover,
    scaleDown,
    none,
}

fn imageFitId(f: ImageFit): Int {
    if f == ImageFit.contain { return 1 }
    if f == ImageFit.cover { return 2 }
    if f == ImageFit.scaleDown { return 3 }
    if f == ImageFit.none { return 4 }
    return 0
}

fn imageFitAt(id: Int): ImageFit {
    if id == 1 { return ImageFit.contain }
    if id == 2 { return ImageFit.cover }
    if id == 3 { return ImageFit.scaleDown }
    if id == 4 { return ImageFit.none }
    return ImageFit.fill
}

/** A bitmap's intrinsic dimensions, read from its format header. */
pub class ImageSize {
    let width: Int
    let height: Int

    init(width: Int, height: Int) {
        this.width = width
        this.height = height
    }
}

/** A destination rectangle for a fitted bitmap, relative to its view box. */
pub struct ImageRect {
    let x: Float
    let y: Float
    let w: Float
    let h: Float
}

/**
 * Read the intrinsic size from PNG bytes. Only the signature and the IHDR
 * chunk are inspected, so this stays allocation-free and never decodes.
 * Invalid or short input returns 0x0.
 */
fn pngSize(data: ByteBuffer): ImageSize {
    if data.length() < 24 {
        return new ImageSize(0, 0)
    }
    if data.readUInt8(0) != 137 || data.readUInt8(1) != 80 || data.readUInt8(2) != 78 || data.readUInt8(3) != 71 {
        return new ImageSize(0, 0)
    }
    if data.readUInt8(4) != 13 || data.readUInt8(5) != 10 || data.readUInt8(6) != 26 || data.readUInt8(7) != 10 {
        return new ImageSize(0, 0)
    }
    if data.readUInt32BE(12) != 1229472850 {
        return new ImageSize(0, 0)
    }
    let w = data.readUInt32BE(16)
    let h = data.readUInt32BE(20)
    if w <= 0 || h <= 0 || w > 2147483647 || h > 2147483647 {
        return new ImageSize(0, 0)
    }
    return new ImageSize(w, h)
}

fn jpegSize(data: ByteBuffer): ImageSize {
    if data.length() < 4 || data.readUInt8(0) != 255 || data.readUInt8(1) != 216 {
        return new ImageSize(0, 0)
    }
    let at = 2
    while at + 4 <= data.length() {
        if data.readUInt8(at) != 255 {
            at += 1
        } else {
            let marker = data.readUInt8(at + 1)
            if marker == 216 || marker == 217 || (marker >= 208 && marker <= 215) {
                at += 2
            } else {
                let seg = data.readUInt16BE(at + 2)
                if seg < 2 || at + 2 + seg > data.length() {
                    return new ImageSize(0, 0)
                }
                let sof = (marker >= 192 && marker <= 195)
                    || (marker >= 197 && marker <= 199)
                    || (marker >= 201 && marker <= 203)
                    || (marker >= 205 && marker <= 207)
                if sof {
                    if at + 9 > data.length() {
                        return new ImageSize(0, 0)
                    }
                    let h = data.readUInt16BE(at + 5)
                    let w = data.readUInt16BE(at + 7)
                    if w <= 0 || h <= 0 {
                        return new ImageSize(0, 0)
                    }
                    return new ImageSize(w, h)
                }
                at += 2 + seg
            }
        }
    }
    return new ImageSize(0, 0)
}

fn webpSize(data: ByteBuffer): ImageSize {
    if data.length() < 30 {
        return new ImageSize(0, 0)
    }
    if data.readUInt8(0) != 82 || data.readUInt8(1) != 73 || data.readUInt8(2) != 70 || data.readUInt8(3) != 70 {
        return new ImageSize(0, 0)
    }
    if data.readUInt8(8) != 87 || data.readUInt8(9) != 69 || data.readUInt8(10) != 66 || data.readUInt8(11) != 80 {
        return new ImageSize(0, 0)
    }
    let c0 = data.readUInt8(12)
    let c1 = data.readUInt8(13)
    let c2 = data.readUInt8(14)
    let c3 = data.readUInt8(15)
    if c0 == 86 && c1 == 80 && c2 == 56 && c3 == 88 {
        if data.length() < 30 {
            return new ImageSize(0, 0)
        }
        let w = 1 + data.readUInt8(24) + data.readUInt8(25) * 256 + data.readUInt8(26) * 65536
        let h = 1 + data.readUInt8(27) + data.readUInt8(28) * 256 + data.readUInt8(29) * 65536
        return new ImageSize(w, h)
    }
    if c0 == 86 && c1 == 80 && c2 == 56 && c3 == 76 {
        if data.length() < 25 || data.readUInt8(20) != 47 {
            return new ImageSize(0, 0)
        }
        let bits = data.readUInt32LE(21)
        let w = 1 + (bits & 16383)
        let h = 1 + ((bits >> 14) & 16383)
        return new ImageSize(w, h)
    }
    if c0 == 86 && c1 == 80 && c2 == 56 && c3 == 32 {
        if data.length() < 30 || data.readUInt8(23) != 157 || data.readUInt8(24) != 1 || data.readUInt8(25) != 42 {
            return new ImageSize(0, 0)
        }
        let w = (data.readUInt8(26) + data.readUInt8(27) * 256) & 16383
        let h = (data.readUInt8(28) + data.readUInt8(29) * 256) & 16383
        return new ImageSize(w, h)
    }
    return new ImageSize(0, 0)
}

fn svgSpace(c: Int): Bool {
    if c == 32 || c == 9 || c == 10 || c == 13 {
        return true
    }
    return false
}

fn svgSkipSpace(s: String, at: Int): Int {
    let i = at
    while i < s.length() && svgSpace(s.charCodeAt(i)) {
        i += 1
    }
    return i
}

fn svgStart(data: ByteBuffer): Int {
    let n = data.length()
    let i = 0
    if n >= 3 && data.readUInt8(0) == 239 && data.readUInt8(1) == 187 && data.readUInt8(2) == 191 {
        i = 3
    }
    while i < n && svgSpace(data.readUInt8(i)) {
        i += 1
    }
    if i + 4 > n {
        return -1
    }
    if data.readUInt8(i) != 60 {
        return -1
    }
    let c1 = data.readUInt8(i + 1)
    let c2 = data.readUInt8(i + 2)
    let c3 = data.readUInt8(i + 3)
    if c1 != 115 && c1 != 83 {
        return -1
    }
    if c2 != 118 && c2 != 86 {
        return -1
    }
    if c3 != 103 && c3 != 71 {
        return -1
    }
    let after = i + 4
    if after < n {
        let b = data.readUInt8(after)
        if !svgSpace(b) && b != 62 && b != 47 {
            return -1
        }
    }
    return i
}

fn svgNumberAt(s: String, at: Int): Array<Int> {
    let i = svgSkipSpace(s, at)
    let sign = 1
    if i < s.length() && s.charCodeAt(i) == 45 {
        sign = -1
        i += 1
    } else if i < s.length() && s.charCodeAt(i) == 43 {
        i += 1
    }
    let whole = 0
    let digits = 0
    while i < s.length() {
        let c = s.charCodeAt(i)
        if c < 48 || c > 57 {
            break
        }
        whole = whole * 10 + (c - 48)
        digits += 1
        i += 1
    }
    let frac = 0
    let scale = 1
    if i < s.length() && s.charCodeAt(i) == 46 {
        i += 1
        while i < s.length() {
            let c = s.charCodeAt(i)
            if c < 48 || c > 57 {
                break
            }
            if scale < 1000000 {
                frac = frac * 10 + (c - 48)
                scale *= 10
            }
            digits += 1
            i += 1
        }
    }
    if digits == 0 {
        return [-1, -1]
    }
    let value = whole
    if scale > 1 {
        value = whole + (frac * 2 + scale) / (scale * 2)
    }
    value = value * sign
    return [value, i]
}

fn svgLength(raw: String): Int {
    let s = raw.trim()
    let got = svgNumberAt(s, 0)
    if got[1] < 0 {
        return -1
    }
    let i = svgSkipSpace(s, got[1])
    if i < s.length() {
        let c0 = s.charCodeAt(i)
        let c1 = -1
        if i + 1 < s.length() {
            c1 = s.charCodeAt(i + 1)
        }
        if (c0 == 112 || c0 == 80) && (c1 == 120 || c1 == 88) {
            i += 2
            i = svgSkipSpace(s, i)
        }
    }
    if i != s.length() {
        return -1
    }
    let v = got[0]
    if v <= 0 {
        return -1
    }
    return v
}

fn svgBoxDims(raw: String): Array<Int> {
    let nums: Array<Int> = []
    let i = 0
    while i < raw.length() {
        let c = raw.charCodeAt(i)
        if c == 44 || svgSpace(c) {
            i += 1
        } else {
            let got = svgNumberAt(raw, i)
            if got[1] < 0 {
                return [-1, -1]
            }
            nums.push(got[0])
            i = got[1]
        }
    }
    if nums.length() < 4 {
        return [-1, -1]
    }
    if nums[2] <= 0 || nums[3] <= 0 {
        return [-1, -1]
    }
    return [nums[2], nums[3]]
}

/**
 * Read the intrinsic size from an SVG document. Only the opening `svg` tag is
 * inspected: `width` and `height` win when both are plain numbers with an
 * optional `px` suffix, then `viewBox`, then the SVG default 300x150. Leading
 * whitespace and a UTF-8 BOM are skipped. Non-SVG or truncated input returns
 * 0x0; percentages and other units are ignored for sizing.
 */
fn svgSize(data: ByteBuffer): ImageSize {
    let start = svgStart(data)
    if start < 0 {
        return new ImageSize(0, 0)
    }
    let n = data.length()
    let end = -1
    let quote = 0
    let i = start + 4
    while i < n {
        let c = data.readUInt8(i)
        if quote != 0 {
            if c == quote {
                quote = 0
            }
        } else if c == 34 || c == 39 {
            quote = c
        } else if c == 62 {
            end = i
            i = n
        }
        i += 1
    }
    if end < 0 {
        return new ImageSize(0, 0)
    }
    let tag = data.readString(start, end - start)
    let width = -1
    let height = -1
    let boxW = -1
    let boxH = -1
    let at = 4
    while at < tag.length() {
        let b = tag.charCodeAt(at)
        if b == 47 || b == 62 || svgSpace(b) {
            at += 1
        } else {
            let nameStart = at
            while at < tag.length() {
                let d = tag.charCodeAt(at)
                if d == 61 || d == 47 || d == 62 || svgSpace(d) {
                    break
                }
                at += 1
            }
            let name = tag.slice(nameStart, at).toLowerCase()
            let value = ""
            let hasValue = false
            at = svgSkipSpace(tag, at)
            if at < tag.length() && tag.charCodeAt(at) == 61 {
                at += 1
                at = svgSkipSpace(tag, at)
                if at < tag.length() {
                    let q = tag.charCodeAt(at)
                    if q == 34 || q == 39 {
                        at += 1
                        let valueStart = at
                        while at < tag.length() && tag.charCodeAt(at) != q {
                            at += 1
                        }
                        value = tag.slice(valueStart, at)
                        hasValue = true
                        if at < tag.length() {
                            at += 1
                        }
                    } else {
                        let valueStart = at
                        while at < tag.length() {
                            let d = tag.charCodeAt(at)
                            if d == 47 || d == 62 || svgSpace(d) {
                                break
                            }
                            at += 1
                        }
                        value = tag.slice(valueStart, at)
                        hasValue = true
                    }
                }
            }
            if hasValue {
                if name == "width" {
                    width = svgLength(value)
                } else if name == "height" {
                    height = svgLength(value)
                } else if name == "viewbox" {
                    let dims = svgBoxDims(value)
                    if dims[0] > 0 && dims[1] > 0 {
                        boxW = dims[0]
                        boxH = dims[1]
                    }
                }
            }
        }
    }
    if width > 0 && height > 0 {
        return new ImageSize(width, height)
    }
    if boxW > 0 && boxH > 0 {
        return new ImageSize(boxW, boxH)
    }
    return new ImageSize(300, 150)
}

/// Dimensions from a PNG, JPEG, WebP, or SVG header. Returns `0x0` when the
/// format or header is not recognized; the renderer still owns actual decoding.
fn rawImageSize(data: ByteBuffer): ImageSize {
    if data.length() < 24 || data.readUInt32LE(0) != 0x52584E52 {
        return new ImageSize(0, 0)
    }
    let w = data.readUInt32LE(4)
    let h = data.readUInt32LE(8)
    let stride = data.readUInt32LE(12)
    let format = data.readUInt32LE(16)
    let len = data.readUInt32LE(20)
    if w <= 0 || h <= 0 || format != 0 || w > 2147483647 || h > 2147483647 {
        return new ImageSize(0, 0)
    }
    if stride != w * 4 || len != stride * h || data.length() < 24 + len {
        return new ImageSize(0, 0)
    }
    return new ImageSize(w, h)
}

fn imageSize(data: ByteBuffer): ImageSize {
    if data.length() >= 24 && data.readUInt32LE(0) == 0x52584E52 {
        return rawImageSize(data)
    }
    if data.length() >= 8 && data.readUInt8(0) == 137 && data.readUInt8(1) == 80 {
        return pngSize(data)
    }
    if data.length() >= 2 && data.readUInt8(0) == 255 && data.readUInt8(1) == 216 {
        return jpegSize(data)
    }
    if data.length() >= 12 && data.readUInt8(0) == 82 && data.readUInt8(1) == 73 && data.readUInt8(2) == 70 && data.readUInt8(3) == 70 {
        return webpSize(data)
    }
    if svgStart(data) >= 0 {
        return svgSize(data)
    }
    return new ImageSize(0, 0)
}

/**
 * The destination rectangle for one fit mode. Coordinates are relative to
 * the top-left of the view box; a zero box or a zero image returns an empty
 * rectangle. `cover` and `none` may extend past the box and are clipped by
 * the painter.
 */
fn imageFitRect(f: ImageFit, boxW: Float, boxH: Float, imageW: Float, imageH: Float): ImageRect {
    if boxW <= 0.0 || boxH <= 0.0 || imageW <= 0.0 || imageH <= 0.0 {
        return ImageRect(x: 0.0, y: 0.0, w: 0.0, h: 0.0)
    }
    if f == ImageFit.fill {
        return ImageRect(x: 0.0, y: 0.0, w: boxW, h: boxH)
    }
    if f == ImageFit.none {
        return ImageRect(x: 0.0, y: 0.0, w: imageW, h: imageH)
    }
    let sx = boxW / imageW
    let sy = boxH / imageH
    let s = sx
    if f == ImageFit.cover {
        if sy > s { s = sy }
    } else {
        if sy < s { s = sy }
        if f == ImageFit.scaleDown && s > 1.0 { s = 1.0 }
    }
    let w = imageW * s
    let h = imageH * s
    return ImageRect(x: (boxW - w) / 2.0, y: (boxH - h) / 2.0, w: w, h: h)
}

fn imageRect(f: ImageFit, boxW: Float, boxH: Float, imageW: Float, imageH: Float): ImageRect {
    return imageFitRect(f, boxW, boxH, imageW, imageH)
}

pub enum Role {
    root,
    column,
    row,
    section,
    heading,
    text,
    button,
    slider,
    toggle,
    radio,
    radiogroup,
    textbox,
    dialog,
    checkbox,
    list,
    listitem,
    canvas,
    stack,
    scroll,
    wrap,
    grid,
    divider,
    progress,
    icon,
    image,
    tab,
    menubar,
    menuitem,
    display,
    link,
}

fn roleId(r: Role): Int {
    if r == Role.root { return 0 }
    if r == Role.column { return 1 }
    if r == Role.row { return 2 }
    if r == Role.section { return 3 }
    if r == Role.heading { return 4 }
    if r == Role.text { return 5 }
    if r == Role.button { return 6 }
    if r == Role.slider { return 7 }
    if r == Role.toggle { return 8 }
    if r == Role.radio { return 9 }
    if r == Role.radiogroup { return 10 }
    if r == Role.textbox { return 11 }
    if r == Role.dialog { return 12 }
    if r == Role.checkbox { return 13 }
    if r == Role.list { return 14 }
    if r == Role.listitem { return 15 }
    if r == Role.canvas { return 16 }
    if r == Role.stack { return 17 }
    if r == Role.scroll { return 18 }
    if r == Role.wrap { return 19 }
    if r == Role.grid { return 20 }
    if r == Role.divider { return 21 }
    if r == Role.progress { return 22 }
    if r == Role.icon { return 23 }
    if r == Role.image { return 24 }
    if r == Role.tab { return 25 }
    if r == Role.menubar { return 26 }
    if r == Role.menuitem { return 27 }
    if r == Role.display { return 28 }
    if r == Role.link { return 29 }
    return 16
}

fn roleName(id: Int): String {
    if id == 0 { return "root" }
    if id == 1 { return "column" }
    if id == 2 { return "row" }
    if id == 3 { return "section" }
    if id == 4 { return "heading" }
    if id == 5 { return "text" }
    if id == 6 { return "button" }
    if id == 7 { return "slider" }
    if id == 8 { return "toggle" }
    if id == 9 { return "radio" }
    if id == 10 { return "radiogroup" }
    if id == 11 { return "textbox" }
    if id == 12 { return "dialog" }
    if id == 13 { return "checkbox" }
    if id == 14 { return "list" }
    if id == 15 { return "listitem" }
    if id == 16 { return "canvas" }
    if id == 17 { return "stack" }
    if id == 18 { return "scroll" }
    if id == 19 { return "wrap" }
    if id == 20 { return "grid" }
    if id == 21 { return "divider" }
    if id == 22 { return "progress" }
    if id == 23 { return "icon" }
    if id == 24 { return "image" }
    if id == 25 { return "tab" }
    if id == 26 { return "menubar" }
    if id == 27 { return "menuitem" }
    if id == 28 { return "display" }
    if id == 29 { return "link" }
    return "unknown"
}

pub enum Action {
    tap,
    toggle,
    setValue,
    dismiss,
}

fn actionId(a: Action): Int {
    if a == Action.tap { return 1 }
    if a == Action.toggle { return 2 }
    if a == Action.setValue { return 4 }
    if a == Action.dismiss { return 8 }
    return 0
}

pub enum Key {
    enter,
    space,
    escape,
    tab,
    backspace,
    delete,
    home,
    end,
    pageUp,
    pageDown,
    left,
    right,
    up,
    down,
}

/**
 * A node handle. It carries the tree so `addChild` needs no ambient state, and
 * it is two words, so passing it around is free.
 */
pub struct Node {
    let tree: Tree
    let id: Int

    /** Attach a child at the end of this node's children. */
    pub fn addChild(c: Node) {
        this.tree.attach(this.id, c.id)
    }

    /** Give this node a rectangle in screen space. */
    pub fn bounds(x: Int, y: Int, w: Int, h: Int): Node {
        this.tree.setBounds(this.id, x, y, w, h)
        return Node(tree: this.tree, id: this.id)
    }

    /** Stable key for reconciliation across frames. */
    pub fn key(k: String): Node {
        this.tree.setKey(this.id, k)
        return Node(tree: this.tree, id: this.id)
    }

    /** Make this node a drag source carrying a typed payload. */
    pub fn draggable(kind: String, text: String): Node {
        this.tree.setDraggable(this.id, kind, text)
        return Node(tree: this.tree, id: this.id)
    }

    /** Accept drops of the comma-separated kinds on this node. */
    pub fn dropTarget(kinds: String, cb: fn(DragData): Void): Node {
        this.tree.setDropTarget(this.id, kinds, cb)
        return Node(tree: this.tree, id: this.id)
    }

    /** Horizontal alignment for this node's text. */
    pub fn textAlign(a: Align): Node {
        this.tree.setTextAlign(this.id, a)
        return Node(tree: this.tree, id: this.id)
    }

    /** Wrap text at the node width instead of clipping it. */
    pub fn textWrap(on: Bool): Node {
        this.tree.setTextWrap(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Zero keeps the role default; one enables ellipsis for clipped text. */
    pub fn textMaxLines(n: Int): Node {
        this.tree.setTextMaxLines(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** A disabled node is skipped by focus, hover activation, and shortcuts. */
    pub fn disabled(on: Bool): Node {
        this.tree.setDisabled(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Clip children and painting to this node's rectangle. */
    pub fn clip(on: Bool): Node {
        this.tree.setClip(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Clip children and painting to this node's rounded rectangle. */
    pub fn clipRound(radius: Float): Node {
        this.tree.setClipRound(this.id, radius)
        return Node(tree: this.tree, id: this.id)
    }

    /** Draw a blurred rounded shadow behind this node. */
    pub fn shadow(color: Int, dx: Float, dy: Float, blur: Float, radius: Float): Node {
        this.tree.setShadow(this.id, color, dx, dy, blur, radius)
        return Node(tree: this.tree, id: this.id)
    }

    /** Group opacity for this node and everything under it. */
    pub fn opacity(f: Float): Node {
        this.tree.setOpacity(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** Blend this node's whole group against the backdrop. */
    pub fn blend(m: BlendMode): Node {
        this.tree.setBlend(this.id, blendModeId(m))
        return Node(tree: this.tree, id: this.id)
    }

    /** Alpha-mask this node's whole group with rounded corners. Not a clip. */
    pub fn maskRadius(radius: Float): Node {
        this.tree.setMaskRadius(this.id, radius)
        return Node(tree: this.tree, id: this.id)
    }

    /** Blur this node's whole group by a standard deviation. */
    pub fn blur(sigma: Float): Node {
        this.tree.setBlurSigma(this.id, sigma)
        return Node(tree: this.tree, id: this.id)
    }

    /** Shift this node down inside its parent, after the normal stack. */
    pub fn offsetY(y: Float): Node {
        this.tree.setOffsetY(this.id, y)
        return Node(tree: this.tree, id: this.id)
    }

    /** Numeric value in 0..1, for sliders and progress controls. */
    pub fn range(v: Float): Node {
        this.tree.setNumber(this.id, v)
        return Node(tree: this.tree, id: this.id)
    }

    /** How this image fills its box. */
    pub fn imageFit(f: ImageFit): Node {
        this.tree.setImageFit(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** The bitmap's intrinsic size, used to fit it into the box. */
    pub fn imageSize(w: Int, h: Int): Node {
        this.tree.setImageIntrinsic(this.id, w, h)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn fixedHeight(h: Int): Node {
        this.tree.setFixedHeight(this.id, h)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn fixedWidth(w: Int): Node {
        this.tree.setFixedWidth(this.id, w)
        return Node(tree: this.tree, id: this.id)
    }

    /** Paint this node as a circle. */
    pub fn round(): Node {
        this.tree.setRound(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Paint this node with the theme accent. */
    pub fn accent(): Node {
        this.tree.setAccent(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Pick the theme role a button's fill plays. */
    pub fn tone(t: ButtonTone): Node {
        this.tree.setTone(this.id, t)
        return Node(tree: this.tree, id: this.id)
    }

    /** Lift a card or section onto the raised surface token. */
    pub fn raised(): Node {
        this.tree.setRaised(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Draw the theme shadow for this elevation step behind the node. */
    pub fn elevation(e: ElevationToken): Node {
        this.tree.setElevation(this.id, e)
        return Node(tree: this.tree, id: this.id)
    }

    /** Fill this node with a vertical gradient. */
    pub fn gradient(): Node {
        this.tree.setGradient(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Override the role's text size in pixels. */
    pub fn textSize(px: Int): Node {
        this.tree.setTextSize(this.id, px)
        return Node(tree: this.tree, id: this.id)
    }

    /** CSS text weight for this node, 100 to 900. */
    pub fn fontWeight(weight: Int): Node {
        this.tree.setFontWeight(this.id, weight)
        return Node(tree: this.tree, id: this.id)
    }

    /** Shape this node's text with the italic face. */
    pub fn italic(on: Bool = true): Node {
        this.tree.setItalic(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Row height as a multiplier of the font size; zero keeps normal spacing. */
    pub fn lineHeight(f: Float): Node {
        this.tree.setLineHeight(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** Extra advance per character, in logical pixels. */
    pub fn letterSpacing(f: Float): Node {
        this.tree.setLetterSpacing(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** Scroll a viewport to a vertical offset. */
    pub fn scrollTo(y: Float): Node {
        this.tree.setScrollTo(this.id, y)
        return Node(tree: this.tree, id: this.id)
    }

    /** Take this node out of the parent's stack and place it by edge. */
    pub fn absolute(): Node {
        this.tree.setAbsolute(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn left(n: Int): Node {
        this.tree.setLeft(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn top(n: Int): Node {
        this.tree.setTop(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn right(n: Int): Node {
        this.tree.setRight(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn bottom(n: Int): Node {
        this.tree.setBottom(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Set all four edges at once. */
    pub fn inset(n: Int): Node {
        this.tree.setLeft(this.id, n)
        this.tree.setTop(this.id, n)
        this.tree.setRight(this.id, n)
        this.tree.setBottom(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Number of columns in a grid. */
    pub fn columns(n: Int): Node {
        this.tree.setColumns(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Height follows width by this ratio when no height is set. */
    pub fn aspectRatio(r: Float): Node {
        this.tree.setAspectRatio(this.id, r)
        return Node(tree: this.tree, id: this.id)
    }

    /** Override the parent's cross-axis alignment for this child. */
    pub fn alignSelf(a: Align): Node {
        this.tree.setAlignSelf(this.id, a)
        return Node(tree: this.tree, id: this.id)
    }

    /** Sort key among siblings; lower comes first. */
    pub fn order(n: Int): Node {
        this.tree.setOrder(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Gap as a percentage of the container's content width. */
    pub fn gapPercent(p: Float): Node {
        this.tree.setGapPercent(this.id, p)
        return Node(tree: this.tree, id: this.id)
    }

    /** Give this container one tab stop and arrow-key movement. */
    pub fn roving(): Node {
        this.tree.setRoving(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Apply a parent-supplied constraint to this node. */
    pub fn constrain(c: Constraints): Node {
        this.tree.setConstraints(this.id, c)
        return Node(tree: this.tree, id: this.id)
    }

    /** Preferred width when nothing else sizes this node. */
    pub fn idealWidth(w: Int): Node {
        this.tree.setIdealWidth(this.id, w)
        return Node(tree: this.tree, id: this.id)
    }

    /** Preferred height; content taller than this still wins. */
    pub fn idealHeight(h: Int): Node {
        this.tree.setIdealHeight(this.id, h)
        return Node(tree: this.tree, id: this.id)
    }

    /** Let free main-axis space become margin on this child. */
    pub fn autoMargin(): Node {
        this.tree.setAutoMargin(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Painting and hit-test order among siblings; higher is on top. */
    pub fn zIndex(z: Int): Node {
        this.tree.setZIndex(this.id, z)
        return Node(tree: this.tree, id: this.id)
    }

    /** Stack this node's text down the block axis. */
    pub fn vertical(): Node {
        this.tree.setWritingMode(WritingMode.vertical)
        return Node(tree: this.tree, id: this.id)
    }

    /** Lay this node out right-to-left. */
    pub fn rtl(): Node {
        this.tree.setRTL(true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Leave this subtree out of focus, hit testing, and semantics. */
    pub fn inert(): Node {
        this.tree.setInert(this.id, true)
        return Node(tree: this.tree, id: this.id)
    }

    /** Draw this node above its layout parent, inside `layer`. */
    pub fn portal(layer: Node): Node {
        this.tree.setPortal(this.id, layer.id)
        return Node(tree: this.tree, id: this.id)
    }

    /** A tooltip shown while this node is hovered. */
    pub fn tooltip(s: String): Node {
        this.tree.setTooltip(this.id, s)
        return Node(tree: this.tree, id: this.id)
    }

    /** Selection state, for list rows, tabs, and options. */
    pub fn setSelected(on: Bool): Node {
        this.tree.setSelected(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Expansion state: -1 unknown, 0 collapsed, 1 expanded. */
    pub fn setExpanded(n: Int): Node {
        this.tree.setExpanded(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** True while the node is working and not ready for input. */
    pub fn setBusy(on: Bool): Node {
        this.tree.setBusy(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** True when the field must be filled before submit. */
    pub fn setRequired(on: Bool): Node {
        this.tree.setRequired(this.id, on)
        return Node(tree: this.tree, id: this.id)
    }

    /** Validation state: 0 valid, 1 invalid, 2 spelling, 3 grammar. */
    pub fn setInvalid(n: Int): Node {
        this.tree.setInvalid(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Heading level, 0 when the role is not a heading. */
    pub fn setLevel(n: Int): Node {
        this.tree.setLevel(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Live region politeness: 0 off, 1 polite, 2 assertive. */
    pub fn setLive(n: Int): Node {
        this.tree.setLive(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Accessible description read after the name. */
    pub fn setDescription(s: String): Node {
        this.tree.setDescription(this.id, s)
        return Node(tree: this.tree, id: this.id)
    }

    /** Node that supplies this node's accessible name. */
    pub fn labelRel(id: Int): Node {
        this.tree.setLabelId(this.id, id)
        return Node(tree: this.tree, id: this.id)
    }

    /** Node that supplies this node's accessible description. */
    pub fn describedBy(id: Int): Node {
        this.tree.setDescribedById(this.id, id)
        return Node(tree: this.tree, id: this.id)
    }

    /** Node this control operates, such as a list or panel. */
    pub fn controls(id: Int): Node {
        this.tree.setControlsId(this.id, id)
        return Node(tree: this.tree, id: this.id)
    }

    /** Bounds and step for a numeric control. */
    pub fn setRange(min: Float, max: Float, step: Float): Node {
        this.tree.setRange(this.id, min, max, step)
        return Node(tree: this.tree, id: this.id)
    }

    /** Width is the smallest width that does not overflow. */
    pub fn minContent(): Node {
        this.tree.setSizeMode(this.id, 1)
        return Node(tree: this.tree, id: this.id)
    }

    /** Width is the widest the content wants. */
    pub fn maxContent(): Node {
        this.tree.setSizeMode(this.id, 2)
        return Node(tree: this.tree, id: this.id)
    }

    /** Width is max-content capped by the available width. */
    pub fn fitContent(): Node {
        this.tree.setSizeMode(this.id, 3)
        return Node(tree: this.tree, id: this.id)
    }

    /** Space inside this node's box. Replaces the role default. */
    pub fn padding(n: Int): Node {
        this.tree.setPadding(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Space between this node's children. Replaces the role default. */
    pub fn gap(n: Int): Node {
        this.tree.setGap(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Space outside this node's box, added by its parent's stack. */
    pub fn margin(n: Int): Node {
        this.tree.setMargin(this.id, n)
        return Node(tree: this.tree, id: this.id)
    }

    /** Share of the free main-axis space in a fixed-size container. */
    pub fn grow(f: Float): Node {
        this.tree.setGrow(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** Share of the overflow this node absorbs in a row. */
    pub fn shrink(f: Float): Node {
        this.tree.setShrink(this.id, f)
        return Node(tree: this.tree, id: this.id)
    }

    /** Main-axis placement of children: start, center, or end. */
    pub fn alignMain(a: Align): Node {
        this.tree.setMainAlign(this.id, a)
        return Node(tree: this.tree, id: this.id)
    }

    /** Cross-axis placement of children: start, center, end, or stretch. */
    pub fn alignCross(a: Align): Node {
        this.tree.setCrossAlign(this.id, a)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn minWidth(w: Int): Node {
        this.tree.setMinWidth(this.id, w)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn maxWidth(w: Int): Node {
        this.tree.setMaxWidth(this.id, w)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn minHeight(h: Int): Node {
        this.tree.setMinHeight(this.id, h)
        return Node(tree: this.tree, id: this.id)
    }

    pub fn maxHeight(h: Int): Node {
        this.tree.setMaxHeight(this.id, h)
        return Node(tree: this.tree, id: this.id)
    }
}

/** The color space a frame buffer is tagged with. */
pub enum ColorSpace {
    srgb,
    linear,
    displayP3,
}

fn colorSpaceId(c: ColorSpace): Int {
    if c == ColorSpace.linear { return 1 }
    if c == ColorSpace.displayP3 { return 2 }
    return 0
}

fn colorSpaceAt(id: Int): ColorSpace {
    if id == 1 { return ColorSpace.linear }
    if id == 2 { return ColorSpace.displayP3 }
    return ColorSpace.srgb
}

/** Inline axis for text and flow. */
pub enum WritingMode {
    horizontal,
    vertical,
}

/** Horizontal text alignment inside a node's content box. */
pub enum Align {
    start,
    center,
    end,
    stretch,
    baseline,
}

fn alignId(a: Align): Int {
    if a == Align.center { return 1 }
    if a == Align.end { return 2 }
    if a == Align.stretch { return 3 }
    if a == Align.baseline { return 4 }
    return 0
}

/** How a layer's group color combines with the backdrop. */
pub enum BlendMode {
    normal,
    multiply,
    screen,
    overlay,
    darken,
    lighten,
    difference,
    exclusion,
    plus,
}

fn blendModeId(m: BlendMode): Int {
    if m == BlendMode.multiply { return 1 }
    if m == BlendMode.screen { return 2 }
    if m == BlendMode.overlay { return 3 }
    if m == BlendMode.darken { return 4 }
    if m == BlendMode.lighten { return 5 }
    if m == BlendMode.difference { return 6 }
    if m == BlendMode.exclusion { return 7 }
    if m == BlendMode.plus { return 8 }
    return 0
}

fn blendModeName(id: Int): String {
    if id == 1 { return "multiply" }
    if id == 2 { return "screen" }
    if id == 3 { return "overlay" }
    if id == 4 { return "darken" }
    if id == 5 { return "lighten" }
    if id == 6 { return "difference" }
    if id == 7 { return "exclusion" }
    if id == 8 { return "plus" }
    return "normal"
}

/** The role a button's fill plays in the theme. */
pub enum ButtonTone {
    neutral,
    accent,
    danger,
    ghost,
}

/** A control size. Medium is the shipped default and stays untouched. */
pub enum ButtonSize {
    sm,
    md,
    lg,
}

fn buttonToneId(t: ButtonTone): Int {
    if t == ButtonTone.accent { return 1 }
    if t == ButtonTone.danger { return 2 }
    if t == ButtonTone.ghost { return 3 }
    return 0
}

fn textSize(role: Int): Float {
    if role == 28 {
        return 56.0
    }
    if role == 4 || role == 12 {
        return 20.0
    }
    return 14.0
}

fn textWraps(role: Int): Bool {
    if role == 4 || role == 5 || role == 12 {
        return true
    }
    return false
}

fn textDefaultLines(role: Int): Int {
    if textWraps(role) {
        return 0
    }
    return 1
}

fn textPad(role: Int): Float {
    if role == 6 {
        return 14.0
    }
    if role == 25 {
        return 12.0
    }
    if role == 27 {
        return 12.0
    }
    if role == 8 || role == 9 || role == 13 {
        return 24.0
    }
    if role == 11 || role == 15 {
        return 10.0
    }
    if role == 12 {
        return 12.0
    }
    return 0.0
}

fn textPadY(role: Int): Float {
    if role == 25 || role == 27 {
        return 7.0
    }
    if role == 12 {
        return 8.0
    }
    if role == 4 || role == 5 || role == 28 {
        return 0.0
    }
    return 6.0
}

fn isTextRole(role: Int): Bool {
    if role == 4 || role == 5 || role == 6 || role == 7 || role == 8 || role == 28 {
        return true
    }
    if role == 25 || role == 27 {
        return true
    }
    if role == 9 || role == 11 || role == 12 || role == 13 || role == 15 {
        return true
    }
    return false
}

/** One laid-out line of text. */
pub struct TextRow {
    let text: String
    let width: Float
    let height: Float
    let baseline: Float
    let ellipsized: Bool
}

/** A generic font family. Ids match the shaper's style word. */
pub enum FontFamily {
    sans,
    serif,
    mono,
    cursive,
    fantasy,
    system,
    uiSerif,
    uiSans,
    uiMono,
    uiRounded,
    emoji,
    math,
}

fn fontFamilyId(f: FontFamily): Int {
    if f == FontFamily.serif { return 1 }
    if f == FontFamily.mono { return 2 }
    if f == FontFamily.cursive { return 3 }
    if f == FontFamily.fantasy { return 4 }
    if f == FontFamily.system { return 5 }
    if f == FontFamily.uiSerif { return 6 }
    if f == FontFamily.uiSans { return 7 }
    if f == FontFamily.uiMono { return 8 }
    if f == FontFamily.uiRounded { return 9 }
    if f == FontFamily.emoji { return 10 }
    if f == FontFamily.math { return 11 }
    return 0
}

/**
 * A named font face. `id` is the family tag packed into text records; the
 * registry assigns ids from 100 so they cannot collide with `FontFamily`.
 */
pub class FontFace {
    let id: Int
    let name: String
    let data: ByteBuffer

    init(id: Int, name: String, data: ByteBuffer) {
        this.id = id
        this.name = name
        this.data = data
    }
}

/**
 * Named font faces for one app. The registry is bounded: at most 16 faces and
 * 8 MB of font data. Ids are dense from 100 in registration order.
 */
pub class FontRegistry {
    let faces: Array<FontFace> = []
    let bytesV: Int = 0

    static fn firstId(): Int {
        return 100
    }

    static fn maxFaces(): Int {
        return 16
    }

    static fn maxBytes(): Int {
        return 8388608
    }

    /** Register one face, or return null when the name/data is empty or a cap is hit. */
    pub fn register(name: String, data: ByteBuffer): FontFace? {
        if name == "" || data.length() == 0 {
            return null
        }
        if this.faces.length() >= FontRegistry.maxFaces() {
            return null
        }
        if this.bytesV + data.length() > FontRegistry.maxBytes() {
            return null
        }
        let face = new FontFace(FontRegistry.firstId() + this.faces.length(), name, data)
        this.faces.push(face)
        this.bytesV += data.length()
        return face
    }

    pub fn len(): Int {
        return this.faces.length()
    }

    pub fn bytes(): Int {
        return this.bytesV
    }

    pub fn at(i: Int): FontFace? {
        if i < 0 || i >= this.faces.length() {
            return null
        }
        return this.faces[i]
    }

    pub fn find(name: String): FontFace? {
        let i = 0
        while i < this.faces.length() {
            if this.faces[i].name == name {
                return this.faces[i]
            }
            i += 1
        }
        return null
    }
}

/** Lines drawn across a run. Bits match the shaper's style word. */
pub enum TextDecoration {
    none,
    underline,
    strikethrough,
    both,
}

fn decorationBits(d: TextDecoration): Int {
    if d == TextDecoration.underline { return 1 }
    if d == TextDecoration.strikethrough { return 2 }
    if d == TextDecoration.both { return 3 }
    return 0
}

/**
 * One inline style range. Offsets count characters, the same way `s.slice`
 * does. Overlapping spans resolve to the last span that covers the offset.
 * `color < 0` keeps the role color the node already uses. A non-empty `link`
 * paints the run as a link and lets the tree hit-test it.
 */
pub class TextSpan {
    let start: Int
    let end: Int
    let weight: Int
    let italic: Bool
    let tracking: Float
    let color: Int
    let family: FontFamily
    let decoration: TextDecoration
    let font: FontFace?
    let link: String

    init(
        start: Int,
        end: Int,
        weight: Int = 400,
        italic: Bool = false,
        tracking: Float = 0.0,
        color: Int = -1,
        family: FontFamily = FontFamily.sans,
        decoration: TextDecoration = TextDecoration.none,
        font: FontFace? = null,
        link: String = ""
    ) {
        this.start = start
        this.end = end
        this.weight = weight
        this.italic = italic
        this.tracking = tracking
        this.color = color
        this.family = family
        this.decoration = decoration
        this.font = font
        this.link = link
    }

    /** Wire family id for the shaper's style word. A named face wins over the generic family. */
    pub fn fontFamilyId(): Int {
        if this.font != null {
            return this.font.id
        }
        return fontFamilyId(this.family)
    }

    /** Wire decoration bits for the shaper's style word. */
    pub fn decorationBits(): Int {
        return decorationBits(this.decoration)
    }
}

/** One screen-space link rectangle on a text node. */
pub class LinkRect {
    let url: String
    let text: String
    let x: Int
    let y: Int
    let w: Int
    let h: Int

    init(url: String, text: String, x: Int, y: Int, w: Int, h: Int) {
        this.url = url
        this.text = text
        this.x = x
        this.y = y
        this.w = w
        this.h = h
    }
}

/** The link under a point and the cursor shape it implies. */
class PointerTarget {
    let url: String
    let shape: Int

    init(url: String, shape: Int) {
        this.url = url
        this.shape = shape
    }
}

/** One shaped run inside a row. `x` is the offset from the row origin. */
pub class TextRun {
    let row: Int
    let start: Int
    let end: Int
    let x: Float
    let advance: Float
    let flags: Int

    init(row: Int, start: Int, end: Int, x: Float, advance: Float, flags: Int = 0) {
        this.row = row
        this.start = start
        this.end = end
        this.x = x
        this.advance = advance
        this.flags = flags
    }
}

/** Rows plus the shaped runs that paint them. */
pub class RichRows {
    let rows: Array<TextRow>
    let runs: Array<TextRun>

    init(rows: Array<TextRow>, runs: Array<TextRun>) {
        this.rows = rows
        this.runs = runs
    }
}

fn spanAt(spans: Array<TextSpan>, at: Int): TextSpan? {
    let found: TextSpan? = null
    let i = 0
    while i < spans.length() {
        let sp = spans[i]
        if at >= sp.start && at < sp.end {
            found = sp
        }
        i += 1
    }
    return found
}

fn spanWeightAt(spans: Array<TextSpan>, at: Int): Int {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.weight
    }
    return 400
}

fn spanItalicAt(spans: Array<TextSpan>, at: Int): Bool {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.italic
    }
    return false
}

fn spanTrackingAt(spans: Array<TextSpan>, at: Int): Float {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.tracking
    }
    return 0.0
}

fn spanColorAt(spans: Array<TextSpan>, at: Int): Int {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.color
    }
    return -1
}

fn spanFamilyAt(spans: Array<TextSpan>, at: Int): FontFamily {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.family
    }
    return FontFamily.sans
}

fn spanFontAt(spans: Array<TextSpan>, at: Int): FontFace? {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.font
    }
    return null
}

fn spanFontTagAt(spans: Array<TextSpan>, at: Int): Int {
    let face = spanFontAt(spans, at)
    if face != null {
        return face.id
    }
    return -1
}

fn spanDecorationAt(spans: Array<TextSpan>, at: Int): TextDecoration {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.decoration
    }
    return TextDecoration.none
}

fn spanLinkAt(spans: Array<TextSpan>, at: Int): String {
    let sp = spanAt(spans, at)
    if sp != null {
        return sp.link
    }
    return ""
}

fn copySpan(sp: TextSpan, start: Int, end: Int): TextSpan {
    return new TextSpan(
        start,
        end,
        sp.weight,
        sp.italic,
        sp.tracking,
        sp.color,
        sp.family,
        sp.decoration,
        sp.font,
        sp.link
    )
}

fn richCharWidth(spans: Array<TextSpan>, at: Int, size: Float): Float {
    return monoMeasureStyle("x", size, spanWeightAt(spans, at), spanItalicAt(spans, at), spanTrackingAt(spans, at))
}

fn richRangeWidth(s: String, spans: Array<TextSpan>, start: Int, end: Int, size: Float): Float {
    let total = 0.0
    let i = start
    while i < end {
        total += richCharWidth(spans, i, size)
        i += 1
    }
    return total
}

fn monoRichRow(start: Int, end: Int, s: String, spans: Array<TextSpan>, size: Float, lineHeight: Float): TextRow {
    let h = size * 1.35
    if lineHeight > 0.0 {
        h = h * lineHeight
    }
    return TextRow(
        text: s.slice(start, end),
        width: richRangeWidth(s, spans, start, end, size),
        height: h,
        baseline: h * 0.8,
        ellipsized: false
    )
}

fn monoRichRuns(
    row: Int,
    start: Int,
    end: Int,
    s: String,
    spans: Array<TextSpan>,
    size: Float
): Array<TextRun> {
    let runs: Array<TextRun> = []
    if end <= start {
        return runs
    }
    let runStart = start
    let x = 0.0
    let cw = spanWeightAt(spans, start)
    let ci = spanItalicAt(spans, start)
    let ct = spanTrackingAt(spans, start)
    let cc = spanColorAt(spans, start)
    let cf = spanFamilyAt(spans, start)
    let cd = spanDecorationAt(spans, start)
    let cft = spanFontTagAt(spans, start)
    let cl = spanLinkAt(spans, start)
    let i = start + 1
    while i <= end {
        let same = i < end
            && spanWeightAt(spans, i) == cw
            && spanItalicAt(spans, i) == ci
            && spanTrackingAt(spans, i) == ct
            && spanColorAt(spans, i) == cc
            && spanFamilyAt(spans, i) == cf
            && spanDecorationAt(spans, i) == cd
            && spanFontTagAt(spans, i) == cft
            && spanLinkAt(spans, i) == cl
        if !same {
            let adv = richRangeWidth(s, spans, runStart, i, size)
            runs.push(new TextRun(row: row, start: runStart, end: i, x: x, advance: adv, flags: 0))
            x += adv
            runStart = i
            if i < end {
                cw = spanWeightAt(spans, i)
                ci = spanItalicAt(spans, i)
                ct = spanTrackingAt(spans, i)
                cc = spanColorAt(spans, i)
                cf = spanFamilyAt(spans, i)
                cd = spanDecorationAt(spans, i)
                cft = spanFontTagAt(spans, i)
                cl = spanLinkAt(spans, i)
            }
        }
        i += 1
    }
    return runs
}

fn monoRichRows(
    s: String,
    size: Float,
    maxWidth: Float,
    wrap: Bool,
    maxLines: Int,
    ellipsis: Bool,
    spans: Array<TextSpan>,
    lineHeight: Float
): RichRows {
    let rows: Array<TextRow> = []
    let starts: Array<Int> = []
    let ends: Array<Int> = []
    if s == "" {
        rows.push(monoRichRow(0, 0, s, spans, size, lineHeight))
        starts.push(0)
        ends.push(0)
        return new RichRows(rows, [])
    }
    let pstart = 0
    let p = 0
    while pstart <= s.length() {
        let pend = pstart
        while pend < s.length() && s.charCodeAt(pend) != 10 {
            pend += 1
        }
        if !wrap || maxWidth <= 0.0 {
            rows.push(monoRichRow(pstart, pend, s, spans, size, lineHeight))
            starts.push(pstart)
            ends.push(pend)
        } else {
            let lineStart = pstart
            let i = pstart
            let lastSpace = -1
            while i < pend {
                let w = richRangeWidth(s, spans, lineStart, i + 1, size)
                if w > maxWidth + 0.01 && i > lineStart {
                    let brk = i
                    if lastSpace >= lineStart {
                        brk = lastSpace
                    }
                    rows.push(monoRichRow(lineStart, brk, s, spans, size, lineHeight))
                    starts.push(lineStart)
                    ends.push(brk)
                    let next = brk
                    if next < pend && s.charCodeAt(next) == 32 {
                        next += 1
                    }
                    lineStart = next
                    i = next
                    lastSpace = -1
                } else {
                    if s.charCodeAt(i) == 32 {
                        lastSpace = i
                    }
                    i += 1
                }
            }
            rows.push(monoRichRow(lineStart, pend, s, spans, size, lineHeight))
            starts.push(lineStart)
            ends.push(pend)
        }
        p += 1
        if pend >= s.length() {
            break
        }
        pstart = pend + 1
    }
    let over = false
    if maxLines > 0 && rows.length() > maxLines {
        over = true
    }
    if maxLines > 0 && rows.length() > 0 && rows[rows.length() - 1].width > maxWidth + 0.01 {
        over = true
    }
    if over && ellipsis && maxWidth > 0.0 {
        while maxLines > 0 && rows.length() > maxLines {
            rows.pop()
            starts.pop()
            ends.pop()
        }
        if rows.length() > 0 {
            let last = rows.length() - 1
            let st = starts[last]
            let en = ends[last]
            let ellW = monoMeasureStyle("…", size, 400, false, 0.0)
            while en > st && richRangeWidth(s, spans, st, en, size) + ellW > maxWidth + 0.01 {
                en -= 1
            }
            let h = rows[last].height
            rows[last] = TextRow(
                text: s.slice(st, en) + "…",
                width: richRangeWidth(s, spans, st, en, size) + ellW,
                height: h,
                baseline: h * 0.8,
                ellipsized: true
            )
            ends[last] = en
        }
    }
    let runs: Array<TextRun> = []
    let ri = 0
    while ri < rows.length() {
        let got = monoRichRuns(ri, starts[ri], ends[ri], s, spans, size)
        let k = 0
        while k < got.length() {
            runs.push(got[k])
            k += 1
        }
        if rows[ri].ellipsized {
            let adv = monoMeasureStyle("…", size, 400, false, 0.0)
            let x = richRangeWidth(s, spans, starts[ri], ends[ri], size)
            runs.push(new TextRun(row: ri, start: ends[ri], end: ends[ri], x: x, advance: adv, flags: 1))
        }
        ri += 1
    }
    return new RichRows(rows, runs)
}

fn plainRichRows(
    s: String,
    rows: Array<TextRow>,
    size: Float,
    measure: fn(String, Float): Float
): RichRows {
    let runs: Array<TextRun> = []
    let cursor = 0
    let i = 0
    while i < rows.length() {
        let text = rows[i].text
        let base = text
        if rows[i].ellipsized && base.length() > 0 {
            base = base.slice(0, base.length() - 1)
        }
        while cursor < s.length() && s.slice(cursor, cursor + base.length()) != base {
            cursor += 1
        }
        let start = cursor
        let end = start + base.length()
        let adv = measure(base, size)
        runs.push(new TextRun(row: i, start: start, end: end, x: 0.0, advance: adv, flags: 0))
        if rows[i].ellipsized {
            runs.push(new TextRun(row: i, start: end, end: end, x: adv, advance: measure("…", size), flags: 1))
        }
        cursor = end
        i += 1
    }
    return new RichRows(rows, runs)
}

fn monoWeightScale(weight: Int): Float {
    let w = weight
    if w <= 0 { w = 400 }
    if w < 100 { w = 100 }
    if w > 900 { w = 900 }
    return 1.0 + Float(w - 400) * 0.0004
}

fn monoMeasureStyle(s: String, size: Float, weight: Int, italic: Bool, tracking: Float): Float {
    let w = Float(s.length()) * size * 0.56 * monoWeightScale(weight)
    if italic {
        w = w * 1.02
    }
    w = w + Float(s.length()) * tracking
    return w
}

fn monoMeasure(s: String, size: Float): Float {
    return monoMeasureStyle(s, size, 400, false, 0.0)
}

fn fixedNext(s: String, at: Int): Int {
    if at < 0 {
        return 0
    }
    if at >= s.length() {
        return s.length()
    }
    return at + 1
}

fn fixedPrev(s: String, at: Int): Int {
    if at <= 0 {
        return 0
    }
    if at > s.length() {
        return s.length()
    }
    return at - 1
}

fn monoRowStyle(text: String, size: Float, weight: Int, italic: Bool, lineHeight: Float, tracking: Float): TextRow {
    let h = size * 1.35
    if lineHeight > 0.0 {
        h = h * lineHeight
    }
    return TextRow(
        text: text,
        width: monoMeasureStyle(text, size, weight, italic, tracking),
        height: h,
        baseline: h * 0.8,
        ellipsized: false
    )
}

fn monoRow(text: String, size: Float): TextRow {
    return monoRowStyle(text, size, 400, false, 0.0, 0.0)
}

fn monoRowsStyle(
    s: String,
    size: Float,
    maxWidth: Float,
    wrap: Bool,
    maxLines: Int,
    ellipsis: Bool,
    weight: Int,
    italic: Bool,
    lineHeight: Float,
    tracking: Float
): Array<TextRow> {
    let rows: Array<TextRow> = []
    if s == "" {
        rows.push(monoRowStyle("", size, weight, italic, lineHeight, tracking))
        return rows
    }
    let paragraphs = s.split("\n")
    let p = 0
    while p < paragraphs.length() {
        let para = paragraphs[p]
        if !wrap || maxWidth <= 0.0 {
            rows.push(monoRowStyle(para, size, weight, italic, lineHeight, tracking))
        } else {
            let words = para.split(" ")
            let line = ""
            let wi = 0
            while wi < words.length() {
                let word = words[wi]
                let candidate = word
                if line != "" {
                    candidate = line + " " + word
                }
                if monoMeasureStyle(candidate, size, weight, italic, tracking) <= maxWidth + 0.01 {
                    line = candidate
                } else if line == "" {
                    if monoMeasureStyle(word, size, weight, italic, tracking) <= maxWidth + 0.01 {
                        line = word
                    } else {
                        let piece = ""
                        let ci = 0
                        while ci < word.length() {
                            let next = piece + word.slice(ci, ci + 1)
                            if monoMeasureStyle(next, size, weight, italic, tracking) > maxWidth + 0.01 && piece != "" {
                                rows.push(monoRowStyle(piece, size, weight, italic, lineHeight, tracking))
                                piece = word.slice(ci, ci + 1)
                            } else {
                                piece = next
                            }
                            ci += 1
                        }
                        line = piece
                    }
                } else {
                    rows.push(monoRowStyle(line, size, weight, italic, lineHeight, tracking))
                    line = word
                }
                wi += 1
            }
            rows.push(monoRowStyle(line, size, weight, italic, lineHeight, tracking))
        }
        p += 1
    }
    let over = false
    if maxLines > 0 && rows.length() > maxLines {
        over = true
    }
    if maxLines > 0 && rows.length() > 0 && rows[rows.length() - 1].width > maxWidth + 0.01 {
        over = true
    }
    if over && ellipsis && maxWidth > 0.0 {
        while maxLines > 0 && rows.length() > maxLines {
            rows.pop()
        }
        if rows.length() > 0 {
            let last = rows[rows.length() - 1]
            let text = last.text
            while text.length() > 0 && monoMeasureStyle(text + "…", size, weight, italic, tracking) > maxWidth + 0.01 {
                text = text.slice(0, text.length() - 1)
            }
            rows[rows.length() - 1] = TextRow(
                text: text + "…",
                width: monoMeasureStyle(text + "…", size, weight, italic, tracking),
                height: last.height,
                baseline: last.baseline,
                ellipsized: true
            )
        }
    }
    return rows
}

fn monoRows(
    s: String,
    size: Float,
    maxWidth: Float,
    wrap: Bool,
    maxLines: Int,
    ellipsis: Bool
): Array<TextRow> {
    return monoRowsStyle(s, size, maxWidth, wrap, maxLines, ellipsis, 400, false, 0.0, 0.0)
}

fn monoRowsStyled(
    s: String,
    size: Float,
    maxWidth: Float,
    wrap: Bool,
    maxLines: Int,
    ellipsis: Bool,
    weight: Int,
    italic: Bool,
    lineHeight: Float,
    tracking: Float
): Array<TextRow> {
    return monoRowsStyle(s, size, maxWidth, wrap, maxLines, ellipsis, weight, italic, lineHeight, tracking)
}

/**
 * A text measurement and line-breaking backend.
 *
 * `@std/ui` is headless, so it never shapes text itself. The app supplies an
 * engine backed by the platform shaper; the default engine measures a fixed
 * advance per character, which keeps tests and headless runs deterministic.
 */
pub class TextEngine {
    let measureFn: fn(String, Float): Float
    let rowsFn: fn(String, Float, Float, Bool, Int, Bool): Array<TextRow>
    let nextFn: fn(String, Int): Int
    let prevFn: fn(String, Int): Int
    let styledMeasureFn: fn(String, Float, Int, Bool, Float): Float
    let styledRowsFn: fn(String, Float, Float, Bool, Int, Bool, Int, Bool, Float, Float): Array<TextRow>
    let richRowsFn: fn(String, Float, Float, Bool, Int, Bool, Array<TextSpan>, Float): RichRows

    init(
        m: fn(String, Float): Float,
        r: fn(String, Float, Float, Bool, Int, Bool): Array<TextRow>,
        n: fn(String, Int): Int,
        p: fn(String, Int): Int
    ) {
        this.measureFn = m
        this.rowsFn = r
        this.nextFn = n
        this.prevFn = p
        this.styledMeasureFn = (s: String, size: Float, weight: Int, italic: Bool, tracking: Float): Float => m(s, size)
        this.styledRowsFn = (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool, weight: Int, italic: Bool, lineHeight: Float, tracking: Float): Array<TextRow> => r(s, size, width, wrap, lines, ell)
        this.richRowsFn = (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool, spans: Array<TextSpan>, lineHeight: Float): RichRows => plainRichRows(s, r(s, size, width, wrap, lines, ell), size, m)
    }

    /**
     * A fixed-advance engine for logic tests and headless runs. Every character
     * is `size * 0.56` wide. It is not the shaper the app ships, so do not use
     * it to assert visual text layout; inject the app's engine for that. The
     * styled path applies the weight, italic, tracking, and line-height lanes
     * with a deterministic approximation so layout tests can read them.
     */
    static fn fixed(): TextEngine {
        let e = new TextEngine(
            (s: String, size: Float): Float => monoMeasure(s, size),
            (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool): Array<TextRow> => monoRows(s, size, width, wrap, lines, ell),
            (s: String, at: Int): Int => fixedNext(s, at),
            (s: String, at: Int): Int => fixedPrev(s, at)
        )
        e.setStyled(
            (s: String, size: Float, weight: Int, italic: Bool, tracking: Float): Float => monoMeasureStyle(s, size, weight, italic, tracking),
            (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool, weight: Int, italic: Bool, lineHeight: Float, tracking: Float): Array<TextRow> => monoRowsStyled(s, size, width, wrap, lines, ell, weight, italic, lineHeight, tracking)
        )
        e.setRich(
            (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool, spans: Array<TextSpan>, lineHeight: Float): RichRows => monoRichRows(s, size, width, wrap, lines, ell, spans, lineHeight)
        )
        return e
    }

    /**
     * Install a styled shaper. Until this is called, the styled methods delegate
     * to the plain functions and ignore the style lanes.
     */
    pub fn setStyled(
        m: fn(String, Float, Int, Bool, Float): Float,
        r: fn(String, Float, Float, Bool, Int, Bool, Int, Bool, Float, Float): Array<TextRow>
    ) {
        this.styledMeasureFn = m
        this.styledRowsFn = r
    }

    /** Install a shaper that also returns the shaped runs for inline spans. */
    pub fn setRich(r: fn(String, Float, Float, Bool, Int, Bool, Array<TextSpan>, Float): RichRows) {
        this.richRowsFn = r
    }

    /** Width of one unwrapped line. */
    pub fn measure(s: String, size: Float): Float {
        return this.measureFn(s, size)
    }

    /** Width of one unwrapped line with an explicit weight, italic, and tracking. */
    pub fn measureStyled(s: String, size: Float, weight: Int, italic: Bool, tracking: Float): Float {
        return this.styledMeasureFn(s, size, weight, italic, tracking)
    }

    /** Character index after the grapheme that starts at `at`. */
    pub fn nextGrapheme(s: String, at: Int): Int {
        return this.nextFn(s, at)
    }

    /** Character index of the grapheme boundary before `at`. */
    pub fn prevGrapheme(s: String, at: Int): Int {
        return this.prevFn(s, at)
    }

    /** Break `s` into rows. `maxWidth <= 0` disables wrapping and ellipsis. */
    pub fn rows(
        s: String,
        size: Float,
        maxWidth: Float,
        wrap: Bool,
        maxLines: Int,
        ellipsis: Bool
    ): Array<TextRow> {
        return this.rowsFn(s, size, maxWidth, wrap, maxLines, ellipsis)
    }

    /**
     * Break `s` into rows with an explicit style. `lineHeight` is `0.0` for the
     * normal spacing or a multiplier of the font size.
     */
    pub fn rowsStyled(
        s: String,
        size: Float,
        maxWidth: Float,
        wrap: Bool,
        maxLines: Int,
        ellipsis: Bool,
        weight: Int,
        italic: Bool,
        lineHeight: Float,
        tracking: Float
    ): Array<TextRow> {
        return this.styledRowsFn(s, size, maxWidth, wrap, maxLines, ellipsis, weight, italic, lineHeight, tracking)
    }

    /** Break `s` into rows and shaped runs with inline spans. */
    pub fn richRows(
        s: String,
        size: Float,
        maxWidth: Float,
        wrap: Bool,
        maxLines: Int,
        ellipsis: Bool,
        spans: Array<TextSpan>,
        lineHeight: Float
    ): RichRows {
        return this.richRowsFn(s, size, maxWidth, wrap, maxLines, ellipsis, spans, lineHeight)
    }
}

/** The laid-out rows of one node, computed once per measure pass. */
class TextLayout {
    let rows: Array<TextRow>
    let height: Float
    let width: Float
    let runs: Array<TextRun>

    init(rows: Array<TextRow>, height: Float, width: Float, runs: Array<TextRun> = []) {
        this.rows = rows
        this.height = height
        this.width = width
        this.runs = runs
    }
}

/** The visible window of a virtual list. */
pub class VirtualRange {
    let node: Node
    let first: Int
    let count: Int
    let offset: Float

    init(node: Node, first: Int, count: Int, offset: Float) {
        this.node = node
        this.first = first
        this.count = count
        this.offset = offset
    }
}

/**
 * Named keyboard chords. A chord is normalized to lower case, so `Ctrl+S` and
 * `ctrl+s` are the same binding. The last bind for a chord replaces the
 * previous handler; the return value says whether it replaced one.
 */
pub class Shortcuts {
    let keys: Array<String> = []
    let handlers: Array<fn(): Void> = []
    let scopes: Array<Int> = []
    let current: Int = -1
    let nextScope: Array<Int> = []
    let counter: Int = 0

    fn norm(chord: String): String {
        return chord.trim().toLowerCase()
    }

    pub fn bind(chord: String, run: fn(): Void): Bool {
        return this.bindScoped(-1, chord, run)
    }

    pub fn bindScoped(scope: Int, chord: String, run: fn(): Void): Bool {
        let k = this.norm(chord)
        if k == "" {
            return false
        }
        let i = 0
        while i < this.keys.length() {
            if this.keys[i] == k && this.scopes[i] == scope {
                this.handlers[i] = run
                return true
            }
            i += 1
        }
        this.keys.push(k)
        this.handlers.push(run)
        this.scopes.push(scope)
        return false
    }

    /** Push a scope that shadows global chords until it is popped. */
    pub fn pushScope(): Int {
        this.counter += 1
        this.nextScope.push(this.current)
        this.current = this.counter
        return this.current
    }

    pub fn popScope() {
        if this.nextScope.length() == 0 {
            return
        }
        let last = this.nextScope.length() - 1
        let prev = this.nextScope[last]
        this.nextScope.pop()
        this.current = prev
    }

    pub fn scope(): Int {
        return this.current
    }

    fn runIn(scope: Int, k: String): Bool {
        let i = 0
        while i < this.keys.length() {
            if this.keys[i] == k && this.scopes[i] == scope {
                this.handlers[i]()
                return true
            }
            i += 1
        }
        return false
    }

    pub fn run(chord: String): Bool {
        let k = this.norm(chord)
        if this.current != -1 && this.runIn(this.current, k) {
            return true
        }
        return this.runIn(-1, k)
    }

    pub fn clear() {
        this.keys = []
        this.handlers = []
        this.scopes = []
        this.current = -1
        this.nextScope = []
        this.counter = 0
    }

    pub fn len(): Int {
        return this.keys.length()
    }
}

/** The arena. Ids are creation order until keyed reconciliation lands. */
/** A typed drag payload. `kind` selects which drop targets accept it. */
pub class DragData {
    let kind: String = ""
    let text: String = ""

    init(kind: String, text: String) {
        this.kind = kind
        this.text = text
    }

    /** True when a comma-separated accept list contains this kind or `*`. */
    pub fn accepts(kinds: String): Bool {
        if kinds == "*" {
            return true
        }
        let parts = kinds.split(",")
        let i = 0
        while i < parts.length() {
            let part = parts[i].trim()
            if part == "*" || part == this.kind {
                return true
            }
            i += 1
        }
        return false
    }
}

pub class Tree {
    let role: Array<Int> = []
    let name: Array<String> = []
    let key: Array<String> = []
    let live: Array<Bool> = []
    let claimed: Array<Bool> = []
    let parent: Array<Int> = []
    let first: Array<Int> = []
    let next: Array<Int> = []
    let last: Array<Int> = []
    let count: Array<Int> = []
    let actions: Array<Int> = []
    let value: Array<String> = []
    let checked: Array<Bool> = []
    let handler: Array<Int> = []
    let handlers: Array<fn(): Void> = []
    let textHandler: Array<Int> = []
    let textHandlers: Array<fn(String): Void> = []
    let richHandler: Array<Int> = []
    let richHandlers: Array<fn(String, Array<TextSpan>): Void> = []
    let canvasHandler: Array<Int> = []
    let canvasHandlers: Array<fn(Canvas): Void> = []
    let numberHandler: Array<Int> = []
    let numberHandlers: Array<fn(Float): Void> = []
    let dragKindV: Array<String> = []
    let dragTextV: Array<String> = []
    let dropKindsV: Array<String> = []
    let dropHandlerV: Array<Int> = []
    let dropHandlers: Array<fn(DragData): Void> = []
    let fixedW: Array<Int> = []
    let fixedH: Array<Int> = []
    let textAlignV: Array<Int> = []
    let textLines: Array<Int> = []
    let textWrapV: Array<Bool> = []
    let textLayoutV: Array<TextLayout> = []
    let textCacheTextV: Array<String> = []
    let textCacheSigV: Array<Int> = []
    let textSpansV: Array<Array<TextSpan>> = []
    let engine: TextEngine
    let prevX: Array<Int> = []
    let prevY: Array<Int> = []
    let prevW: Array<Int> = []
    let prevH: Array<Int> = []
    let prevName: Array<String> = []
    let prevValue: Array<String> = []
    let prevChecked: Array<Bool> = []
