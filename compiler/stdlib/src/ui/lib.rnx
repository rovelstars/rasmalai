test fn orderSortsSiblings() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.gap(0)
    let late = b.text("late")
    late.fixedHeight(20)
    late.order(2)
    let early = b.text("early")
    early.fixedHeight(20)
    early.order(0)
    let middle = b.text("middle")
    middle.fixedHeight(20)
    middle.order(1)
    root.addChild(late)
    root.addChild(early)
    root.addChild(middle)
    t.endFrame()
    t.layout(root, 200)
    assert(t.first[root.id] == early.id, "order zero is first")
    assert(t.y[early.id] == 0, "first child at the top")
    assert(t.y[middle.id] == 20, "second child next")
    assert(t.y[late.id] == 40, "third child last")
}

