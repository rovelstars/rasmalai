    image.aspectRatio(2.0)
    root.addChild(image)
    t.endFrame()
    t.layout(root, 300)
    assert(t.w[image.id] == 200, "fixed width stays")
    assert(t.h[image.id] == 100, "height follows the two to one ratio: " + t.h[image.id].toString())
}

test fn alignSelfOverridesParent() {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    let b = new Build(t)
    let root = b.column()
    root.padding(0)
    root.alignCross(Align.start)
    let left = b.text("left")
    left.fixedWidth(50)
    left.fixedHeight(20)
    let right = b.text("right")
    right.fixedWidth(50)
    right.fixedHeight(20)
    right.alignSelf(Align.end)
    let wide = b.text("wide")
    wide.fixedHeight(20)
    wide.alignSelf(Align.stretch)
    root.addChild(left)
    root.addChild(right)
    root.addChild(wide)
    t.endFrame()
    t.layout(root, 200)
    assert(t.x[left.id] == 0, "start child stays left")
    assert(t.x[right.id] == 150, "end child moves right: " + t.x[right.id].toString())
    assert(t.w[wide.id] == 200, "stretch child fills the width")
}

