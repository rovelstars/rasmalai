//! Names every compilation unit sees without an import.
//!
//! Foundation declarations come from `@std/foundation` and are re-exported
//! here, so `Int`, `Float`, `FastFloat`, `Bool`, `String`, `Char`, `Array`,
//! `Map`, `Set`, `Error`, `Any`, `Void`, `GenRef`, `Result`, `Iterator`,
//! `Iterable`, and `ArrayIter` stay ambient. An explicit declaration or an
//! import always shadows a prelude name.
//!
//! `Date`, `Promise`, `PromiseWithResolvers`, `PromiseResult`, and `RnxHost`
//! are re-exported from `@std/time`, `@std/async`, and `@std/env`. The
//! print family comes from `@std/io` and the log family from `@std/log`; a
//! target prelude can pick a different set.
//!
//! `IO`, `Thread`, and `ThreadPool` are catalog stubs declared here, so a
//! prelude that omits them makes those names unavailable. `Pointer` and
//! `Address` remain compiler builtins, and `Null` is a language builtin
//! with no declaration.
export {
    Int,
    Float,
    FastFloat,
    Bool,
    String,
    Char,
    Array,
    Map,
    Set,
    Error,
    Any,
    Void,
    GenRef,
    Result,
    Iterator,
    Iterable,
    ArrayIter
} from "@std/foundation";
export { Date } from "@std/time";
export {
    Promise,
    PromiseWithResolvers,
    PromiseResult
} from "@std/async";
export { RnxHost } from "@std/env";
export {
    print,
    println,
    eprint,
    eprintln
} from "@std/io";
export {
    log,
    debug,
    info,
    warn,
    error
} from "@std/log";

/** Standard input, output, and error streams. Catalog stub: the frontend
 * lowers `IO.print` and friends to the runtime, so the class has no
 * members here. */
pub class IO {}

/** OS thread handle. Catalog stub: `Thread.spawn` is compiler-lowered. */
pub class Thread {}

/** Bounded worker pool. Catalog stub: `ThreadPool.new` and friends are
 * compiler-lowered. */
pub class ThreadPool {}
