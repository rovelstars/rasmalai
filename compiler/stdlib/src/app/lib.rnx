//! The app framework.
//!
//! Windows, GPU, and text live behind wrappers in `wrappers/`. Each wrapper is
//! a Rust crate with a hand-written C header; `rnx task wrappers` regenerates
//! the imports from those headers, and the curated surface below is what the
//! runtime calls.
//!
//! An app owns its surface. `App.frame` builds a tree and encodes a display
//! list; `App.tick` hands that list to the renderer and returns the pixels. No
//! frame, damage, or present call reaches app code.

import { ByteBuffer } from "@std/bytes"
import { Build, Damage, Display, DisplayList, FrameClock, Key, Node, Painter, Role, Shortcuts, TextEngine, TextRow, Theme, Tree, rgba } from "@std/ui"
import { Clock } from "@std/time"
import {
    fn parley_layout(text: Pointer<Byte>, len: Int, size: Float, maxWidth: Float, maxLines: Int, wrap: Int, ellipsis: Int, out: Pointer<Byte>, cap: Int): Int as parleyLayout,
    fn parley_grapheme_next(text: Pointer<Byte>, len: Int, at: Int): Int as parleyGraphemeNext,
    fn parley_grapheme_prev(text: Pointer<Byte>, len: Int, at: Int): Int as parleyGraphemePrev,
    fn parley_measure(text: Pointer<Byte>, len: Int, size: Float): Float as parleyMeasure,
} from native "parley_cabi"
import {
    fn cpu_abi_version(): Int as cpuAbiVersion,
    fn cpu_render(w: Int, h: Int, list: Pointer<Byte>, len: Int, out: Pointer<Byte>): Int as cpuRender,
} from native "cpu_cabi"
import {
    fn host_abi_version(): Int as hostAbiVersion,
    fn host_close(h: Pointer<Byte>) as hostClose,
    fn host_event_a(h: Pointer<Byte>): Int as hostEventA,
    fn host_event_b(h: Pointer<Byte>): Int as hostEventB,
    fn host_height(h: Pointer<Byte>): Int as hostHeight,
    fn host_open(title: Pointer<Byte>, titleLen: Int, width: Int, height: Int, backend: Int): Pointer<Byte> as hostOpen,
    fn host_present(h: Pointer<Byte>, list: Pointer<Byte>, len: Int, damage: Pointer<Int>, count: Int): Int as hostPresent,
    fn host_pump_timeout(h: Pointer<Byte>, block: Int): Int as hostPumpTimeout,
    fn host_render_offscreen(w: Int, h: Int, list: Pointer<Byte>, len: Int, out: Pointer<Byte>): Int as hostRenderOffscreen,
    fn host_width(h: Pointer<Byte>): Int as hostWidth,
} from native "host_cabi"

/** The GPU backend an app asks for. Auto prefers Vulkan and falls back to GL. */
pub enum Renderer {
    auto,
    vulkan,
    gles,
}

fn rendererId(r: Renderer): Int {
    if r == Renderer.vulkan { return 1 }
    if r == Renderer.gles { return 2 }
    return 0
}

pub fn abiVersion(): Int {
    return 3
}

pub fn rendererVersion(): Int {
    let v = 0
    unsafe {
        v = hostAbiVersion()
    }
    return v
}

/** Width of shaped text at `size`, in device pixels. */
pub fn measureText(s: String, size: Float): Float {
    if s == "" {
        return 0.0
    }
    let bytes = ByteBuffer.fromString(s)
    let w = 0.0
    unsafe {
        w = parleyMeasure(Pointer.fromAddress<Byte>(bytes.address()), bytes.length(), size)
    }
    return w
}

/**
 * The parley-backed text backend. One instance per app so the scratch buffer
 * and the shaping context are reused across frames.
 */
class ParleyText {
    let buf: ByteBuffer = ByteBuffer.allocate(16 * 24)

    fn ensure(bytes: Int) {
        if this.buf.length() < bytes {
            this.buf = ByteBuffer.allocate(bytes)
        }
    }

    fn nextGrapheme(s: String, at: Int): Int {
        if s == "" {
            return 0
        }
        let b = ByteBuffer.fromString(s)
        let n = 0
        unsafe {
            n = parleyGraphemeNext(Pointer.fromAddress<Byte>(b.address()), b.length(), at)
        }
        return n
    }

    fn prevGrapheme(s: String, at: Int): Int {
        if s == "" {
            return 0
        }
        let b = ByteBuffer.fromString(s)
        let n = 0
        unsafe {
            n = parleyGraphemePrev(Pointer.fromAddress<Byte>(b.address()), b.length(), at)
        }
        return n
    }

    fn measure(s: String, size: Float): Float {
        if s == "" {
            return 0.0
        }
        let bytes = ByteBuffer.fromString(s)
        let w = 0.0
        unsafe {
            w = parleyMeasure(Pointer.fromAddress<Byte>(bytes.address()), bytes.length(), size)
        }
        return w
    }

    fn rows(
        s: String,
        size: Float,
        maxWidth: Float,
        wrap: Bool,
        maxLines: Int,
        ellipsis: Bool
    ): Array<TextRow> {
        let rows: Array<TextRow> = []
        if s == "" {
            return rows
        }
        let bytes = ByteBuffer.fromString(s)
        let wf = 0
        if wrap {
            wf = 1
        }
        let ef = 0
        if ellipsis {
            ef = 1
        }
        let n = 0
        this.ensure(16 * 24)
        unsafe {
            n = parleyLayout(
                Pointer.fromAddress<Byte>(bytes.address()),
                bytes.length(),
                size,
                maxWidth,
                maxLines,
                wf,
                ef,
                Pointer.fromAddress<Byte>(this.buf.address()),
                this.buf.length(),
            )
        }
        if n <= 0 {
            return rows
        }
        if n * 24 > this.buf.length() {
            this.ensure(n * 24)
            unsafe {
                n = parleyLayout(
                    Pointer.fromAddress<Byte>(bytes.address()),
                    bytes.length(),
                    size,
                    maxWidth,
                    maxLines,
                    wf,
                    ef,
                    Pointer.fromAddress<Byte>(this.buf.address()),
                    this.buf.length(),
                )
            }
            if n <= 0 {
                return rows
            }
        }
        let i = 0
        while i < n {
            let o = i * 24
            let start = this.buf.readUInt32LE(o)
            let end = this.buf.readUInt32LE(o + 4)
            let flags = this.buf.readUInt32LE(o + 8)
            let width = this.buf.readFloat32LE(o + 12)
            let height = this.buf.readFloat32LE(o + 16)
            let baseline = this.buf.readFloat32LE(o + 20)
            let text = s.slice(start, end)
            let ellipsized = (flags & 1) != 0
            if ellipsized {
                text = text + "…"
            }
            rows.push(TextRow(
                text: text,
                width: width,
                height: height,
                baseline: baseline,
                ellipsized: ellipsized,
            ))
            i += 1
        }
        return rows
    }
}

/** The app's one window. On runixOS Epiclese owns the surface, not the app. */
pub class Window {
    let title: String
    let width: Int
    let height: Int

    init(title: String, width: Int, height: Int) {
        this.title = title
        this.width = width
        this.height = height
    }
}

/** One encoded frame: the display list plus the semantic snapshot that made it. */
pub class Frame {
    let index: Int
    let list: ByteBuffer
    let snapshot: String
    let damageList: Damage

    init(index: Int, list: ByteBuffer, snapshot: String, damageList: Damage) {
        this.index = index
        this.list = list
        this.snapshot = snapshot
        this.damageList = damageList
    }

    pub fn damage(): Damage {
        return this.damageList
    }

    pub fn records(): Int {
        return this.list.readUInt32LE(8)
    }

    /** The display list in text form, for tests and the inspector. */
    pub fn describe(): String {
        return Display.textOf(this.list)
    }

    pub fn bytes(): Int {
        return this.list.length()
    }
}

/** RGBA8 pixels owned by the app, plus the list that produced them. */
pub class Surface {
    let width: Int
    let height: Int
    let pixels: ByteBuffer
    let list: ByteBuffer
    let usedBackend: Int = 0

    init(width: Int, height: Int, list: ByteBuffer) {
        this.width = width
        this.height = height
        this.pixels = ByteBuffer.allocate(width * height * 4)
        this.list = list
    }

    /** Render on the GPU, falling back to the CPU when no device answers. */
    pub fn draw(): Int {
        let rc = 0
        unsafe {
            rc = hostRenderOffscreen(
                this.width,
                this.height,
                Pointer.fromAddress<Byte>(this.list.address()),
                this.list.length(),
                Pointer.fromAddress<Byte>(this.pixels.address()),
            )
        }
        if rc == -2 || rc == -3 || rc == -5 || rc == -7 || rc == -8 || rc == -9 {
            rc = this.drawCpu()
        } else if rc == 0 {
            this.usedBackend = 1
        }
        return rc
    }

    /** Force the CPU renderer. Zero on success. */
    pub fn drawCpu(): Int {
        let rc = 0
        unsafe {
            rc = cpuRender(
                this.width,
                this.height,
                Pointer.fromAddress<Byte>(this.list.address()),
                this.list.length(),
                Pointer.fromAddress<Byte>(this.pixels.address()),
            )
        }
        if rc == 0 {
            this.usedBackend = 2
        }
        return rc
    }

    /** Raw RGBA8 pixels, row-major. For dumps and tests. */
    pub fn pixels(): ByteBuffer {
        return this.pixels
    }

    /** 1 after a GPU draw, 2 after a CPU draw, 0 before any draw. */
    pub fn backend(): Int {
        return this.usedBackend
    }

    /** One pixel as `0xRRGGBBAA`. */
    pub fn pixel(x: Int, y: Int): Int {
        let at = (y * this.width + x) * 4
        return rgba(
            this.pixels.readUInt8(at),
            this.pixels.readUInt8(at + 1),
            this.pixels.readUInt8(at + 2),
            this.pixels.readUInt8(at + 3),
        )
    }

    pub fn records(): Int {
        return this.list.readUInt32LE(8)
    }

    /** The display list in text form, for tests and the inspector. */
    pub fn describe(): String {
        return Display.textOf(this.list)
    }

    pub fn rgbaAt(x: Int, y: Int): String {
        let at = (y * this.width + x) * 4
        return this.pixels.readUInt8(at).toString() + "," + this.pixels.readUInt8(at + 1).toString() + "," + this.pixels.readUInt8(at + 2).toString() + "," + this.pixels.readUInt8(at + 3).toString()
    }
}

/**
 * An app: a window, a theme, and a view function. The view runs again on every
 * frame, because the MVP tree is append-only and reconciliation is not here yet.
 */
pub class App {
    let window: Window
    let theme: Theme
    let view: fn(Build): Node
    let rootTree: Tree
    let frames: Int = 0
    let status: Int = 0
    let rendererChoice: Renderer
    let frameClock: FrameClock = new FrameClock()
    let animatingFlag: Bool = true
    let damageOverlay: Bool = false
    let lastW: Int = 0
    let lastH: Int = 0
    let textEngine: TextEngine
    let shortcuts: Shortcuts = new Shortcuts()
    let modifiers: Int = 0
    let pointerX: Int = 0
    let pointerY: Int = 0

    init(w: Window, th: Theme, v: fn(Build): Node) {
        this.window = w
        this.theme = th
        this.view = v
        this.rendererChoice = Renderer.auto
        let text = new ParleyText()
        this.textEngine = new TextEngine(
            (s: String, size: Float): Float => text.measure(s, size),
            (s: String, size: Float, width: Float, wrap: Bool, lines: Int, ell: Bool): Array<TextRow> => text.rows(s, size, width, wrap, lines, ell),
            (s: String, at: Int): Int => text.nextGrapheme(s, at),
            (s: String, at: Int): Int => text.prevGrapheme(s, at),
        )
        this.rootTree = new Tree(this.textEngine)
        let app = this
        this.shortcuts.bind("tab", () => { app.focusNext() })
        this.shortcuts.bind("shift+tab", () => {
            let prev = app.rootTree.focusPrev()
            if prev != -1 {
                app.rootTree.focusOn(Node(tree: app.rootTree, id: prev))
            }
        })
    }

    static launch(title: String, width: Int, height: Int, view: fn(Build): Node): App {
        return new App(new Window(title, width, height), Theme.dark(), view)
    }

    static launchWith(r: Renderer, title: String, width: Int, height: Int, view: fn(Build): Node): App {
        let app = new App(new Window(title, width, height), Theme.dark(), view)
        app.rendererChoice = r
        return app
    }

    /** Change the backend before the first GPU call. One backend per process. */
    pub fn setRenderer(r: Renderer) {
        this.rendererChoice = r
    }

    pub fn renderer(): Renderer {
        return this.rendererChoice
    }

    /**
     * Ask for continuous frames. While animating, the window draws as fast as
     * the compositor accepts frames. While paused, it draws once per input
     * event and sleeps otherwise, and the frame clock stops advancing.
     */
    pub fn setAnimating(on: Bool) {
        if this.animatingFlag == on {
            return
        }
        this.animatingFlag = on
        this.frameClock.setPaused(!on)
    }

    pub fn animating(): Bool {
        return this.animatingFlag
    }

    /** Time source for the view. Ticked once per frame by `App.frame`. */
    pub fn clock(): FrameClock {
        return this.frameClock
    }

    /** Outline changed regions, like the show-surface-updates developer flag. */
    pub fn setDamageOverlay(on: Bool) {
        this.damageOverlay = on
    }

    /** Bind a named chord such as `ctrl+s` or `f1`. */
    pub fn bind(chord: String, run: fn(): Void) {
        this.shortcuts.bind(chord, run)
    }

    pub fn shortcuts(): Shortcuts {
        return this.shortcuts
    }

    /** Build the tree, lay it out, and encode a full frame. */
    pub fn frame(): Frame {
        return this.buildFrame(false)
    }

    /** Encode only the damaged regions. The host paints those into the target. */
    fn framePresent(): Frame {
        return this.buildFrame(true)
    }

    fn buildFrame(regions: Bool): Frame {
        this.frameClock.tick(Clock.mono().nanos)
        this.rootTree.beginFrame()
        let b = new Build(this.rootTree)
        b.setClock(this.frameClock)
        b.animate(this.animatingFlag)
        let root = this.view(b)
        this.setAnimating(b.animating())
        this.rootTree.endFrame()
        this.rootTree.layout(root, this.window.width)
        let full = this.frames == 0 || this.window.width != this.lastW || this.window.height != this.lastH
        this.lastW = this.window.width
        this.lastH = this.window.height
        let damage = this.rootTree.damageOf(this.window.width, this.window.height, full)
        this.frames += 1
        let d = DisplayList.createDefault()
        if regions {
            d = Painter.paintRegions(this.rootTree, this.window.width, this.window.height, this.theme, damage)
        } else {
            d = Painter.paint(this.rootTree, this.window.width, this.window.height, this.theme)
        }
        if this.damageOverlay {
            Painter.paintDamage(d, damage, rgba(255, 0, 220, 255))
        }
        let list = d.finish(this.window.width, this.window.height)
        return new Frame(this.frames, list, this.rootTree.snapshot(), damage)
    }

    /** Render an encoded frame into a new surface. */
    pub fn draw(f: Frame): Surface {
        let s = new Surface(this.window.width, this.window.height, f.list)
        this.status = s.draw()
        return s
    }

    /** Encode one frame and render it into a new surface. */
    pub fn tick(): Surface {
        return this.draw(this.frame())
    }

    pub fn tree(): Tree {
        return this.rootTree
    }

    pub fn lastStatus(): Int {
        return this.status
    }

    pub fn pointerDown(x: Int, y: Int): Bool {
        return this.rootTree.pointerDown(x, y)
    }

    pub fn pointerMove(x: Int, y: Int): Bool {
        return this.rootTree.pointerMove(x, y)
    }

    pub fn pointerUp(x: Int, y: Int): Bool {
        return this.rootTree.pointerUp(x, y)
    }

    pub fn scrollAt(x: Int, y: Int, dy: Float): Bool {
        return this.rootTree.scrollAt(x, y, dy)
    }

    /** Route a key to the focused node, focusing the first control if none is. */
    pub fn keyDown(k: Key): Bool {
        let id = this.rootTree.focused()
        if id < 0 {
            id = this.rootTree.focusNext()
        }
        if id < 0 {
            return false
        }
        return this.rootTree.keyDown(Node(tree: this.rootTree, id: id), k)
    }

    pub fn focusNext(): Int {
        return this.rootTree.focusNext()
    }

    fn keyName(code: Int): String {
        if code == 1 { return "escape" }
        if code == 15 { return "tab" }
        if code == 28 { return "enter" }
        if code == 57 { return "space" }
        if code == 14 { return "backspace" }
        if code == 111 { return "delete" }
        if code == 102 { return "home" }
        if code == 107 { return "end" }
        if code == 104 { return "pageup" }
        if code == 109 { return "pagedown" }
        if code == 103 { return "up" }
        if code == 105 { return "left" }
        if code == 106 { return "right" }
        if code == 108 { return "down" }
        if code == 59 { return "f1" }
        if code == 60 { return "f2" }
        if code == 61 { return "f3" }
        if code == 62 { return "f4" }
        if code == 63 { return "f5" }
        if code == 64 { return "f6" }
        if code == 65 { return "f7" }
        if code == 66 { return "f8" }
        if code == 67 { return "f9" }
        if code == 68 { return "f10" }
        if code == 87 { return "f11" }
        if code == 88 { return "f12" }
        return this.appKeyChar(code, false)
    }

    fn appKeyChar(code: Int, shift: Bool): String {
        let lower = ""
        if code >= 16 && code <= 25 {
            lower = "qwertyuiop".slice(code - 16, code - 15)
        } else if code >= 30 && code <= 38 {
            lower = "asdfghjkl".slice(code - 30, code - 29)
        } else if code >= 44 && code <= 50 {
            lower = "zxcvbnm".slice(code - 44, code - 43)
        } else if code >= 2 && code <= 11 {
            lower = "1234567890".slice(code - 2, code - 1)
        } else if code == 12 {
            lower = "-"
        } else if code == 13 {
            lower = "="
        } else if code == 26 {
            lower = "["
        } else if code == 27 {
            lower = "]"
        } else if code == 39 {
            lower = ";"
        } else if code == 40 {
            lower = "'"
        } else if code == 41 {
            lower = "`"
        } else if code == 43 {
            lower = "\\"
        } else if code == 51 {
            lower = ","
        } else if code == 52 {
            lower = "."
        } else if code == 53 {
            lower = "/"
        } else if code == 57 {
            return " "
        }
        if lower == "" {
            return ""
        }
        if !shift {
            return lower
        }
        let upper = lower.toUpperCase()
        if upper != lower {
            return upper
        }
        if lower == "1" { return "!" }
        if lower == "2" { return "@" }
        if lower == "3" { return "#" }
        if lower == "4" { return "$" }
        if lower == "5" { return "%" }
        if lower == "6" { return "^" }
        if lower == "7" { return "&" }
        if lower == "8" { return "*" }
        if lower == "9" { return "(" }
        if lower == "0" { return ")" }
        if lower == "-" { return "_" }
        if lower == "=" { return "+" }
        if lower == "[" { return "\{" }
        if lower == "]" { return "}" }
        if lower == ";" { return ":" }
        if lower == "'" { return "\"" }
        if lower == "`" { return "~" }
        if lower == "\\" { return "|" }
        if lower == "," { return "<" }
        if lower == "." { return ">" }
        if lower == "/" { return "?" }
        return lower
    }

    fn chordFor(code: Int): String {
        let name = this.keyName(code)
        if name == "" {
            return ""
        }
        let out = ""
        if (this.modifiers & 1) != 0 { out = out + "ctrl+" }
        if (this.modifiers & 2) != 0 { out = out + "alt+" }
        if (this.modifiers & 4) != 0 { out = out + "shift+" }
        if (this.modifiers & 8) != 0 { out = out + "meta+" }
        return out + name
    }

    /** Feed an evdev key code. Tests and automation use this instead of a window. */
    pub fn sendKey(code: Int, down: Bool) {
        this.keyEvent(code, down)
    }

    fn keyEvent(code: Int, down: Bool) {
        let bit = 0
        if code == 29 || code == 97 {
            bit = 1
        } else if code == 56 || code == 100 {
            bit = 2
        } else if code == 42 || code == 54 {
            bit = 4
        } else if code == 125 || code == 126 {
            bit = 8
        }
        if bit != 0 {
            if down {
                this.modifiers = this.modifiers | bit
            } else {
                this.modifiers = this.modifiers & (0 - 1 - bit)
            }
            return
        }
        if !down {
            return
        }
        let chord = this.chordFor(code)
        if chord != "" && this.shortcuts.run(chord) {
            return
        }
        if code == 15 {
            if (this.modifiers & 4) != 0 {
                this.rootTree.focusPrev()
            } else {
                this.focusNext()
            }
            return
        }
        let id = this.rootTree.focused()
        if id < 0 {
            return
        }
        let node = Node(tree: this.rootTree, id: id)
        if code == 14 {
            this.keyDown(Key.backspace)
            return
        }
        if code == 111 {
            this.keyDown(Key.delete)
            return
        }
        if code == 102 {
            this.keyDown(Key.home)
            return
        }
        if code == 107 {
            this.keyDown(Key.end)
            return
        }
        if code == 103 {
            this.keyDown(Key.up)
            return
        }
        if code == 105 {
            this.keyDown(Key.left)
            return
        }
        if code == 106 {
            this.keyDown(Key.right)
            return
        }
        if code == 108 {
            this.keyDown(Key.down)
            return
        }
        if code == 28 {
            this.keyDown(Key.enter)
            return
        }
        if (this.modifiers & (1 | 2 | 8)) == 0 {
            let ch = this.appKeyChar(code, (this.modifiers & 4) != 0)
            if ch != "" && this.rootTree.role[id] == 11 {
                this.rootTree.typeText(node, ch)
                return
            }
        }
        if code == 57 {
            this.keyDown(Key.space)
        }
        if code == 1 {
            if this.rootTree.firstRole(Role.dialog) != -1 {
                this.keyDown(Key.escape)
            }
        }
    }

    fn runHost(limit: Int): Int {
        let title = ByteBuffer.fromString(this.window.title)
        unsafe {
            let host = hostOpen(
                Pointer.fromAddress<Byte>(title.address()),
                title.length(),
                this.window.width,
                this.window.height,
                rendererId(this.rendererChoice),
            )
            if hostWidth(host) < 0 {
                return -1
            }
            let done = false
            let count = 0
            let status = 0
            let dirty = true
            while !done {
                if this.animatingFlag || dirty || limit > 0 {
                    let f = this.framePresent()
                    let dn = f.damage().count()
                    let dmg = ByteBuffer.allocate(dn * 16)
                    let di = 0
                    while di < dn {
                        dmg.writeInt32LE(di * 16, f.damage().xAt(di))
                        dmg.writeInt32LE(di * 16 + 4, f.damage().yAt(di))
                        dmg.writeInt32LE(di * 16 + 8, f.damage().wAt(di))
                        dmg.writeInt32LE(di * 16 + 12, f.damage().hAt(di))
                        di += 1
                    }
                    let rc = hostPresent(
                        host,
                        Pointer.fromAddress<Byte>(f.list.address()),
                        f.list.length(),
                        Pointer.fromAddress<Int>(dmg.address()),
                        dn,
                    )
                    dirty = false
                    if rc < 0 && rc != -4 {
                        status = rc
                        done = true
                    } else if rc == 0 {
                        count += 1
                    }
                    if limit > 0 && count >= limit {
                        done = true
                    }
                }
                if done {
                    continue
                }
                let wait = 1
                if this.animatingFlag || limit > 0 {
                    wait = 0
                }
                let ev = hostPumpTimeout(host, wait)
                if ev == 1 {
                    done = true
                } else if ev == 2 || ev == 8 {
                    this.window.width = hostWidth(host)
                    this.window.height = hostHeight(host)
                    dirty = true
                } else if ev == 3 {
                    this.pointerX = hostEventA(host)
                    this.pointerY = hostEventB(host)
                    this.pointerDown(this.pointerX, this.pointerY)
                    dirty = true
                } else if ev == 4 {
                    this.pointerUp(hostEventA(host), hostEventB(host))
                    dirty = true
                } else if ev == 5 {
                    this.pointerX = hostEventA(host)
                    this.pointerY = hostEventB(host)
                    if this.pointerMove(this.pointerX, this.pointerY) {
                        dirty = true
                    }
                } else if ev == 6 {
                    let code = hostEventA(host)
                    if code == 1 && this.rootTree.firstRole(Role.dialog) == -1 {
                        done = true
                    } else {
                        this.keyEvent(code, true)
                        dirty = true
                    }
                } else if ev == 7 {
                    this.keyEvent(hostEventA(host), false)
                } else if ev == 9 {
                    if this.rootTree.scrollAt(this.pointerX, this.pointerY, Float(hostEventA(host)) * 40.0) {
                        dirty = true
                    }
                }
            }
            hostClose(host)
            return status
        }
    }

    /** Open the window and render until it closes. */
    pub fn show(): Int {
        return this.runHost(-1)
    }

    /** Open the window, render `frames` frames, then close. For smoke tests. */
    pub fn showFor(frames: Int): Int {
        return this.runHost(frames)
    }
}
