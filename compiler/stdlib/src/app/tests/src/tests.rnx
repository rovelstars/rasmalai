fn bytesEqual(a: ByteBuffer, b: ByteBuffer): Bool {
    if a.length() != b.length() {
        return false
    }
    let i = 0
    while i < a.length() {
        if a.readUInt8(i) != b.readUInt8(i) {
            return false
        }
        i += 1
    }
    return true
}

fn b0(): Build {
    let t = new Tree(TextEngine.fixed())
    t.beginFrame()
    return new Build(t)
}

/** A valid 4x2 RGBA PNG, embedded so the test needs no fixture file. */
