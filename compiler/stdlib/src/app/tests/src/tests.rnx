import { App, Renderer, Surface, measureText } from "@std/app"
import { Align, Build, Canvas, Key, Node, Role, rgba } from "@std/ui"
import { ByteBuffer } from "@std/bytes"

class Counter {
    let n: Int = 0
}

class TextState {
    let value: String = ""
}

class SliderState {
    let v: Float = 0.25
}

class KitState {
    let v: Float = 0.5
    let selected: Int = -1
}

fn widestFillOf(list: ByteBuffer, color: Int): Int {
    let n = list.readUInt32LE(8)
    let i = 0
    let best = 0
    while i < n {
        let o = 32 + i * 64
        if list.readUInt32LE(o) == 1 && list.readUInt32LE(o + 4) == color {
            let w = Int(list.readFloat64LE(o + 32))
            if w > best {
                best = w
            }
        }
        i += 1
    }
    return best
}

fn nthFillWidth(list: ByteBuffer, which: Int): Int {
    let n = list.readUInt32LE(8)
    let seen = 0
    let i = 0
    while i < n {
        let o = 32 + i * 64
        if list.readUInt32LE(o) == 1 {
            if seen == which {
                return Int(list.readFloat64LE(o + 32))
            }
            seen += 1
        }
        i += 1
    }
    return -1
}

fn firstTextX(list: ByteBuffer): Float {
    let n = list.readUInt32LE(8)
    let i = 0
    while i < n {
        let o = 32 + i * 64
        if list.readUInt32LE(o) == 2 {
            return list.readFloat64LE(o + 16)
        }
        i += 1
    }
    return -1.0
}

fn check(ok: Bool, msg: String, failed: Int): Int {
    if ok {
        return failed
    }
    print("FAIL:", msg)
    return failed + 1
}

fn Main(): Int {
    let failed = 0

    let app = App.launch("Settings", 320, 240, (b: Build): Node => {
        let root = b.column()
        root.addChild(b.heading("Appearance"))
        root.addChild(b.buttonInert("Reset"))
        return root
    })
    let first = app.frame()
    failed = check(first.records() > 0, "records encoded", failed)
    failed = check(first.bytes() > 32, "header plus body", failed)
    failed = check(first.snapshot.contains("heading Appearance"), first.snapshot, failed)

    let stable = App.launch("Stable", 200, 100, (b: Build): Node => {
        let root = b.column()
        root.addChild(b.text("stable"))
        return root
    })
    let a = stable.frame()
    let size = stable.tree().len()
    let b = stable.frame()
    failed = check(stable.tree().len() == size, "unchanged view does not append nodes", failed)
    failed = check(a.records() == b.records(), "same record count", failed)
    failed = check(b.index == a.index + 1, "frame counter advances", failed)

    failed = check(measureText("Hello", 16.0) > 0.0, "parley answered", failed)

    let chosen = App.launchWith(Renderer.gles, "GL", 100, 80, (b: Build): Node => {
        return b.column() {
            b.text("hi")
        }
    })
    failed = check(chosen.renderer() == Renderer.gles, "renderer kept", failed)
    failed = check(chosen.frame().records() > 0, "renderer frame", failed)

    let cpu = App.launch("CPU", 64, 48, (b: Build): Node => {
        return b.column() {
            b.text("hi")
        }
    })
    let cf = cpu.frame()
    let s = new Surface(64, 48, cf.list)
    failed = check(s.drawCpu() == 0, "cpu render", failed)
    failed = check(s.backend() == 2, "cpu backend recorded", failed)
    failed = check(s.rgbaAt(2, 2) == "20,22,26,255", s.rgbaAt(2, 2), failed)

    let paragraph = App.launch("Text", 200, 120, (b: Build): Node => {
        return b.column() {
            b.heading("Wrap")
            b.text("The quick brown fox jumps over the lazy dog and keeps going")
        }
    })
    let pf = paragraph.frame()
    let lines = pf.describe().split("\n")
    let runs = 0
    let li = 0
    while li < lines.length() {
        if lines[li].startsWith("text ") {
            runs += 1
        }
        li += 1
    }
    failed = check(runs >= 4, "paragraph wraps through parley: " + runs.toString(), failed)
    failed = check(pf.records() > 4, "wrapped frame has records", failed)

    let kit = new KitState()
    let kitApp = App.launch("Kit", 400, 360, (b: Build): Node => {
        b.animate(false)
        let root = b.column()
        root.addChild(b.sliderValue("Volume", kit.v, (v: Float) => { kit.v = v }))
        root.addChild(b.heading("Rows"))
        let v = b.virtualList("Rows", "rows", 20, 30, 120)
        root.addChild(v.node)
        let i = 0
        while i < v.count {
            let idx = v.first + i
            let r = b.listItem("row " + idx.toString(), () => { kit.selected = idx })
            r.fixedHeight(30)
            v.node.addChild(r)
            i += 1
        }
        root.addChild(b.text("nodes " + b.handle().len().toString()))
        return root
    })
    kitApp.frame()
    let baseNodes = kitApp.tree().len()
    let hovers = 0
    while hovers < 10 {
        kitApp.pointerMove(20 + hovers, 20)
        kitApp.frame()
        hovers += 1
    }
    failed = check(kitApp.tree().len() == baseNodes, "hover keeps the node count: " + baseNodes.toString() + " -> " + kitApp.tree().len().toString(), failed)
    let slidKit = kitApp.tree().find(Role.slider, "Volume")
    let drags = 0
    kitApp.pointerDown(kitApp.tree().x[slidKit] + 10, kitApp.tree().y[slidKit] + 36)
    while drags < 10 {
        kitApp.pointerMove(kitApp.tree().x[slidKit] + 10 + drags * 4, kitApp.tree().y[slidKit] + 36)
        kitApp.frame()
        drags += 1
    }
    failed = check(kitApp.tree().len() == baseNodes, "slider drag keeps the node count: " + baseNodes.toString() + " -> " + kitApp.tree().len().toString(), failed)
    let kitList = kitApp.tree().find(Role.list, "Rows")
    let downs = 0
    while downs < 30 {
        let batch = 0
        while batch < 5 {
            kitApp.scrollAt(kitApp.tree().x[kitList] + 2, kitApp.tree().y[kitList] + 2, 45.0)
            batch += 1
        }
        kitApp.frame()
        downs += 1
    }
    let downNodes = kitApp.tree().len()
    let downOffset = kitApp.tree().scrollOf(Node(tree: kitApp.tree(), id: kitList))
    let ups = 0
    while ups < 8 {
        let batch = 0
        while batch < 5 {
            kitApp.scrollAt(kitApp.tree().x[kitList] + 2, kitApp.tree().y[kitList] + 2, 0.0 - 45.0)
            batch += 1
        }
        kitApp.frame()
        ups += 1
    }
    let upOffset = kitApp.tree().scrollOf(Node(tree: kitApp.tree(), id: kitList))
    failed = check(upOffset < downOffset, "batched scroll up reduces the offset: " + downOffset.toString() + " -> " + upOffset.toString(), failed)
    failed = check(kitApp.tree().snapshot().contains("row 0"), "scrolled back to the top", failed)
    failed = check(kitApp.tree().len() < downNodes + 10, "scroll does not leak nodes: " + downNodes.toString() + " -> " + kitApp.tree().len().toString(), failed)

    let sliderState = new SliderState()
    let sliderApp = App.launch("Slider", 400, 200, (b: Build): Node => {
        let root = b.column()
        root.addChild(b.sliderValue("Volume", sliderState.v, (v: Float) => { sliderState.v = v }))
        return root
    })
    sliderApp.frame()
    let slid = sliderApp.tree().find(Role.slider, "Volume")
    sliderApp.pointerDown(sliderApp.tree().x[slid] + sliderApp.tree().w[slid] * 3 / 4, sliderApp.tree().y[slid] + 36)
    failed = check(sliderState.v > 0.6, "slider drag updates state: " + sliderState.v.toString(), failed)
    let sliderFrame = sliderApp.frame()
    let track = widestFillOf(sliderFrame.list, rgba(91, 141, 239, 255))
    failed = check(track > sliderApp.tree().w[slid] / 2, "slider track follows the value: " + track.toString(), failed)

    let textState = new TextState()
    let typing = App.launch("Type", 320, 120, (b: Build): Node => {
        let root = b.column()
        root.addChild(b.textField(textState.value, "name", (v: String) => { textState.value = v }))
        return root
    })
    typing.frame()
    let fieldId = typing.tree().find(Role.textbox, "name")
    let fieldNode = Node(tree: typing.tree(), id: fieldId)
    typing.tree().focusOn(fieldNode)
    typing.tree().typeText(fieldNode, "e\u{301}x")
    failed = check(typing.tree().valueOf(fieldNode) == "e\u{301}x", "typed unicode", failed)
    typing.tree().keyDown(fieldNode, Key.backspace)
    failed = check(typing.tree().valueOf(fieldNode) == "e\u{301}", "backspace removed one cluster", failed)
    typing.tree().keyDown(fieldNode, Key.backspace)
    failed = check(typing.tree().valueOf(fieldNode) == "", "backspace removed the combining pair", failed)

    let keyState = new TextState()
    let keys = App.launch("Keys", 320, 120, (b: Build): Node => {
        let root = b.column()
        root.addChild(b.textField(keyState.value, "name", (v: String) => { keyState.value = v }))
        return root
    })
    keys.frame()
    let kid = keys.tree().find(Role.textbox, "name")
    keys.tree().focusOn(Node(tree: keys.tree(), id: kid))
    keys.sendKey(30, true)
    keys.sendKey(30, false)
    keys.sendKey(42, true)
    keys.sendKey(30, true)
    keys.sendKey(42, false)
    keys.sendKey(30, false)
    failed = check(keyState.value == "aA", "shifted key input types: " + keyState.value, failed)
    keys.sendKey(14, true)
    keys.sendKey(14, false)
    failed = check(keyState.value == "a", "backspace edits the field", failed)

    let hits = [0]
    keys.bind("ctrl+s", () => { hits[0] += 1 })
    keys.sendKey(29, true)
    keys.sendKey(31, true)
    keys.sendKey(31, false)
    keys.sendKey(29, false)
    failed = check(hits[0] == 1, "app shortcut ran", failed)
    failed = check(keyState.value == "a", "shortcut did not type", failed)

    let sized = App.launch("Width", 320, 120, (b: Build): Node => {
        return b.column() {
            b.buttonInert("Save")
        }
    })
    let sizedFrame = sized.frame()
    let wantWidth = Int(measureText("Save", 14.0) + 24.999)
    let gotWidth = nthFillWidth(sizedFrame.list, 1)
    failed = check(gotWidth == wantWidth, "button width follows measured text: " + gotWidth.toString() + " vs " + wantWidth.toString(), failed)

    let clipped = App.launch("Clip", 120, 100, (b: Build): Node => {
        return b.column() {
            b.buttonInert("A very long button label that will not fit")
        }
    })
    let clipFrame = clipped.frame()
    failed = check(clipFrame.describe().contains("…"), "parley ellipsizes a clipped control", failed)

    let centered = App.launch("Center", 320, 120, (b: Build): Node => {
        let root = b.column()
        let label = b.text("mid")
        label.textAlign(Align.center)
        root.addChild(label)
        return root
    })
    let cx = firstTextX(centered.frame().list)
    failed = check(cx > 100.0, "parley rows are centered: " + cx.toString(), failed)

    let counter = new Counter()
    let damage = App.launch("Damage", 200, 120, (b: Build): Node => {
        return b.column() {
            b.text("count " + counter.n.toString())
        }
    })
    let d1 = damage.frame()
    failed = check(d1.damage().count() == 1, "first frame has one damage rect", failed)
    failed = check(d1.damage().wAt(0) == 200 && d1.damage().hAt(0) == 120, "first frame is full", failed)
    let d2 = damage.frame()
    failed = check(d2.damage().count() == 0, "unchanged frame has no damage: " + d2.damage().count().toString(), failed)
    counter.n = 1
    let d3 = damage.frame()
    failed = check(d3.damage().count() >= 1, "changed text reports damage", failed)
    failed = check(d3.damage().wAt(0) < 200, "damage is a region, not the surface", failed)

    let canv = App.launch("Canvases", 960, 470, (b: Build): Node => {
        let root = b.column()
        let row = b.row()
        row.addChild(b.canvas("a", 300, 300, (c: Canvas) => {}))
        row.addChild(b.canvas("b", 300, 300, (c: Canvas) => {}))
        row.addChild(b.canvas("c", 300, 300, (c: Canvas) => {}))
        root.addChild(row)
        return root
    })
    canv.frame()
    let c2 = canv.frame()
    failed = check(c2.damage().count() == 3, "three canvas regions: " + c2.damage().count().toString(), failed)

    let virtual = App.launch("Virtual", 320, 240, (b: Build): Node => {
        let root = b.column()
        let v = b.virtualList("rows", "rows", 10000, 30, 120)
        root.addChild(v.node)
        let i = 0
        while i < v.count {
            let r = b.listItem("row " + (v.first + i).toString(), () => {})
            r.fixedHeight(30)
            v.node.addChild(r)
            i += 1
        }
        return root
    })
    let vf1 = virtual.frame()
    failed = check(virtual.tree().len() < 15, "virtual list builds only visible rows: " + virtual.tree().len().toString(), failed)
    failed = check(vf1.snapshot.contains("row 0"), "first row is present", failed)
    failed = check(virtual.scrollAt(20, 20, 90.0), "scrolled the virtual list", failed)
    let vf2 = virtual.frame()
    failed = check(vf2.snapshot.contains("row 3"), "scrolled rows are present: " + vf2.snapshot, failed)
    failed = check(!vf2.snapshot.contains("row 0"), "offscreen row is gone", failed)
    failed = check(virtual.tree().len() < 15, "still only visible rows", failed)

    let paused = App.launch("Paused", 64, 48, (b: Build): Node => {
        return b.column() {
            b.text("still")
        }
    })
    paused.frame()
    paused.setAnimating(false)
    failed = check(!paused.animating(), "paused flag", failed)
    let frozen = paused.clock().elapsed()
    let frozenFrames = paused.clock().frames()
    paused.frame()
    failed = check(paused.clock().elapsed() == frozen, "paused clock does not advance", failed)
    failed = check(paused.clock().frames() == frozenFrames, "paused clock does not tick", failed)

    let declared = App.launch("Declared", 64, 48, (b: Build): Node => {
        b.animate(false)
        return b.column() {
            b.text("still")
        }
    })
    declared.frame()
    failed = check(!declared.animating(), "view can pause the app", failed)

    failed = check(cf.damage().count() == 1, "one damage rect", failed)
    failed = check(cf.damage().wAt(0) == 64 && cf.damage().hAt(0) == 48, "full surface damage", failed)

    if failed == 0 {
        print("app tests: ok")
    }
    return failed
}
