        0, 0, 0, 24, 73, 68, 65, 84,
        120, 218, 99, 248, 207, 192, 240, 31, 12, 25, 254, 3, 1, 3, 148, 11, 229, 128, 24, 0, 36, 12, 17, 239, 162, 10, 216, 201,
        0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,
    ])
}

fn countKind(list: DisplayList, kind: Int): Int {
    let total = 0
    let i = 0
    while i < list.recordCount() {
        if list.kindAt(i) == kind {
            total += 1
        }
        i += 1
    }
    return total
}

