import { ByteBuffer } from "@std/bytes"
import {
    fn parley_abi_version(): Int as parleyAbiVersion,
    fn parley_clusters(text: Pointer<Byte>, len: Int, size: Float, out: Pointer<Byte>, cap: Int): Int as parleyClusters,
    fn parley_grapheme_next(text: Pointer<Byte>, len: Int, at: Int): Int as parleyGraphemeNext,
    fn parley_grapheme_prev(text: Pointer<Byte>, len: Int, at: Int): Int as parleyGraphemePrev,
    fn parley_layout(text: Pointer<Byte>, len: Int, size: Float, maxWidth: Float, maxLines: Int, wrap: Int, ellipsis: Int, out: Pointer<Byte>, cap: Int): Int as parleyLayout,
    fn parley_measure(text: Pointer<Byte>, len: Int, size: Float): Float as parleyMeasure,
} from native "parley_cabi"

fn widthOf(s: String, size: Float): Float {
    let b = ByteBuffer.fromString(s)
    unsafe {
        return parleyMeasure(Pointer.fromAddress<Byte>(b.address()), b.length(), size)
    }
}

fn clustersOf(s: String, size: Float) {
    let b = ByteBuffer.fromString(s)
    let out = ByteBuffer.allocate(64 * 16)
    let n = 0
    unsafe {
        n = parleyClusters(Pointer.fromAddress<Byte>(b.address()), b.length(), size, Pointer.fromAddress<Byte>(out.address()), 64)
    }
    println!("clusters:", n)
    let i = 0
    while i < n && i < 3 {
        let o = i * 16
        println!("c", i, "range:", out.readInt32LE(o), out.readInt32LE(o + 4), "advance:", out.readFloat64LE(o + 8))
        i += 1
    }
}

fn layoutOf(s: String, size: Float, maxWidth: Float, maxLines: Int, wrap: Bool, ellipsis: Bool) {
    let b = ByteBuffer.fromString(s)
    let out = ByteBuffer.allocate(16 * 24)
    let wrapFlag = 0
    if wrap {
        wrapFlag = 1
    }
    let flag = 0
    if ellipsis {
        flag = 1
    }
    let n = 0
    unsafe {
        n = parleyLayout(Pointer.fromAddress<Byte>(b.address()), b.length(), size, maxWidth, maxLines, wrapFlag, flag, Pointer.fromAddress<Byte>(out.address()), 16 * 24)
    }
    println!("rows:", n)
    let i = 0
    while i < n {
        let o = i * 24
        println!("row", i, "chars:", out.readUInt32LE(o), out.readUInt32LE(o + 4), "flags:", out.readUInt32LE(o + 8), "width:", out.readFloat32LE(o + 12))
        i += 1
    }
}

fn Main(): Int {
    clustersOf("Hi", 16.0)
    println!("hello 16:", widthOf("Hello", 16.0))
    println!("hello 32:", widthOf("Hello", 32.0))
    println!("long 16:", widthOf("Hello world", 16.0))
    let accent = ByteBuffer.fromString("e\u{301}x")
    unsafe {
        println!("grapheme next:", parleyGraphemeNext(Pointer.fromAddress<Byte>(accent.address()), accent.length(), 0))
        println!("grapheme prev:", parleyGraphemePrev(Pointer.fromAddress<Byte>(accent.address()), accent.length(), 2))
    }
    layoutOf("hello world from rasmalai", 14.0, 90.0, 0, true, false)
    layoutOf("hello world from rasmalai", 14.0, 70.0, 1, false, true)
    unsafe {
        println!("abi:", parleyAbiVersion())
    }
    return 0
}
