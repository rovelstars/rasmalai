import { ByteBuffer } from "@std/bytes"
import {
    fn wgpu_adapter_count(p: Pointer<Byte>): Int,
    fn wgpu_adapter_name(p: Pointer<Byte>, index: Int, out: Pointer<Byte>, len: Int): Int,
    fn wgpu_clear_rgba(w: Int, h: Int, r: Int, g: Int, b: Int, a: Int, out: Pointer<Byte>): Int,
    fn wgpu_instance_create(): Pointer<Byte>,
    fn wgpu_triangle(w: Int, h: Int, out: Pointer<Byte>): Int,
    fn wgpu_abi_version(): Int,
    fn wgpu_instance_destroy(p: Pointer<Byte>),
} from native "wgpu_cabi"

fn Main(): Int {
    unsafe {
        let inst = wgpu_instance_create()
        print("adapters:", wgpu_adapter_count(inst))
        let name = ByteBuffer.allocate(256)
        let n = wgpu_adapter_name(inst, 0, Pointer.fromAddress<Byte>(name.address()), 256)
        print("name bytes:", n)
        let px = ByteBuffer.allocate(8)
        let rc = wgpu_clear_rgba(2, 1, 10, 20, 30, 255, Pointer.fromAddress<Byte>(px.address()))
        print("rc:", rc, "rgba:", px.readUInt8(0), px.readUInt8(1), px.readUInt8(2), px.readUInt8(3))
        let img = ByteBuffer.allocate(16 * 16 * 4)
        let tr = wgpu_triangle(16, 16, Pointer.fromAddress<Byte>(img.address()))
        let at = (8 * 16 + 8) * 4
        print("triangle rc:", tr, "center:", img.readUInt8(at), img.readUInt8(at + 1), img.readUInt8(at + 2), img.readUInt8(at + 3))
        print("abi:", wgpu_abi_version())
        wgpu_instance_destroy(inst)
    }
    return 0
}
