import { ByteBuffer } from "@std/bytes"
import {
    fn wgpu_adapter_count(p: Pointer<Byte>): Int as wgpuAdapterCount,
    fn wgpu_adapter_name(p: Pointer<Byte>, index: Int, out: Pointer<Byte>, len: Int): Int as wgpuAdapterName,
    fn wgpu_clear_rgba(w: Int, h: Int, r: Int, g: Int, b: Int, a: Int, out: Pointer<Byte>): Int as wgpuClearRgba,
    fn wgpu_instance_create(): Pointer<Byte> as wgpuInstanceCreate,
    fn wgpu_triangle(w: Int, h: Int, out: Pointer<Byte>): Int as wgpuTriangle,
    fn wgpu_abi_version(): Int as wgpuAbiVersion,
    fn wgpu_instance_destroy(p: Pointer<Byte>) as wgpuInstanceDestroy,
} from native "wgpu_cabi"

fn Main(): Int {
    unsafe {
        let inst = wgpuInstanceCreate()
        println!("adapters:", wgpuAdapterCount(inst))
        let name = ByteBuffer.allocate(256)
        let n = wgpuAdapterName(inst, 0, Pointer.fromAddress<Byte>(name.address()), 256)
        println!("name bytes:", n)
        let px = ByteBuffer.allocate(8)
        let rc = wgpuClearRgba(2, 1, 10, 20, 30, 255, Pointer.fromAddress<Byte>(px.address()))
        println!("rc:", rc, "rgba:", px.readUInt8(0), px.readUInt8(1), px.readUInt8(2), px.readUInt8(3))
        let img = ByteBuffer.allocate(16 * 16 * 4)
        let tr = wgpuTriangle(16, 16, Pointer.fromAddress<Byte>(img.address()))
        let at = (8 * 16 + 8) * 4
        println!("triangle rc:", tr, "center:", img.readUInt8(at), img.readUInt8(at + 1), img.readUInt8(at + 2), img.readUInt8(at + 3))
        println!("abi:", wgpuAbiVersion())
        wgpuInstanceDestroy(inst)
    }
    return 0
}
