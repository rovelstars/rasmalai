//! One-shot eventual values and their settlement handles.
//!
//! `Promise` is the type `async fn` returns and `await` lowers to. A promise
//! settles once: fulfillment carries a payload, rejection carries a string.
//! Combinators such as `all` and `allSettled` build a new promise and leave
//! the inputs untouched.
import {
    fn __rnx_any_unbox_heap(value: Any): Any,
} from runtime "core";
import {
    fn __rnx_condvar_notify_all(id: Int): Void,
    fn __rnx_condvar_wait_timeout(cond: Int, mutex: Int, millis: Int): Bool,
    fn __rnx_mutex_lock(id: Int): Void,
    fn __rnx_mutex_unlock(id: Int): Void,
    fn __rnx_sync_atomic_fetch_add(id: Int, d: Int): Int,
    fn __rnx_sync_atomic_set(id: Int, value: Int): Void,
} from runtime "sync";

/** Settlement record for `Promise.allSettled`. One per input promise,
 * in input order: `status` is `"fulfilled"` or `"rejected"`, `value`
 * holds the payload of a fulfillment, and `reason` the message of a
 * rejection.
 * @example
 * let rec: PromiseResult<Int> = new PromiseResult<Int>("fulfilled", 5, "");
 * println!(rec.status, rec.value);
 */
pub class PromiseResult<T> {
    /** `"fulfilled"` or `"rejected"`. */
    let status: String;
    /** Payload of a fulfilled promise, `null` for a rejection. */
    let value: T;
    /** Message of a rejected promise, `""` for a fulfillment. */
    let reason: String;

    /**
    * Record one settlement.
    * @param status `"fulfilled"` or `"rejected"`.
    * @param value payload of a fulfillment, `null` for a rejection.
    * @param reason message of a rejection, `""` for a fulfillment.
    */
    init(status: String, value: T, reason: String) {
        this.status = status;
        this.value = value;
        this.reason = reason;
    }
}

/** Manual settlement handles from `Promise.withResolvers`. It holds the
 * pending promise plus the two calls that settle it, which is how a
 * worker thread, an OS callback, or an I/O handler hands a value back
 * into the promise chain.
 * @example
 * let wr = Promise.withResolvers<Int>();
 * wr.resolve(42);
 * println!(wr.promise.wait().unwrap());
 */
pub class PromiseWithResolvers<T> {
    /** The promise these handles settle. */
    let promise: Promise<T>;

    /**
    * Wrap a pending promise.
    * @param promise promise the handles settle.
    */
    init(promise: Promise<T>) {
        this.promise = promise;
    }

    /**
    * Fulfill the promise with `val`. Ignored once the promise has
    * settled; the first settlement wins.
    * @param val payload for the fulfillment.
    * @example
    * let wr = Promise.withResolvers<Int>();
    * wr.resolve(7);
    * println!(wr.promise.wait().unwrapOr(0));
    */
    fn resolve(val: T): Void {
        this.promise.fulfill(val);
    }

    /**
    * Reject the promise with `reason`. Ignored once the promise has
    * settled; the first settlement wins.
    * @param reason message carried by the rejection.
    * @example
    * let wr = Promise.withResolvers<Int>();
    * wr.reject("boom");
    * println!(wr.promise.wait().unwrapOr(0));
    */
    fn reject(reason: String): Void {
        this.promise.rejectWith(reason);
    }
}

/**
 * One-shot eventual value: `Pending` (0), `Fulfilled` (1), `Rejected` (2).
 * Combinators attach continuations; `wait()` parks the OS thread until
 * settlement. The first settlement wins and later calls are ignored. A
 * rejection carries a `String` reason.
 *
 * Every combinator hands back a new promise and leaves this one as it is,
 * so a chain of them settles independently at each link. Handlers added
 * after settlement run at once on the calling thread.
 * @example
 * let ok: Result<Int, String> = Promise.resolve(41).wait();
 * println!(ok.unwrap());
 * let bad: Result<Int, String> = Promise.reject<Int>("boom").wait();
 * switch bad {
 * case .Ok(v): println!(v); pass;
 * case .Err(e): println!(e); pass;
 * }
 */
pub class Promise<T> {
    /** Settlement state: 0 pending, 1 fulfilled, 2 rejected. */
    let _state: Int;
    /** Fulfillment payload, read once `_state` is 1. */
    let _value: T;
    /** Rejection message, read once `_state` is 2. */
    let _reason: String;
    /** Fulfillment continuations queued while pending. */
    let _handlers: Array<fn(T): Void>;
    /** Rejection continuations queued while pending. */
    let _rejectHandlers: Array<fn(String): Void>;
    /** Registry id of the mutex and condvar guarding this promise. */
    let _syncId: Int;

    /**
    * Build a promise in a given state. Callers pass the raw state and
    * payload; `Promise.resolve`, `Promise.reject`, and
    * `Promise.withResolvers` are the usual doors in.
    * @param state 0 pending, 1 fulfilled, 2 rejected.
    * @param value fulfillment payload.
    * @param reason rejection message.
    * @param syncId registry id for the guard, from `Promise.freshId()`.
    */
    init(state: Int, value: T, reason: String, syncId: Int) {
        this._state = state;
        this._value = value;
        this._reason = reason;
        this._handlers = [];
        this._rejectHandlers = [];
        this._syncId = syncId;
    }

    /**
    * Take the next id from the shared counter. Internal: every promise
    * needs its own mutex and condvar id.
    * @returns a fresh registry id.
    * @example
    * println!(Promise.freshId() != Promise.freshId());
    */
    static freshId(): Int {
        return __rnx_sync_atomic_fetch_add(90001, 1);
    }

    /**
    * A promise that is already fulfilled.
    * @param val payload carried by the promise.
    * @returns a fulfilled promise; handlers attached later run at once.
    * @example
    * println!(Promise.resolve(41).wait().unwrapOr(0));
    */
    static resolve<T>(val: T): Promise<T> {
        return new Promise<T>(1, val, "", Promise.freshId());
    }

    /**
    * A promise that is already rejected.
    * @param reason message the rejection carries.
    * @returns a rejected promise; `wait()` gives back `Result.Err`
    * holding the same message.
    * @example
    * println!(Promise.reject<Int>("boom").wait().unwrapOr(0));
    */
    static reject<T>(reason: String): Promise<T> {
        let p: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        p.rejectWith(reason);
        return p;
    }

    /**
    * A pending promise together with the handles that settle it. Use it
    * when the value arrives from somewhere the promise cannot own, such
    * as a worker thread or an OS callback.
    * @returns a pending promise wrapped with `resolve` and `reject`.
    * @example
    *  let wr = Promise.withResolvers<Int>();
    *  wr.resolve(42);
    *  let r: Result<Int, String> = wr.promise.wait();
    *  println!(r.unwrap());
     */
    static withResolvers<T>(): PromiseWithResolvers<T> {
        let p: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        return new PromiseWithResolvers<T>(p);
    }

    /**
    * Park until `p` settles. This is the bridge `await` lowers to, so
    * user code should reach for `await` or `wait()` instead.
    * @param p promise to wait on.
    * @returns `Ok(val)` on fulfillment, `Err(reason)` on rejection.
    * @example
    * let p = Promise.resolve(2);
    * println!(Promise.waitAny(p as Promise<Any>).unwrapOr(0));
    */
    static waitAny(p: Promise<Any>): Result<Any, String> {
        return p.wait();
    }

    /**
    * Settle as fulfilled with `val`. Ignored unless the promise is
    * still pending, so the first settlement wins. Queued handlers run
    * after the guard is released, never while holding it.
    * @param val payload for the fulfillment.
    * @example
    * let wr = Promise.withResolvers<Int>();
    * wr.promise.fulfill(9);
    * println!(wr.promise.wait().unwrapOr(0));
    */
    fn fulfill(val: T): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let run: Array<fn(T): Void> = [];
        if st == 0 {
            this._value = val;
            this._state = 1;
            run = this._handlers;
            this._handlers = [];
            __rnx_condvar_notify_all(this._syncId);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 0 {
            for h in run {
                h(val);
            }
        }
    }

    /**
    * Settle as rejected with `reason`. Ignored unless the promise is
    * still pending, so the first settlement wins. Queued handlers run
    * after the guard is released, never while holding it.
    * @param reason message for the rejection.
    * @example
    * let wr = Promise.withResolvers<Int>();
    * wr.promise.rejectWith("boom");
    * println!(wr.promise.wait().unwrapOr(0));
    */
    fn rejectWith(reason: String): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let run: Array<fn(String): Void> = [];
        if st == 0 {
            this._reason = reason;
            this._state = 2;
            run = this._rejectHandlers;
            this._rejectHandlers = [];
            __rnx_condvar_notify_all(this._syncId);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 0 {
            for h in run {
                h(reason);
            }
        }
    }

    /**
    * Register both continuations. A pending promise queues one pair per
    * call; a settled promise runs the matching continuation at once on
    * the calling thread and queues nothing. Only one of the two ever
    * runs for a given promise.
    * @param onF called with the payload on fulfillment.
    * @param onR called with the message on rejection.
    * @example
    *  let wr = Promise.withResolvers<Int>();
    *  wr.promise.attach((v: Int): Void => println!("got", v), (e: String): Void => println!("bad", e));
    *  wr.resolve(7);
     */
    fn attach(onF: fn(T): Void, onR: fn(String): Void): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let v = this._value;
        if st == 0 {
            this._handlers.push(onF);
            this._rejectHandlers.push(onR);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 1 {
            onF(v);
        }
        if st == 2 {
            onR(this._reason);
        }
    }

    /**
    * Chain a fulfillment handler. A rejection skips the closure and
    * reaches the new promise unchanged, so `catchReject` is what
    * recovers from one. The closure's return value becomes the payload
    * the new promise settles with.
    * @param onFulfilled runs with the payload and produces the new
    * payload.
    * @returns a promise for the closure's result.
    * @example
    *  let a: Result<Int, String> = Promise.resolve(20).then<Int>((v: Int): Int => v + 1).wait();
    *  println!(a.unwrap());
    *  let b: Result<Int, String> = Promise.reject<Int>("bad").then<Int>((v: Int): Int => v + 1).wait();
    *  println!(b.isErr());
     */
    fn then<U>(onFulfilled: fn(T): U): Promise<U> {
        let child: Promise<U> = new Promise<U>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            child.fulfill(onFulfilled(v));
        };
        let err = (e: String): Void => {
            child.rejectWith(e);
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Chain a rejection handler. A fulfillment passes through with its
    * payload untouched; a rejection runs the closure and the new promise
    * fulfills with the closure's result, so the chain recovers instead
    * of staying rejected.
    * @param onRejected runs with the reason and produces the new
    * payload.
    * @returns a promise that turns this rejection into a fulfillment.
    * @example
    *  let r: Result<Int, String> = Promise.reject<Int>("x").catchReject<Int>((e: String): Int => 99).wait();
    *  println!(r.unwrap());
     */
    fn catchReject<U>(onRejected: fn(String): U): Promise<U> {
        let child: Promise<U> = new Promise<U>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            child.fulfill(v);
        };
        let err = (e: String): Void => {
            child.fulfill(onRejected(e));
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Chain a handler that runs on either outcome and leaves it alone.
    * The closure runs before the new promise settles, so what it prints
    * lands before the value read from `wait()`.
    * @param onFinally runs once the promise settles, either way.
    * @returns a promise carrying the original outcome.
    * @example
    *  let r: Result<Int, String> = Promise.resolve(7).finallyDo(() => println!("done")).wait();
    *  println!(r.unwrap());
     */
    fn finallyDo(onFinally: fn(): Void): Promise<T> {
        let child: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            onFinally();
            child.fulfill(v);
        };
        let err = (e: String): Void => {
            onFinally();
            child.rejectWith(e);
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Park the calling OS thread until the promise settles, without
    * spinning: it sleeps on a condvar in 1s slices and gives up after
    * 5s. Fine in a plain function or a `Thread.spawn` body; inside an
    * `async fn` it is a compile error, because parking an event-loop
    * task deadlocks.
    * @returns `Ok(val)` on fulfillment and `Err(reason)` on rejection,
    * and `Err` with a timeout message when nothing settles in 5s.
    *  @example
    *  let r: Result<Int, String> = Promise.resolve(41).wait();
    *  println!(r.unwrap());
     */
    fn wait(): Result<T, String> {
        __rnx_mutex_lock(this._syncId);
        let waited = 0;
        while this._state == 0 {
            __rnx_condvar_wait_timeout(this._syncId, this._syncId, 1000);
            waited = waited + 1000;
            if waited >= 5000 {
                __rnx_mutex_unlock(this._syncId);
                return Result.Err("promise wait timed out after 5s (sync " + this._syncId + "): no settlement signal");
            }
        }
        let st = this._state;
        let v = this._value;
        __rnx_mutex_unlock(this._syncId);
        if st == 1 {
            return Result.Ok(v);
        }
        return Result.Err(this._reason);
    }

    /**
    * Build the rejection continuation `Promise.all` hands each input.
    * Internal: one of these rejects `out` and settles the combinator.
    *  @param out promise the first rejection rejects.
    *  @returns a continuation taking the reason.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.reject<Int>("boom")];
     *  println!(Promise.all<Int>(ps).wait().isErr());
     */
    static allRej<U>(out: Promise<Array<U>>): fn(String): Void {
        return (e: String): Void => {
            out.rejectWith(e);
        };
    }

    /**
    * Build the fulfillment continuation `Promise.all` hands each input.
    * Internal: one of these writes its slot, and the last one to finish
    * fulfills `out` with the slots in input order.
    *  @param slots scratch array holding one payload per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @returns a continuation taking the payload.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
     *  let got: Array<Int> = Promise.all<Int>(ps).wait().unwrap();
     *  println!(got.join(","));
     */
    static allSlot<U>(slots: Array<U>, out: Promise<Array<U>>, counterId: Int, n: Int, idx: Int): fn(U): Void {
        return (v: U): Void => {
            slots[idx] = __rnx_any_unbox_heap(v);
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<U> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Wait for every promise and fulfill with the payloads in input
    * order, whatever order they settle in. The first rejection wins and
    * rejects the result; later settlements are ignored. An empty array
    * fulfills with `[]`.
    * @param promises promises to wait on.
    * @returns a promise for the payloads, or the first rejection.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
    *  let all: Result<Array<Int>, String> = Promise.all<Int>(ps).wait();
    *  let got: Array<Int> = all.unwrap();
    *  println!(got.join(","));
     */
    static all<T>(promises: Array<Promise<T>>): Promise<Array<T>> {
        let out: Promise<Array<T>> = new Promise<Array<T>>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.fulfill([]);
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let slots: Array<T> = [];
        let k = 0;
        while k < n {
            slots.push(null);
            promises[k].attach(Promise.allSlot<T>(slots, out, counterId, n, k), Promise.allRej<T>(out));
            k = k + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.race` hands each input.
    * Internal: one of these fulfills `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the winner fulfills.
    *  @returns a continuation taking the payload.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
     *  println!(Promise.race<Int>(ps).wait().unwrapOr(0));
     */
    static raceFwd<U>(out: Promise<U>): fn(U): Void {
        return (v: U): Void => {
            out.fulfill(v);
        };
    }

    /**
    * Build the rejection continuation `Promise.race` hands each input.
    * Internal: one of these rejects `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the first rejection rejects.
    *  @returns a continuation taking the reason.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.reject<Int>("boom")];
     *  println!(Promise.race<Int>(ps).wait().isErr());
     */
    static raceRej<U>(out: Promise<U>): fn(String): Void {
        return (e: String): Void => {
            out.rejectWith(e);
        };
    }

    /**
    * Settle with whichever input settles first, fulfillment or
    * rejection alike; the first settlement copies across and later ones
    * are ignored. The losing inputs keep running, so avoid handing
    * `race` work that must not continue. An empty array never settles,
    * and `wait()` on the result gives back `Err` after its 5s timeout.
    * @param promises promises to race.
    * @returns a promise carrying the first settlement.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
    *  println!(Promise.race<Int>(ps).wait().unwrap());
     */
    static race<T>(promises: Array<Promise<T>>): Promise<T> {
        let out: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let i = 0;
        while i < promises.length() {
            promises[i].attach(Promise.raceFwd<T>(out), Promise.raceRej<T>(out));
            i = i + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.allSettled` hands each
    * input. Internal: one of these writes a `"fulfilled"` record and
    * decrements the count, and the last one fulfills `out` with every
    * record in input order.
    *  @param slots scratch array holding one record per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @param ok true for the fulfillment continuation.
    *  @returns a continuation taking the payload.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.resolve(5), Promise.reject<Int>("bad")];
     *  let all: Result<Array<PromiseResult<Int>>, String> = Promise.allSettled<Int>(ps).wait();
     *  println!(all.unwrap()[0].status);
     */
    static settledSlot<U>(slots: Array<PromiseResult<U>>, out: Promise<Array<PromiseResult<U>>>, counterId: Int, n: Int, idx: Int, ok: Bool): fn(U): Void {
        return (v: U): Void => {
            if ok {
                slots[idx] = new PromiseResult<U>("fulfilled", __rnx_any_unbox_heap(v), "");
            }
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<PromiseResult<U>> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Build the rejection continuation `Promise.allSettled` hands each
    * input. Internal: one of these writes a `"rejected"` record and
    * decrements the count, and the last one fulfills `out` with every
    * record in input order.
    *  @param slots scratch array holding one record per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @returns a continuation taking the reason.
     *  @example
     *  let ps: Array<Promise<Int>> = [Promise.resolve(5), Promise.reject<Int>("bad")];
     *  let all: Result<Array<PromiseResult<Int>>, String> = Promise.allSettled<Int>(ps).wait();
     *  println!(all.unwrap()[1].reason);
     */
    static settledRej<U>(slots: Array<PromiseResult<U>>, out: Promise<Array<PromiseResult<U>>>, counterId: Int, n: Int, idx: Int): fn(String): Void {
        return (e: String): Void => {
            slots[idx] = new PromiseResult<U>("rejected", null, e);
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<PromiseResult<U>> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Wait for every promise and never reject. Each input turns into a
    * `PromiseResult` in input order holding either the payload or the
    * rejection message. An empty array fulfills with `[]`.
    * @param promises promises to wait on.
    * @returns a promise for one settlement record per input.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(5), Promise.reject<Int>("bad")];
    *  let all: Result<Array<PromiseResult<Int>>, String> = Promise.allSettled<Int>(ps).wait();
    *  let got: Array<PromiseResult<Int>> = all.unwrap();
    *  println!(got[0].status);
    *  println!(got[1].reason);
     */
    static allSettled<T>(promises: Array<Promise<T>>): Promise<Array<PromiseResult<T>>> {
        let out: Promise<Array<PromiseResult<T>>> = new Promise<Array<PromiseResult<T>>>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.fulfill([]);
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let slots: Array<PromiseResult<T>> = [];
        let k = 0;
        while k < n {
            slots.push(null);
            promises[k].attach(Promise.settledSlot<T>(slots, out, counterId, n, k, true), Promise.settledRej<T>(slots, out, counterId, n, k));
            k = k + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.any` hands each input.
    * Internal: one of these fulfills `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the winner fulfills.
    *  @returns a continuation taking the payload.
     *  @example
     *  let mixed: Array<Promise<Int>> = [Promise.reject<Int>("no"), Promise.resolve(5)];
     *  println!(Promise.any<Int>(mixed).wait().unwrapOr(0));
     */
    static anyFwd<U>(out: Promise<U>): fn(U): Void {
        return (v: U): Void => {
            out.fulfill(v);
        };
    }

    /**
    * Build the rejection continuation `Promise.any` hands each input.
    * Internal: one of these decrements the count, and the one that finds
    * nothing left rejects `out` with the aggregate message.
    *  @param out promise the aggregate rejection settles.
    *  @param counterId registry id of the remaining-count atomic.
    *  @returns a continuation taking the reason.
     *  @example
     *  let bad: Array<Promise<Int>> = [Promise.reject<Int>("no")];
     *  println!(Promise.any<Int>(bad).wait().isErr());
     */
    static anyRej<U>(out: Promise<U>, counterId: Int): fn(String): Void {
        return (e: String): Void => {
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                out.rejectWith("AggregateError: all promises rejected");
            }
        };
    }

    /**
    * Fulfill with the first payload to arrive. Only once every input has
    * rejected does the result reject, and then with
    * `"AggregateError: all promises rejected"`. An empty array rejects
    * at once with `"AggregateError: no promises"`.
    * @param promises promises to try.
    * @returns a promise for the first payload, or the aggregate
    * rejection.
    * @example
    *  let mixed: Array<Promise<Int>> = [Promise.reject<Int>("no"), Promise.resolve(5)];
    *  println!(Promise.any<Int>(mixed).wait().unwrap());
     */
    static any<T>(promises: Array<Promise<T>>): Promise<T> {
        let out: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.rejectWith("AggregateError: no promises");
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let i = 0;
        while i < n {
            promises[i].attach(Promise.anyFwd<T>(out), Promise.anyRej<T>(out, counterId));
            i = i + 1;
        }
        return out;
    }
}
