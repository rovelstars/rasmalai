//! 128-bit SIMD vector value types with no heap allocation.
//!
//! Two types: `Vec4f` holds four 32-bit floats, `Vec4i` holds four signed
//! 32-bit ints. Both are 128 bits wide and stay in vector registers, so
//! building one, combining two, or reading a lane allocates nothing and emits
//! no ARC retain or release.
//!
//! Lane order is fixed: lane 0 is `x`, lane 1 is `y`, lane 2 is `z`, lane 3 is
//! `w`. `x()`, `y()`, `z()`, and `w()` read a fixed lane; `get(lane)` reads a
//! lane chosen at run time.
//!
//! `+`, `-`, `*`, and `/` apply one operation to all four lanes and return a
//! new vector. Both operands must be the same vector type: `Vec4f` with
//! `Vec4f`, or `Vec4i` with `Vec4i`. Those four operators are the whole
//! operator set. `==`, `<`, and the rest are rejected with E108, so extract
//! lanes and compare those.
//!
//! Widths differ between the two types. Float lanes are 32-bit, so a `Float`
//! is narrowed on the way into a `Vec4f` and widened on the way out, keeping
//! about 7 decimal digits. Integer lanes are signed 32-bit, so a lane keeps
//! only its low 32 bits and arithmetic wraps inside the signed 32-bit range
//! instead of growing.

/**
* Four-lane 32-bit float vector.
*
* `new Vec4f(x, y, z, w)` takes exactly four `Float` lanes in x/y/z/w order
* and packs them into one 128-bit register value. Anything else, including a
* mix of `Float` and `Int`, is E108. Each lane is stored as a 32-bit float,
* so values outside the `f32` range become infinity, and `+ - * /` run per
* lane with IEEE-754 rules: a division by a zero lane yields infinity or NaN
* instead of faulting.
*
* Vectors pass to and from functions by value, like `Int` or `Float`. Use
* `min()`, `max()`, `sqrt()`, and `dot()` for the lane-wise and horizontal
* math this type adds on top of the four operators.
*/
class Vec4f {
    /**
    * Broadcast one value to all four lanes.
    * @param val lane value, narrowed to a 32-bit float.
    * @returns vector with every lane set to val.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let v = Vec4f.splat(2.0);
    * print(v.x() == 2.0, v.w() == 2.0);
    */
    static splat(val: Float): Vec4f {
        return Vec4f.splat(val);
    }

    /**
    * Lane 0.
    * @returns the x lane, widened from 32-bit float to `Float`.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * print(new Vec4f(1.0, 2.0, 3.0, 4.0).x() == 1.0);
    */
    x(): Float {
        return this.x();
    }

    /**
    * Lane 1.
    * @returns the y lane, widened from 32-bit float to `Float`.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * print(new Vec4f(1.0, 2.0, 3.0, 4.0).y() == 2.0);
    */
    y(): Float {
        return this.y();
    }

    /**
    * Lane 2.
    * @returns the z lane, widened from 32-bit float to `Float`.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * print(new Vec4f(1.0, 2.0, 3.0, 4.0).z() == 3.0);
    */
    z(): Float {
        return this.z();
    }

    /**
    * Lane 3.
    * @returns the w lane, widened from 32-bit float to `Float`.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * print(new Vec4f(1.0, 2.0, 3.0, 4.0).w() == 4.0);
    */
    w(): Float {
        return this.w();
    }

    /**
    * Lane picked at run time, for indices a loop or an array supplies.
    * @param lane lane index, 0 (x) through 3 (w).
    * @returns the selected lane, widened from 32-bit float to `Float`. Keep
    * the index inside 0..3: a wider index stops the interpreter with
    * `vector lane N out of range`, and compiled backends hand back an
    * unspecified lane instead.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let v = new Vec4f(1.0, 2.0, 3.0, 4.0);
    * let sum = 0.0;
    * let i = 0;
    * while i < 4 {
    *     sum = sum + v.get(i);
    *     i = i + 1;
    * }
    * print(sum == 10.0);
    */
    get(lane: Int): Float {
        return this.get(lane);
    }

    /**
    * Products of matching lanes summed into one scalar.
    * @param other right-hand vector.
    * @returns x*other.x + y*other.y + z*other.z + w*other.w, computed in
    * 32-bit floats, so the result keeps about 7 decimal digits.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let d = new Vec4f(1.0, 2.0, 3.0, 4.0).dot(new Vec4f(2.0, 3.0, 4.0, 5.0));
    * print(d == 40.0);
    */
    dot(other: Vec4f): Float {
        return this.dot(other);
    }

    /**
    * Smaller lane of each pair.
    * @param other right-hand vector.
    * @returns a new vector of per-lane minima. Equal lanes keep that value.
    * A NaN lane splits the backends: the interpreter and LLVM return the other
    * lane, Cranelift returns NaN.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let m = new Vec4f(1.0, 5.0, 3.0, 4.0).min(new Vec4f(4.0, 2.0, 6.0, 0.0));
    * print(m.x() == 1.0, m.y() == 2.0, m.z() == 3.0, m.w() == 0.0);
    */
    min(other: Vec4f): Vec4f {
        return this.min(other);
    }

    /**
    * Larger lane of each pair.
    * @param other right-hand vector.
    * @returns a new vector of per-lane maxima. Equal lanes keep that value.
    * A NaN lane splits the backends: the interpreter and LLVM return the other
    * lane, Cranelift returns NaN.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let h = new Vec4f(1.0, 5.0, 3.0, 4.0).max(new Vec4f(4.0, 2.0, 6.0, 0.0));
    * print(h.x() == 4.0, h.y() == 5.0, h.z() == 6.0, h.w() == 4.0);
    */
    max(other: Vec4f): Vec4f {
        return this.max(other);
    }

    /**
    * Square root of every lane.
    * @returns a new vector with sqrt applied per lane; negative lanes become
    * NaN per IEEE-754.
    * @example
    * import { Vec4f } from "@std/simd";
    *
    * let r = new Vec4f(4.0, 9.0, 16.0, 25.0).sqrt();
    * print(r.x() == 2.0, r.z() == 4.0);
    */
    sqrt(): Vec4f {
        return this.sqrt();
    }
}

/**
* Four-lane 32-bit integer vector.
*
* `new Vec4i(x, y, z, w)` takes exactly four `Int` lanes in x/y/z/w order and
* packs them into one 128-bit register value; anything else is E108. Lanes are
* signed 32-bit, so a wider lane keeps only its low 32 bits and `+ - * /` wrap
* inside the signed 32-bit range instead of growing. Division truncates toward
* zero. A zero lane in the divisor is not portable: the interpreter stops with
* `division by zero`, Cranelift traps, and LLVM returns an unspecified value,
* so test divisors before dividing.
*
* `min()`, `max()`, `dot()`, and `sqrt()` belong to `Vec4f`; calling one on a
* `Vec4i` is E108. Extract lanes with `x()`/`y()`/`z()`/`w()`/`get()` and
* compare those when an integer lane-wise choice is needed.
*
* Reading a lane widens its 32 bits to `Int`, and negative lanes do not agree
* across backends: the interpreter sign-extends, so a lane of -1 reads back as
* -1, while the Cranelift and LLVM backends zero-extend and read it back as
* 4294967295. Keep lanes non-negative, or normalize what you read, when one
* result has to hold everywhere.
*/
class Vec4i {
    /**
    * Broadcast one value to all four lanes.
    * @param val lane value, truncated to a signed 32-bit int.
    * @returns vector with every lane set to val.
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * let v = Vec4i.splat(7);
    * print(v.y() == 7, v.get(3) == 7);
    */
    static splat(val: Int): Vec4i {
        return Vec4i.splat(val);
    }

    /**
    * Lane 0.
    * @returns the x lane as an `Int`; a negative lane widens per backend, see
    * get().
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * print(new Vec4i(1, 2, 3, 4).x() == 1);
    */
    x(): Int {
        return this.x();
    }

    /**
    * Lane 1.
    * @returns the y lane as an `Int`; a negative lane widens per backend, see
    * get().
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * print(new Vec4i(1, 2, 3, 4).y() == 2);
    */
    y(): Int {
        return this.y();
    }

    /**
    * Lane 2.
    * @returns the z lane as an `Int`; a negative lane widens per backend, see
    * get().
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * print(new Vec4i(1, 2, 3, 4).z() == 3);
    */
    z(): Int {
        return this.z();
    }

    /**
    * Lane 3.
    * @returns the w lane as an `Int`; a negative lane widens per backend, see
    * get().
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * print(new Vec4i(1, 2, 3, 4).w() == 4);
    */
    w(): Int {
        return this.w();
    }

    /**
    * Lane picked at run time, for indices a loop or an array supplies.
    * @param lane lane index, 0 (x) through 3 (w).
    * @returns the selected lane widened from 32 bits to `Int`. Two edges are
    * backend dependent: an index outside 0..3 stops the interpreter with
    * `vector lane N out of range` and returns an unspecified lane once
    * compiled, and a negative lane sign-extends under the interpreter but
    * zero-extends under Cranelift and LLVM, so -1 reads back as -1 or
    * 4294967295.
    * @example
    * import { Vec4i } from "@std/simd";
    *
    * let v = new Vec4i(1, 2, 3, 4);
    * let sum = 0;
    * let i = 0;
    * while i < 4 {
    *     sum = sum + v.get(i);
    *     i = i + 1;
    * }
    * print(sum == 10);
    */
    get(lane: Int): Int {
        return this.get(lane);
    }
}
