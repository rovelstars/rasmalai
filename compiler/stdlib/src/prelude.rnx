//! Names every compilation unit sees without an import.
//!
//! An explicit declaration or an import always shadows a prelude name. The
//! class stubs below are catalog-only: the frontend parses them once per
//! session as a fallback scope and emits no code for them. Three items are
//! real, though. `Result` is a generic enum merged into every program as
//! `std.prelude.Result`, `Promise` and `ArrayIter` carry their bodies here,
//! and the `Array` and `String` extensions below are compiled into every
//! program too. `Map` and `Set` are stubs; their bodies live in
//! `@std/collections`.
//!
//! Ambient functions need no import either: `print`, `assert`, `typeOf`,
//! `IO`, `Thread`, `ThreadPool`, `Pointer`, and `Address`.
//!
//! An absent value is `null`, of type `Null`. Searches and lookups return
//! `null` when nothing matches, and `??` substitutes a fallback. Query
//! methods such as `isOk` lower to a discriminant check on the variant tag,
//! and emit nothing until they are called.
//!
//! ```rnx
//! let xs: Array<Int> = [];
//! print(xs.find((x: Int): Bool => x > 0) ?? -1);
//! ```
/** Foundation integer type: a signed 64-bit whole number.
 *
 * Methods: `toString(): String`. Convert a float with `Int(x)`, which
 * truncates toward zero, and render a number with `x.toString()`.
 * @example
 * print(41 + 1);
 * print(Int(2.9));
 */
pub class Int {}

/** Foundation float type: an IEEE-754 double.
 *
 * Methods: `toString(): String`, `toBits(): Int`, `asFast(): FastFloat`,
 * `asStrict(): Float`. Statics: `Float.nan()`, `Float.isNaN(x)`,
 * `Float.fma(a, b, c)`, `Float.fromBits(bits)`.
 *
 * A `Float` and a `FastFloat` never mix in one expression; the mix is
 * `E305`, so name the conversion you mean.
 * @example
 * let c: Float = 10.5 * 2.0 + 20.25;
 * print(c);
 * print(Float.fromBits(c.toBits()) == c);
 */
pub class Float {}

/** Relaxed float type.
 *
 * Produced by `Float.asFast()` and read back with `asStrict()`. It mixes
 * with `Float` only after an explicit conversion, and comparing one with
 * the other needs `82.5.asFast()`-style literals.
 * @example
 * let c: Float = 10.5 * 2.0 + 20.25;
 * let scaled = c.asFast() * 2.0.asFast();
 * print(scaled == 82.5.asFast(), scaled.asStrict());
 */
pub class FastFloat {}

/** Foundation boolean type: `true` or `false`.
 *
 * Methods: `toString(): String`, which prints `true` or `false`.
 * @example
 * print((1 < 2).toString());
 */
pub class Bool {}

/** Canonical UTF-8 string type.
 *
 * Every index counts characters, not bytes, so a multi-byte character is
 * one step like any other.
 *
 * Methods, all compiler builtins needing no import:
 * `length(): Int`, `len(): Int`, `slice(start: Int, end: Int): String`,
 * `indexOf(needle: String): Int`, `indexOf(needle: String, from: Int): Int`,
 * `trim(): String`, `concat(other: String): String`,
 * `charCodeAt(index: Int): Int`. `length` and `len` also read as
 * properties.
 *
 * `slice` clamps both bounds to the length and gives `""` once the start
 * reaches the end. Both `indexOf` forms give the index of the first match
 * at or after their start, or -1 when there is none; an empty needle
 * answers with the start it was given. `trim` strips leading and trailing
 * whitespace. `charCodeAt` gives the Unicode code point of the character
 * at that index, or -1 past the end.
 *
 * Search and transform helpers (`contains`, `startsWith`, `endsWith`,
 * `split`, `replace`, `replaceAll`, `repeat`, `toUpperCase`,
 * `toLowerCase`) are extension methods below.
 * @example
 * let s = "rasmalai";
 * print(s.length());
 * print(s.slice(0, 3));
 * print(s.indexOf("mal"));
 * print("  pad  ".trim());
 */
pub class String {}

/** Single scalar view into a `String`. The checker treats a `Char` as a
 * `String`, and `charCodeAt` is how you read the scalar value.
 * @example
 * print("a".charCodeAt(0));
 */
pub class Char {}

/** Dense growable sequence with `Int` indexes.
 *
 * Methods, all compiler builtins needing no import:
 * `length(): Int`, `len(): Int`, `isEmpty(): Bool`, `push(item)`,
 * `pop()`, `map(closure)`, `filter(closure)`. `length` and `len` also
 * read as properties. `map` builds a new array from the closure's return
 * value; `filter` keeps the elements the closure accepts and keeps their
 * original type.
 *
 * `pop()` takes the last element and gives `null` on an empty array.
 * Reading an index past the end throws `index out of bounds`, so check
 * the length first.
 *
 * Search and fold helpers (`find`, `findIndex`, `some`, `every`,
 * `reduce`, `join`, `reversed`) are extension methods below.
 * @example
 * let xs = [1, 2, 3];
 * xs.push(4);
 * print(xs.length());
 * print(xs.map((x: Int): Int => x * 10).join(","));
 * print(xs.filter((x: Int): Bool => x > 2).join(","));
 */
pub class Array {}

/** Insertion-ordered key-value table. Catalog stub: `Map` and its
 * methods live in `@std/collections`. */
pub class Map {}

/** Distinct-member collection. Catalog stub: `Set` and its methods live
 * in `@std/collections`. */
pub class Set {}

/** Calendar view over the wall clock. Catalog stub: `@std/time` owns the
 * clocks, and none of them report calendar dates. */
pub class Date {}

/** Error value. Catalog stub: `throw` raises a `String` message and
 * `catch (e)` binds it, so an `Error` carries nothing on its own. */
pub class Error {}

/** Untyped escape hatch. Nothing on an `Any` is resolved statically, so
 * cast before use with `v as Int` or `v as String`.
 * @example
 * let a: Any = 42;
 * print(a as Int);
 */
pub class Any {}

/** Absence of a return value. `Void` marks a function that only has
 * effects; `null` is the absent value itself, of type `Null`. */
pub class Void {}

/** Generational reference for cyclic edges. `GenRef.of(x)` takes a
 * reference without raising the owner's retain count, and `.get()` gives
 * `null` once the owner is gone, so a back edge never keeps a graph
 * alive. ARC owns, `GenRef` points back; use `#[Allow(CyclicReference)]`
 * on a field for a strong cycle you mean to break yourself. */
pub class GenRef {}

/** Success-or-error value: `Ok` carries a payload, `Err` carries an
 * error. Merged into every program as `std.prelude.Result`.
 *
 * Methods: `isOk(): Bool`, `isErr(): Bool`, `unwrap()`, `unwrapOr(fallback)`,
 * `map(closure)`. `unwrap` hands back the `Ok` payload, `unwrapOr` hands
 * back the fallback for an `Err`, and `map` runs the closure on the `Ok`
 * payload while passing an `Err` through untouched.
 * @throws `unwrap` on an `Err` throws `unwrap of Err: <reason>`.
 * @example
 * fn parse(text: String): Result<Int, String> {
 *     if text == "7" {
 *         return Result.Ok<Int, String>(7);
 *     }
 *     return Result.Err<Int, String>("not a number: " + text);
 * }
 * print(parse("7").isOk());
 * print(parse("x").unwrapOr(0));
 */
pub enum Result<T, E> {
    /** The operation produced a payload of type `T`. */
    Ok(T),
    /** The operation failed with an error of type `E`. */
    Err(E),
}

/** Pull iterator: each `next()` yields the next item or `null` at the
 * end. A `for..in` loop drives it until `next()` answers `null`.
 */
pub interface Iterator<T> {
    /**
    * Take the next item.
    * @returns the next item, or `null` once the sequence is spent.
    */
    fn next(): T?;
}

/** Type that can produce an `Iterator` over its items for `for..in`
 * loops. A value with `iterator()` or `next()` is enough; a bare
 * `Iterator` only works when its static type keeps the method.
 * @example
 * class Countdown with Iterable<Int> {
 *     let start: Int;
 *     init(start: Int) {
 *         this.start = start;
 *     }
 *     fn iterator(): Iterator<Int> {
 *         return new ArrayIter<Int>([this.start, this.start - 1, 0]);
 *     }
 * }
 * for n in new Countdown(3) {
 *     print(n as Int);
 * }
 */
pub interface Iterable<T> {
    /**
    * Open a fresh iterator over the items.
    * @returns an iterator sitting before the first item.
    */
    fn iterator(): Iterator<T>;
}

/** Index-based iterator over an array. It holds the array and a cursor,
 * walks the array in place, and yields `null` once the cursor passes the
 * end. `for..in` accepts it directly.
 * @example
 * let it = new ArrayIter<Int>([10, 20]);
 * for v in it {
 *     print(v as Int);
 * }
 */
pub class ArrayIter<T> with Iterator<T> {
    /** Array being walked. */
    let arr: Array<T>;
    /** Zero-based cursor into `arr`. */
    let i: Int;

    /**
    * Point the iterator at the start of arr.
    * @param arr sequence to walk.
    */
    init(arr: Array<T>) {
        this.arr = arr;
        this.i = 0;
    }

    /**
    * Take the next element and step the cursor on.
    * @returns the element at the cursor, or `null` past the end.
    */
    fn next(): T? {
        if this.i >= this.arr.length() {
            return null;
        }
        let v = this.arr[this.i];
        this.i = this.i + 1;
        return v;
    }
}

/** Functional search and fold helpers for every array. */
extension Array<T> {
    /**
    * First element satisfying `predicate`.
    * @param predicate called once per element, in index order.
    * @returns the first match, or `null` when the array is empty or
    * nothing matches.
    * @example
    * let xs = [4, 9, 16];
    * print(xs.find((x: Int): Bool => x > 5) ?? -1);
    */
    fn find(predicate: fn(T): Bool): T? {
        let i = 0;
        while i < this.length() {
            let item = this[i];
            if predicate(item) == true {
                return item;
            }
            i = i + 1;
        }
        return null;
    }

    /**
    * Where the first matching element sits.
    * @param predicate called once per element, in index order.
    * @returns the zero-based index of the first match, or -1 when the
    * array is empty or nothing matches.
    * @example
    * let xs = [4, 9, 16];
    * print(xs.findIndex((x: Int): Bool => x > 5));
    */
    fn findIndex(predicate: fn(T): Bool): Int {
        let i = 0;
        while i < this.length() {
            if predicate(this[i]) == true {
                return i;
            }
            i = i + 1;
        }
        return - 1;
    }

    /**
    * Whether any element satisfies `predicate`.
    * @param predicate called once per element, in index order.
    * @returns true on the first match, false for an empty array.
    * @example
    * print([4, 9, 16].some((x: Int): Bool => x == 9));
    */
    fn some(predicate: fn(T): Bool): Bool {
        return this.findIndex(predicate) != -1;
    }

    /**
    * Whether every element satisfies `predicate`.
    * @param predicate called once per element, in index order.
    * @returns false on the first rejection, true for an empty array.
    * @example
    * print([4, 9, 16].every((x: Int): Bool => x > 0));
    */
    fn every(predicate: fn(T): Bool): Bool {
        let i = 0;
        while i < this.length() {
            if predicate(this[i]) == false {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /**
    * Left fold: thread `initial` through `reducer` over each element.
    * @param initial value handed to the first `reducer` call.
    * @param reducer called with the accumulator and the next element.
    * @returns the last accumulator, which is `initial` for an empty
    * array.
    * @example
    * print([4, 9, 16].reduce<Int>(0, (acc: Int, x: Int): Int => acc + x));
    */
    fn reduce<U>(initial: U, reducer: fn(U, T): U): U {
        let acc = initial;
        let i = 0;
        while i < this.length() {
            acc = reducer(acc, this[i]);
            i = i + 1;
        }
        return acc;
    }

    /**
    * Render every element and glue the pieces with `separator`.
    * @param separator text between elements; `""` when omitted.
    * @returns the joined text, `""` for an empty array.
    * @example
    * print([4, 9, 16].join(" | "));
    */
    fn join(separator: String = ""): String {
        let out = "";
        let i = 0;
        while i < this.length() {
            if i == 0 {
                out = "" + this[i];
            } else {
                out = out + separator + ("" + this[i]);
            }
            i = i + 1;
        }
        return out;
    }

    /**
    * Reverse this array into a copy.
    * @returns a new array holding the same elements back to front.
    * @example
    * print([4, 9, 16].reversed().join(","));
    */
    fn reversed(): Array<T> {
        let out: Array<T> = [];
        let i = this.length() - 1;
        while i >= 0 {
            out.push(this[i]);
            i = i - 1;
        }
        return out;
    }
}

/** Search and transform helpers for strings. */
extension String {
    /**
    * Whether `search` occurs anywhere in this string.
    * @param search text to look for; `""` is always contained.
    * @returns true on a hit, false otherwise.
    * @example
    * print("rasmalai/compiler".contains("compiler"));
    */
    fn contains(search: String): Bool {
        return this.indexOf(search) != -1;
    }

    /**
    * Whether this string begins with `prefix`.
    * @param prefix text to compare; `""` always matches.
    * @returns true on a match, false otherwise.
    * @example
    * print("rasmalai".startsWith("ras"));
    */
    fn startsWith(prefix: String): Bool {
        return this.slice(0, prefix.length()) == prefix;
    }

    /**
    * Whether this string ends with `suffix`.
    * @param suffix text to compare; `""` always matches.
    * @returns true on a match, false otherwise.
    * @example
    * print("rasmalai".endsWith("ai"));
    */
    fn endsWith(suffix: String): Bool {
        return this.slice(this.length() - suffix.length(), this.length()) == suffix;
    }

    /**
    * Cut this string around every `delimiter`.
    * @param delimiter text to cut on; `""` gives one element per
    * character.
    * @returns the pieces in order, one element when there is no
    * delimiter.
    * @example
    * print("rasmalai/compiler".split("/").length());
    */
    fn split(delimiter: String): Array<String> {
        return __rnx_string_split(this, delimiter);
    }

    /**
    * Swap the first occurrence of `target` for `replacement`.
    * @param target text to look for.
    * @param replacement text to put in its place.
    * @returns a new string, or this one unchanged when `target` is
    * absent.
    * @example
    * print("rasmalai/compiler".replace("/", "-"));
    */
    fn replace(target: String, replacement: String): String {
        let at = this.indexOf(target);
        if at == -1 {
            return this;
        }
        return this.slice(0, at) + replacement + this.slice(at + target.length(), this.length());
    }

    /**
    * Swap every occurrence of `target` for `replacement`.
    * @param target text to look for; `""` leaves the string unchanged.
    * @param replacement text to put in place of each hit.
    * @returns a new string with every occurrence replaced.
    * @example
    * print("a-b-c".replaceAll("-", "+"));
    */
    fn replaceAll(target: String, replacement: String): String {
        if target == "" {
            return this;
        }
        let out = "";
        let start = 0;
        while true {
            let at = this.indexOf(target, start);
            if at == -1 {
                return out + this.slice(start, this.length());
            }
            out = out + this.slice(start, at) + replacement;
            start = at + target.length();
        }
        return out;
    }

    /**
    * Copy this string back to back.
    * @param count how many copies; `0` or less gives `""`.
    * @returns the repeated text.
    * @example
    * print("ab".repeat(3));
    */
    fn repeat(count: Int): String {
        if count <= 0 {
            return "";
        }
        let out = "";
        let i = 0;
        while i < count {
            out = out + this;
            i = i + 1;
        }
        return out;
    }

    /**
    * Fold this string to upper case. Only ASCII `a` to `z` change;
    * every other character, accented Latin included, passes through
    * untouched, so `"héllo"` gives `"HéLLO"`.
    * @returns a new string with the ASCII letters upper-cased.
    * @example
    * print("hello".toUpperCase());
    */
    fn toUpperCase(): String {
        let out = "";
        let i = 0;
        while i < this.length() {
            let c = this.charCodeAt(i);
            if c >= 97 && c <= 122 {
                out = out + "ABCDEFGHIJKLMNOPQRSTUVWXYZ".slice(c - 97, c - 96);
            } else {
                out = out + this.slice(i, i + 1);
            }
            i = i + 1;
        }
        return out;
    }

    /**
    * Fold this string to lower case. Only ASCII `A` to `Z` change;
    * every other character, accented Latin included, passes through
    * untouched, so `"HÉLLO"` gives `"hÉllo"`.
    * @returns a new string with the ASCII letters lower-cased.
    * @example
    * print("HeLLo".toLowerCase());
    */
    fn toLowerCase(): String {
        let out = "";
        let i = 0;
        while i < this.length() {
            let c = this.charCodeAt(i);
            if c >= 65 && c <= 90 {
                out = out + "abcdefghijklmnopqrstuvwxyz".slice(c - 65, c - 64);
            } else {
                out = out + this.slice(i, i + 1);
            }
            i = i + 1;
        }
        return out;
    }
}

/** Settlement record for `Promise.allSettled`. One per input promise,
 * in input order: `status` is `"fulfilled"` or `"rejected"`, `value`
 * holds the payload of a fulfillment, and `reason` the message of a
 * rejection.
 * @example
 * let rec: PromiseResult<Int> = new PromiseResult<Int>("fulfilled", 5, "");
 * print(rec.status, rec.value);
 */
pub class PromiseResult<T> {
    /** `"fulfilled"` or `"rejected"`. */
    let status: String;
    /** Payload of a fulfilled promise, `null` for a rejection. */
    let value: T;
    /** Message of a rejected promise, `""` for a fulfillment. */
    let reason: String;

    /**
    * Record one settlement.
    * @param status `"fulfilled"` or `"rejected"`.
    * @param value payload of a fulfillment, `null` for a rejection.
    * @param reason message of a rejection, `""` for a fulfillment.
    */
    init(status: String, value: T, reason: String) {
        this.status = status;
        this.value = value;
        this.reason = reason;
    }
}

/** Manual settlement handles from `Promise.withResolvers`. It holds the
 * pending promise plus the two calls that settle it, which is how a
 * worker thread, an OS callback, or an I/O handler hands a value back
 * into the promise chain.
 * @example
 * let wr = Promise.withResolvers<Int>();
 * wr.resolve(42);
 * print(wr.promise.wait().unwrap());
 */
pub class PromiseWithResolvers<T> {
    /** The promise these handles settle. */
    let promise: Promise<T>;

    /**
    * Wrap a pending promise.
    * @param promise promise the handles settle.
    */
    init(promise: Promise<T>) {
        this.promise = promise;
    }

    /**
    * Fulfill the promise with `val`. Ignored once the promise has
    * settled; the first settlement wins.
    * @param val payload for the fulfillment.
    */
    fn resolve(val: T): Void {
        this.promise.fulfill(val);
    }

    /**
    * Reject the promise with `reason`. Ignored once the promise has
    * settled; the first settlement wins.
    * @param reason message carried by the rejection.
    */
    fn reject(reason: String): Void {
        this.promise.rejectWith(reason);
    }
}

/**
 * One-shot eventual value: `Pending` (0), `Fulfilled` (1), `Rejected` (2).
 * Combinators attach continuations; `wait()` parks the OS thread until
 * settlement. The first settlement wins and later calls are ignored. A
 * rejection carries a `String` reason.
 *
 * Every combinator hands back a new promise and leaves this one as it is,
 * so a chain of them settles independently at each link. Handlers added
 * after settlement run at once on the calling thread.
 * @example
 * let ok: Result<Int, String> = Promise.resolve(41).wait();
 * print(ok.unwrap());
 * let bad: Result<Int, String> = Promise.reject<Int>("boom").wait();
 * switch bad {
 * case .Ok(v): print(v); pass;
 * case .Err(e): print(e); pass;
 * }
 */
pub class Promise<T> {
    /** Settlement state: 0 pending, 1 fulfilled, 2 rejected. */
    let _state: Int;
    /** Fulfillment payload, read once `_state` is 1. */
    let _value: T;
    /** Rejection message, read once `_state` is 2. */
    let _reason: String;
    /** Fulfillment continuations queued while pending. */
    let _handlers: Array<fn(T): Void>;
    /** Rejection continuations queued while pending. */
    let _rejectHandlers: Array<fn(String): Void>;
    /** Registry id of the mutex and condvar guarding this promise. */
    let _syncId: Int;

    /**
    * Build a promise in a given state. Callers pass the raw state and
    * payload; `Promise.resolve`, `Promise.reject`, and
    * `Promise.withResolvers` are the usual doors in.
    * @param state 0 pending, 1 fulfilled, 2 rejected.
    * @param value fulfillment payload.
    * @param reason rejection message.
    * @param syncId registry id for the guard, from `Promise.freshId()`.
    */
    init(state: Int, value: T, reason: String, syncId: Int) {
        this._state = state;
        this._value = value;
        this._reason = reason;
        this._handlers = [];
        this._rejectHandlers = [];
        this._syncId = syncId;
    }

    /**
    * Take the next id from the shared counter. Internal: every promise
    * needs its own mutex and condvar id.
    * @returns a fresh registry id.
    */
    static freshId(): Int {
        return __rnx_sync_atomic_fetch_add(90001, 1);
    }

    /**
    * A promise that is already fulfilled.
    * @param val payload carried by the promise.
    * @returns a fulfilled promise; handlers attached later run at once.
    */
    static resolve<T>(val: T): Promise<T> {
        return new Promise<T>(1, val, "", Promise.freshId());
    }

    /**
    * A promise that is already rejected.
    * @param reason message the rejection carries.
    * @returns a rejected promise; `wait()` gives back `Result.Err`
    * holding the same message.
    */
    static reject<T>(reason: String): Promise<T> {
        let p: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        p.rejectWith(reason);
        return p;
    }

    /**
    * A pending promise together with the handles that settle it. Use it
    * when the value arrives from somewhere the promise cannot own, such
    * as a worker thread or an OS callback.
    * @returns a pending promise wrapped with `resolve` and `reject`.
    * @example
    *  let wr = Promise.withResolvers<Int>();
    *  wr.resolve(42);
    *  let r: Result<Int, String> = wr.promise.wait();
    *  print(r.unwrap());
     */
    static withResolvers<T>(): PromiseWithResolvers<T> {
        let p: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        return new PromiseWithResolvers<T>(p);
    }

    /**
    * Park until `p` settles. This is the bridge `await` lowers to, so
    * user code should reach for `await` or `wait()` instead.
    * @param p promise to wait on.
    * @returns `Ok(val)` on fulfillment, `Err(reason)` on rejection.
    */
    static waitAny(p: Promise<Any>): Result<Any, String> {
        return p.wait();
    }

    /**
    * Settle as fulfilled with `val`. Ignored unless the promise is
    * still pending, so the first settlement wins. Queued handlers run
    * after the guard is released, never while holding it.
    * @param val payload for the fulfillment.
    */
    fn fulfill(val: T): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let run: Array<fn(T): Void> = [];
        if st == 0 {
            this._value = val;
            this._state = 1;
            run = this._handlers;
            this._handlers = [];
            __rnx_condvar_notify_all(this._syncId);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 0 {
            for h in run {
                h(val);
            }
        }
    }

    /**
    * Settle as rejected with `reason`. Ignored unless the promise is
    * still pending, so the first settlement wins. Queued handlers run
    * after the guard is released, never while holding it.
    * @param reason message for the rejection.
    */
    fn rejectWith(reason: String): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let run: Array<fn(String): Void> = [];
        if st == 0 {
            this._reason = reason;
            this._state = 2;
            run = this._rejectHandlers;
            this._rejectHandlers = [];
            __rnx_condvar_notify_all(this._syncId);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 0 {
            for h in run {
                h(reason);
            }
        }
    }

    /**
    * Register both continuations. A pending promise queues one pair per
    * call; a settled promise runs the matching continuation at once on
    * the calling thread and queues nothing. Only one of the two ever
    * runs for a given promise.
    * @param onF called with the payload on fulfillment.
    * @param onR called with the message on rejection.
    * @example
    *  let wr = Promise.withResolvers<Int>();
    *  wr.promise.attach((v: Int): Void => print("got", v), (e: String): Void => print("bad", e));
    *  wr.resolve(7);
     */
    fn attach(onF: fn(T): Void, onR: fn(String): Void): Void {
        __rnx_mutex_lock(this._syncId);
        let st = this._state;
        let v = this._value;
        if st == 0 {
            this._handlers.push(onF);
            this._rejectHandlers.push(onR);
        }
        __rnx_mutex_unlock(this._syncId);
        if st == 1 {
            onF(v);
        }
        if st == 2 {
            onR(this._reason);
        }
    }

    /**
    * Chain a fulfillment handler. A rejection skips the closure and
    * reaches the new promise unchanged, so `catchReject` is what
    * recovers from one. The closure's return value becomes the payload
    * the new promise settles with.
    * @param onFulfilled runs with the payload and produces the new
    * payload.
    * @returns a promise for the closure's result.
    * @example
    *  let a: Result<Int, String> = Promise.resolve(20).then<Int>((v: Int): Int => v + 1).wait();
    *  print(a.unwrap());
    *  let b: Result<Int, String> = Promise.reject<Int>("bad").then<Int>((v: Int): Int => v + 1).wait();
    *  print(b.isErr());
     */
    fn then<U>(onFulfilled: fn(T): U): Promise<U> {
        let child: Promise<U> = new Promise<U>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            child.fulfill(onFulfilled(v));
        };
        let err = (e: String): Void => {
            child.rejectWith(e);
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Chain a rejection handler. A fulfillment passes through with its
    * payload untouched; a rejection runs the closure and the new promise
    * fulfills with the closure's result, so the chain recovers instead
    * of staying rejected.
    * @param onRejected runs with the reason and produces the new
    * payload.
    * @returns a promise that turns this rejection into a fulfillment.
    * @example
    *  let r: Result<Int, String> = Promise.reject<Int>("x").catchReject<Int>((e: String): Int => 99).wait();
    *  print(r.unwrap());
     */
    fn catchReject<U>(onRejected: fn(String): U): Promise<U> {
        let child: Promise<U> = new Promise<U>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            child.fulfill(v);
        };
        let err = (e: String): Void => {
            child.fulfill(onRejected(e));
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Chain a handler that runs on either outcome and leaves it alone.
    * The closure runs before the new promise settles, so what it prints
    * lands before the value read from `wait()`.
    * @param onFinally runs once the promise settles, either way.
    * @returns a promise carrying the original outcome.
    * @example
    *  let r: Result<Int, String> = Promise.resolve(7).finallyDo(() => print("done")).wait();
    *  print(r.unwrap());
     */
    fn finallyDo(onFinally: fn(): Void): Promise<T> {
        let child: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let fwd = (v: T): Void => {
            onFinally();
            child.fulfill(v);
        };
        let err = (e: String): Void => {
            onFinally();
            child.rejectWith(e);
        };
        this.attach(fwd, err);
        return child;
    }

    /**
    * Park the calling OS thread until the promise settles, without
    * spinning: it sleeps on a condvar in 1s slices and gives up after
    * 5s. Fine in a plain function or a `Thread.spawn` body; inside an
    * `async fn` it is a compile error, because parking an event-loop
    * task deadlocks.
    * @returns `Ok(val)` on fulfillment and `Err(reason)` on rejection,
    * and `Err` with a timeout message when nothing settles in 5s.
    *  @example
    *  let r: Result<Int, String> = Promise.resolve(41).wait();
    *  print(r.unwrap());
     */
    fn wait(): Result<T, String> {
        __rnx_mutex_lock(this._syncId);
        let waited = 0;
        while this._state == 0 {
            __rnx_condvar_wait_timeout(this._syncId, this._syncId, 1000);
            waited = waited + 1000;
            if waited >= 5000 {
                __rnx_mutex_unlock(this._syncId);
                return Result.Err("promise wait timed out after 5s (sync " + this._syncId + "): no settlement signal");
            }
        }
        let st = this._state;
        let v = this._value;
        __rnx_mutex_unlock(this._syncId);
        if st == 1 {
            return Result.Ok(v);
        }
        return Result.Err(this._reason);
    }

    /**
    * Build the rejection continuation `Promise.all` hands each input.
    * Internal: one of these rejects `out` and settles the combinator.
    *  @param out promise the first rejection rejects.
    *  @returns a continuation taking the reason.
     */
    static allRej<U>(out: Promise<Array<U>>): fn(String): Void {
        return (e: String): Void => {
            out.rejectWith(e);
        };
    }

    /**
    * Build the fulfillment continuation `Promise.all` hands each input.
    * Internal: one of these writes its slot, and the last one to finish
    * fulfills `out` with the slots in input order.
    *  @param slots scratch array holding one payload per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @returns a continuation taking the payload.
     */
    static allSlot<U>(slots: Array<U>, out: Promise<Array<U>>, counterId: Int, n: Int, idx: Int): fn(U): Void {
        return (v: U): Void => {
            slots[idx] = __rnx_any_unbox_heap(v);
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<U> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Wait for every promise and fulfill with the payloads in input
    * order, whatever order they settle in. The first rejection wins and
    * rejects the result; later settlements are ignored. An empty array
    * fulfills with `[]`.
    * @param promises promises to wait on.
    * @returns a promise for the payloads, or the first rejection.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
    *  let all: Result<Array<Int>, String> = Promise.all<Int>(ps).wait();
    *  let got: Array<Int> = all.unwrap();
    *  print(got.join(","));
     */
    static all<T>(promises: Array<Promise<T>>): Promise<Array<T>> {
        let out: Promise<Array<T>> = new Promise<Array<T>>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.fulfill([]);
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let slots: Array<T> = [];
        let k = 0;
        while k < n {
            slots.push(null);
            promises[k].attach(Promise.allSlot<T>(slots, out, counterId, n, k), Promise.allRej<T>(out));
            k = k + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.race` hands each input.
    * Internal: one of these fulfills `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the winner fulfills.
    *  @returns a continuation taking the payload.
     */
    static raceFwd<U>(out: Promise<U>): fn(U): Void {
        return (v: U): Void => {
            out.fulfill(v);
        };
    }

    /**
    * Build the rejection continuation `Promise.race` hands each input.
    * Internal: one of these rejects `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the first rejection rejects.
    *  @returns a continuation taking the reason.
     */
    static raceRej<U>(out: Promise<U>): fn(String): Void {
        return (e: String): Void => {
            out.rejectWith(e);
        };
    }

    /**
    * Settle with whichever input settles first, fulfillment or
    * rejection alike; the first settlement copies across and later ones
    * are ignored. The losing inputs keep running, so avoid handing
    * `race` work that must not continue. An empty array never settles,
    * and `wait()` on the result gives back `Err` after its 5s timeout.
    * @param promises promises to race.
    * @returns a promise carrying the first settlement.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(1), Promise.resolve(2)];
    *  print(Promise.race<Int>(ps).wait().unwrap());
     */
    static race<T>(promises: Array<Promise<T>>): Promise<T> {
        let out: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let i = 0;
        while i < promises.length() {
            promises[i].attach(Promise.raceFwd<T>(out), Promise.raceRej<T>(out));
            i = i + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.allSettled` hands each
    * input. Internal: one of these writes a `"fulfilled"` record and
    * decrements the count, and the last one fulfills `out` with every
    * record in input order.
    *  @param slots scratch array holding one record per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @param ok true for the fulfillment continuation.
    *  @returns a continuation taking the payload.
     */
    static settledSlot<U>(slots: Array<PromiseResult<U>>, out: Promise<Array<PromiseResult<U>>>, counterId: Int, n: Int, idx: Int, ok: Bool): fn(U): Void {
        return (v: U): Void => {
            if ok {
                slots[idx] = new PromiseResult<U>("fulfilled", __rnx_any_unbox_heap(v), "");
            }
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<PromiseResult<U>> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Build the rejection continuation `Promise.allSettled` hands each
    * input. Internal: one of these writes a `"rejected"` record and
    * decrements the count, and the last one fulfills `out` with every
    * record in input order.
    *  @param slots scratch array holding one record per input.
    *  @param out promise the last input fulfills.
    *  @param counterId registry id of the remaining-count atomic.
    *  @param n how many inputs there are.
    *  @param idx this input's index.
    *  @returns a continuation taking the reason.
     */
    static settledRej<U>(slots: Array<PromiseResult<U>>, out: Promise<Array<PromiseResult<U>>>, counterId: Int, n: Int, idx: Int): fn(String): Void {
        return (e: String): Void => {
            slots[idx] = new PromiseResult<U>("rejected", null, e);
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                let ordered: Array<PromiseResult<U>> = [];
                let j = 0;
                while j < n {
                    ordered.push(slots[j]);
                    j = j + 1;
                }
                out.fulfill(ordered);
            }
        };
    }

    /**
    * Wait for every promise and never reject. Each input turns into a
    * `PromiseResult` in input order holding either the payload or the
    * rejection message. An empty array fulfills with `[]`.
    * @param promises promises to wait on.
    * @returns a promise for one settlement record per input.
    * @example
    *  let ps: Array<Promise<Int>> = [Promise.resolve(5), Promise.reject<Int>("bad")];
    *  let all: Result<Array<PromiseResult<Int>>, String> = Promise.allSettled<Int>(ps).wait();
    *  let got: Array<PromiseResult<Int>> = all.unwrap();
    *  print(got[0].status);
    *  print(got[1].reason);
     */
    static allSettled<T>(promises: Array<Promise<T>>): Promise<Array<PromiseResult<T>>> {
        let out: Promise<Array<PromiseResult<T>>> = new Promise<Array<PromiseResult<T>>>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.fulfill([]);
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let slots: Array<PromiseResult<T>> = [];
        let k = 0;
        while k < n {
            slots.push(null);
            promises[k].attach(Promise.settledSlot<T>(slots, out, counterId, n, k, true), Promise.settledRej<T>(slots, out, counterId, n, k));
            k = k + 1;
        }
        return out;
    }

    /**
    * Build the fulfillment continuation `Promise.any` hands each input.
    * Internal: one of these fulfills `out`, and only the first to arrive
    * has any effect.
    *  @param out promise the winner fulfills.
    *  @returns a continuation taking the payload.
     */
    static anyFwd<U>(out: Promise<U>): fn(U): Void {
        return (v: U): Void => {
            out.fulfill(v);
        };
    }

    /**
    * Build the rejection continuation `Promise.any` hands each input.
    * Internal: one of these decrements the count, and the one that finds
    * nothing left rejects `out` with the aggregate message.
    *  @param out promise the aggregate rejection settles.
    *  @param counterId registry id of the remaining-count atomic.
    *  @returns a continuation taking the reason.
     */
    static anyRej<U>(out: Promise<U>, counterId: Int): fn(String): Void {
        return (e: String): Void => {
            let left = __rnx_sync_atomic_fetch_add(counterId, -1) - 1;
            if left == 0 {
                out.rejectWith("AggregateError: all promises rejected");
            }
        };
    }

    /**
    * Fulfill with the first payload to arrive. Only once every input has
    * rejected does the result reject, and then with
    * `"AggregateError: all promises rejected"`. An empty array rejects
    * at once with `"AggregateError: no promises"`.
    * @param promises promises to try.
    * @returns a promise for the first payload, or the aggregate
    * rejection.
    * @example
    *  let mixed: Array<Promise<Int>> = [Promise.reject<Int>("no"), Promise.resolve(5)];
    *  print(Promise.any<Int>(mixed).wait().unwrap());
     */
    static any<T>(promises: Array<Promise<T>>): Promise<T> {
        let out: Promise<T> = new Promise<T>(0, null, "", Promise.freshId());
        let n = promises.length();
        if n == 0 {
            out.rejectWith("AggregateError: no promises");
            return out;
        }
        let counterId = Promise.freshId();
        __rnx_sync_atomic_set(counterId, n);
        let i = 0;
        while i < n {
            promises[i].attach(Promise.anyFwd<T>(out), Promise.anyRej<T>(out, counterId));
            i = i + 1;
        }
        return out;
    }
}

/**
 * Host metadata: `rnx` is ambient in every module with no import.
 * `version` is the compiler version string, `args` holds the CLI
 * arguments after the script path, `cwd()` reads the working
 * directory, and `exit(code)` terminates immediately.
 * @example
 * print(rnx.version);
 * print(rnx.args.length());
 * print(rnx.cwd().length() > 0);
 */
pub class RnxHost {
    /** Version of the compiler that built this program. */
    let version: String;
    /** CLI arguments after the script path, so `args[0]` is the first
    *  one the caller passed. */
    let args: Array<String>;

    /** Read the host version and arguments once, at startup. */
    init() {
        this.version = __rnx_host_version();
        let count = __rnx_env_args_count();
        let collected: Array<String> = [];
        let i = 1;
        while i < count {
            collected.push(__rnx_env_args_get(i));
            i = i + 1;
        }
        this.args = collected;
    }

    /**
    * Read the working directory of the process.
    * @returns the path the process was started in.
    */
    fn cwd(): String {
        return __rnx_env_cwd();
    }

    /**
    * Stop the process now. Nothing after the call runs and the exit
    * status is the code given.
    * @param code exit status handed to the host.
    */
    fn exit(code: Int) {
        __rnx_env_exit(code);
    }
}
