{
    "name": "Rasmalai",
    "scopeName": "source.rnx",
    "fileTypes": ["rnx"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.module.rnx",
                    "match": "^\\s*(//!).*$"
                },
                {
                    "name": "comment.block.documentation.rnx",
                    "begin": "/\\*\\*(?!/)",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "name": "storage.type.class.jsdoc.rnx",
                            "match": "@(param|returns?|throws|error|example|see|since|deprecated)\\b"
                        },
                        {
                            "name": "entity.name.type.instance.jsdoc.rnx",
                            "match": "\\{[^}]*\\}"
                        },
                        {
                            "name": "punctuation.definition.comment.rnx",
                            "match": "^\\s*\\*"
                        }
                    ]
                },
                {
                    "name": "comment.line.double-slash.rnx",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.rnx",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        { "include": "#block-comment" }
                    ]
                }
            ]
        },
        "block-comment": {
            "patterns": [
                {
                    "name": "comment.block.rnx",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        { "include": "#block-comment" }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.rnx",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.rnx",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.template.expression.rnx",
                            "begin": "\\$\\{",
                            "end": "}",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        },
                        {
                            "name": "variable.other.interpolated.rnx",
                            "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                        }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.rnx",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.rnx",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.octal.rnx",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.float.rnx",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
                },
                {
                    "name": "constant.numeric.decimal.rnx",
                    "match": "\\b[0-9][0-9_]*\\b"
                },
                {
                    "name": "constant.language.boolean.rnx",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.rnx",
                    "match": "\\b(null|nil|none)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.rnx",
                    "match": "\\b(pub|public|private|static|fn|let|const|new|class|struct|record|trait|interface|extension|enum|with|extends|comptime|native|unsafe)\\b"
                },
                {
                    "name": "keyword.control.rnx",
                    "match": "\\b(if|else|while|for|in|switch|case|default|break|continue|return)\\b"
                },
                {
                    "name": "keyword.control.flow.rnx",
                    "match": "\\b(async|await|defer|throw|throws|try|catch|finally|guard|fallthrough|do|pass)\\b"
                },
                {
                    "name": "keyword.control.import.rnx",
                    "match": "\\b(import|export|from|as)\\b"
                },
                {
                    "name": "keyword.other.rnx",
                    "match": "\\b(super|is)\\b"
                },
                {
                    "name": "keyword.other.test.rnx",
                    "match": "\\b(test|bench)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.rnx",
                    "match": "\\b(Int|Float|FastFloat|Bool|Void|String|Any|Array|Map|Set|Option|GenRef|Vec4f|Vec4i|Vec2|Result|Mutex|RwLock|Condvar|Barrier|Channel|ThreadPool)\\b"
                },
                {
                    "name": "entity.name.type.rnx",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==>)",
                    "captures": {
                        "1": { "name": "variable.parameter.rnx" }
                    }
                },
                {
                    "match": "\\(([^()]*)?\\)\\s*(?::[^=]*?)?=>",
                    "captures": {
                        "1": { "name": "variable.parameter.rnx" }
                    }
                },
                {
                    "name": "keyword.operator.arrow.rnx",
                    "match": "=>"
                },
                {
                    "name": "entity.name.function.rnx",
                    "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.function.rnx" }
                    }
                },
                {
                    "name": "entity.name.function.call.rnx",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                },
                {
                    "name": "entity.name.function.lifecycle.rnx",
                    "match": "\\b(init|deinit|onReload)\\b"
                },
                {
                    "name": "variable.language.this.rnx",
                    "match": "\\bthis\\b"
                }
            ]
        }
    }
}
